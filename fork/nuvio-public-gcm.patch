+/** AES-ECB encryption of whole 16-byte blocks via CCCrypt (public CommonCrypto API); used by [AesGcm]. */
+@OptIn(ExperimentalForeignApi::class)
+private fun aesEcbEncryptBlocks(key: ByteArray, blocks: ByteArray): ByteArray {
+    require(blocks.size % 16 == 0) { "AES block input must be a multiple of 16 bytes" }
+    if (blocks.isEmpty()) return ByteArray(0)
+    val output = ByteArray(blocks.size)
+    memScoped {
+        val moved = alloc<platform.posix.size_tVar>()
+        key.usePinned { pinnedKey ->
+            blocks.usePinned { pinnedBlocks ->
+                output.usePinned { pinnedOutput ->
+                    val status = CCCrypt(
+                        op = kCCEncrypt,
+                        alg = kCCAlgorithmAES,
+                        options = kCCOptionECBMode,
+                        key = pinnedKey.addressOf(0),
+                        keyLength = key.size.toULong(),
+                        iv = null,
+                        dataIn = pinnedBlocks.addressOf(0),
+                        dataInLength = blocks.size.toULong(),
+                        dataOut = pinnedOutput.addressOf(0),
+                        dataOutAvailable = output.size.toULong(),
+                        dataOutMoved = moved.ptr
+                    )
+                    if (status != kCCSuccess || moved.value.toInt() != blocks.size) {
+                        error("AES block encryption failed with status: $status")
+                    }
+                }
+            }
+        }
+    }
+    return output
+}
