+/**
+ * "Download season" pill with the episode count. [episodes] are the episodes of [seasonNumber] as displayed.
+ * Draws nothing when the season has no released episode or downloads are unavailable.
+ */
+@Composable
+internal fun SeasonDownloadBar(
+    seasonNumber: Int,
+    episodes: List<MetaVideo>,
+    modifier: Modifier = Modifier,
+) {
+    val controller = LocalDetailsDownloads.current ?: return
+    if (!controller.isSeries) return
+
+    val statuses by remember(controller.meta.id, seasonNumber) {
+        DownloadsRepository.observeSeasonStatuses(controller.meta.id, seasonNumber)
+    }.collectAsStateWithLifecycle(initialValue = emptyMap())
+    val today = CurrentDateProvider.todayIsoDate()
+    val plan = remember(episodes, statuses, today) {
+        SeasonDownloadPlanner.plan(
+            episodes.mapNotNull { video ->
+                val episode = video.episode ?: return@mapNotNull null
+                if (video.season == null) return@mapNotNull null
+                PlannerEpisode(
+                    season = seasonNumber,
+                    episode = episode,
+                    released = video.isReleasedBy(today),
+                    download = statuses[episode]?.toDlState(),
+                )
+            },
+        )
+    }
+    if (plan.phase == SeasonDownloadPhase.Unavailable) return
+    if (plan.phase == SeasonDownloadPhase.Idle) {
+        val anyStreamable = episodes.any { video ->
+            video.season != null && video.episode != null && controller.canStream(controller.request(video).videoId)
+        }
+        if (!anyStreamable) return
+    }
+
+    var sheetOpen by remember(controller.meta.id, seasonNumber) { mutableStateOf(false) }
+    var confirmDelete by remember(controller.meta.id, seasonNumber) { mutableStateOf(false) }
+
+    val label = when (plan.phase) {
+        SeasonDownloadPhase.InProgress ->
+            stringResource(Res.string.downloads_season_progress, plan.completed, plan.total)
+        SeasonDownloadPhase.AllDownloaded -> stringResource(Res.string.downloads_season_downloaded)
+        else -> if (seasonNumber == 0) {
+            stringResource(Res.string.downloads_season_download_all)
+        } else {
+            stringResource(Res.string.downloads_season_download)
+        }
+    }
+
+    Row(
+        modifier = modifier.fillMaxWidth(),
+        horizontalArrangement = Arrangement.SpaceBetween,
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        Text(
+            text = pluralStringResource(Res.plurals.downloads_season_episode_count, plan.total, plan.total),
+            style = MaterialTheme.typography.labelLarge,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+        )
+        Row(
+            modifier = Modifier
+                .height(36.dp)
+                .clip(RoundedCornerShape(18.dp))
+                .background(backdropControlColor(MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.6f)))
+                .semantics { contentDescription = label }
+                .clickable(role = Role.Button) {
+                    when (plan.phase) {
+                        SeasonDownloadPhase.Idle -> controller.requestSeason(seasonNumber)
+                        else -> sheetOpen = true
+                    }
+                }
+                .padding(horizontal = 12.dp),
+            horizontalArrangement = Arrangement.spacedBy(6.dp),
+            verticalAlignment = Alignment.CenterVertically,
+        ) {
+            when (plan.phase) {
+                SeasonDownloadPhase.InProgress -> SeasonProgressRing(
+                    fraction = if (plan.total > 0) plan.completed.toFloat() / plan.total.toFloat() else 0f,
+                )
+                SeasonDownloadPhase.AllDownloaded -> Icon(
+                    imageVector = Icons.Rounded.DownloadDone,
+                    contentDescription = null,
+                    tint = MaterialTheme.nuvio.colors.accent,
+                    modifier = Modifier.size(18.dp),
+                )
+                else -> Icon(
+                    imageVector = Icons.Rounded.Download,
+                    contentDescription = null,
+                    tint = MaterialTheme.colorScheme.onSurface,
+                    modifier = Modifier.size(18.dp),
+                )
+            }
+            Text(
+                text = label,
+                style = MaterialTheme.typography.labelLarge,
+                color = MaterialTheme.colorScheme.onSurface,
+                maxLines = 1,
+                overflow = TextOverflow.Ellipsis,
+            )
+        }
+    }
+
+    if (sheetOpen) {
+        SeasonActionsSheet(
+            seasonNumber = seasonNumber,
+            phase = plan.phase,
+            onDismiss = { sheetOpen = false },
+            onCancelSeason = {
+                DownloadsRepository.deleteSeason(controller.meta.id, seasonNumber, onlyUnfinished = true)
+                DownloadsOrchestrator.onSeasonCancelled(controller.meta.id)
+            },
+            onDeleteSeason = { confirmDelete = true },
+        )
+    }
+
+    NuvioStatusModal(
+        title = stringResource(Res.string.action_delete_confirm_title),
+        message = stringResource(Res.string.action_delete_confirm_message),
+        isVisible = confirmDelete,
+        destructive = true,
+        confirmText = stringResource(Res.string.action_yes),
+        dismissText = stringResource(Res.string.action_no),
+        onConfirm = {
+            confirmDelete = false
+            DownloadsRepository.deleteSeason(controller.meta.id, seasonNumber, onlyUnfinished = false)
+            DownloadsOrchestrator.onSeasonCancelled(controller.meta.id)
+        },
+        onDismiss = { confirmDelete = false },
+    )
+}
+
+@Composable
+private fun SeasonProgressRing(fraction: Float) {
+    val track = MaterialTheme.colorScheme.onSurface.copy(alpha = 0.30f)
+    val accent = MaterialTheme.nuvio.colors.accent
+    Canvas(Modifier.size(18.dp)) {
+        val stroke = 2.dp.toPx()
+        val topLeft = Offset(stroke / 2f, stroke / 2f)
+        val arcSize = Size(size.width - stroke, size.height - stroke)
+        drawArc(
+            color = track,
+            startAngle = 0f,
+            sweepAngle = 360f,
+            useCenter = false,
+            topLeft = topLeft,
+            size = arcSize,
+            style = Stroke(width = stroke),
+        )
+        drawArc(
+            color = accent,
+            startAngle = -90f,
+            sweepAngle = 360f * fraction.coerceIn(0f, 1f),
+            useCenter = false,
+            topLeft = topLeft,
+            size = arcSize,
+            style = Stroke(width = stroke, cap = StrokeCap.Round),
+        )
+    }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+private fun SeasonActionsSheet(
+    seasonNumber: Int,
+    phase: SeasonDownloadPhase,
+    onDismiss: () -> Unit,
+    onCancelSeason: () -> Unit,
+    onDeleteSeason: () -> Unit,
+) {
+    val sheetState = rememberModalBottomSheetState(skipPartiallyExpanded = true)
+    val coroutineScope = rememberCoroutineScope()
+
+    fun perform(action: () -> Unit) {
+        action()
+        coroutineScope.launch {
+            dismissNuvioBottomSheet(sheetState = sheetState, onDismiss = onDismiss)
+        }
+    }
+
+    NuvioModalBottomSheet(
+        onDismissRequest = {
+            coroutineScope.launch {
+                dismissNuvioBottomSheet(sheetState = sheetState, onDismiss = onDismiss)
+            }
+        },
+        sheetState = sheetState,
+    ) {
+        Column(
+            modifier = Modifier
+                .fillMaxWidth()
+                .padding(bottom = nuvioSafeBottomPadding(16.dp)),
+        ) {
+            Text(
+                text = if (seasonNumber == 0) {
+                    stringResource(Res.string.episodes_specials)
+                } else {
+                    stringResource(Res.string.episodes_season, seasonNumber)
+                },
+                modifier = Modifier.padding(horizontal = 16.dp, vertical = 14.dp),
+                style = MaterialTheme.typography.titleLarge,
+                color = MaterialTheme.colorScheme.onSurface,
+                fontWeight = FontWeight.SemiBold,
+                maxLines = 1,
+                overflow = TextOverflow.Ellipsis,
+            )
+            NuvioBottomSheetDivider()
+            when (phase) {
+                SeasonDownloadPhase.InProgress -> NuvioBottomSheetActionRow(
+                    icon = Icons.Rounded.Close,
+                    title = stringResource(Res.string.downloads_season_cancel),
+                    onClick = { perform(onCancelSeason) },
+                )
+                SeasonDownloadPhase.AllDownloaded -> NuvioBottomSheetActionRow(
+                    icon = Icons.Rounded.Delete,
+                    title = stringResource(Res.string.downloads_season_delete),
+                    onClick = { perform(onDeleteSeason) },
+                )
+                else -> Unit
+            }
+        }
+    }
+}
