+    smartReplacesItemId: String? = null,
+): DownloadRequest {
+    val videoId = video?.id?.takeIf { it.isNotBlank() }
+        ?: video?.let { buildPlaybackVideoId(id, it.season, it.episode, it.id) }
+        ?: id
+    return DownloadRequest(
+        contentType = type,
+        videoId = videoId,
+        parentMetaId = id,
+        parentMetaType = type,
+        title = name,
+        logo = logo,
+        poster = poster,
+        background = background,
+        seasonNumber = video?.season,
+        episodeNumber = video?.episode,
+        episodeTitle = video?.title,
+        episodeThumbnail = video?.thumbnail,
+        origin = origin,
+        smartReplacesItemId = smartReplacesItemId,
