+/**
+ * Everything the details screen needs to offer downloads for one title. Provided through [LocalDetailsDownloads];
+ * when it is null (other screens that reuse the episode cards) no download control is drawn.
+ */
+internal class DetailsDownloadController(
+    val meta: MetaDetails,
+    val isSeries: Boolean,
+    /** Whether any installed source can serve streams for this video id. */
+    val canStream: (videoId: String) -> Boolean,
+    /** Plays the given episode (null: the movie). Completed downloads are preferred by the play flow. */
+    val play: (MetaVideo?) -> Unit,
+    /** Opens the stream list in download mode (the automatic pick failed or the user asked for it). */
+    val openSourcePicker: (DownloadRequest) -> Unit,
+) {
+    fun request(video: MetaVideo?, origin: DownloadOrigin = DownloadOrigin.User): DownloadRequest =
+        meta.toDownloadRequest(video, origin)
+
+    fun requestDownload(video: MetaVideo?) {
+        DownloadSettingsRepository.ensureLoaded()
+        val result = DownloadsOrchestrator.requestDownload(request(video))
+        val waitingForWifi = DownloadSettingsRepository.state.value.wifiOnly &&
+            DownloadsNetworkMonitor.state.value.kind == DownloadNetworkKind.Cellular
+        val message = if (result == DownloadEnqueueResult.Queued && waitingForWifi) {
+            runBlocking { getString(Res.string.downloads_waiting_wifi_toast) }
+        } else {
+            result.toastMessage()
+        }
+        NuvioToastController.show(message)
+    }
+
+    fun requestSeason(seasonNumber: Int) {
+        DownloadSettingsRepository.ensureLoaded()
+        val today = CurrentDateProvider.todayIsoDate()
+        val requests = meta.releasedEpisodesForSeason(seasonNumber, today)
+            .filter { it.season != null && it.episode != null }
+            .map { request(it, DownloadOrigin.Season) }
+        val queued = DownloadsOrchestrator.requestSeason(meta.id, seasonNumber, requests)
+        val message = if (queued > 0) {
+            runBlocking { getPluralString(Res.plurals.downloads_season_started_toast, queued, queued) }
+        } else {
+            runBlocking { getString(Res.string.downloads_season_nothing_toast) }
+        }
+        NuvioToastController.show(message)
+    }
+}
+
+internal val LocalDetailsDownloads = staticCompositionLocalOf<DetailsDownloadController?> { null }
