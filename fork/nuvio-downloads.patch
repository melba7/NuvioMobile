+
+    fun applyPolicy(allowCellular: Boolean) {
+        this.allowCellular = allowCellular
+        for (record in IosDownloadRecordStore.all().values.toList()) {
+            if (record.allowCellular == allowCellular) continue
+            val id = record.downloadId
+            when (record.phase) {
+                IosDownloadPhase.PAUSED, IosDownloadPhase.FAILED ->
+                    IosDownloadRecordStore.put(record.copy(allowCellular = allowCellular))
+                IosDownloadPhase.RUNNING ->
+                    if (id in liveTasks || id in stops) {
+                        // Resume data is taken from the old session, the task restarts in the other one.
+                        IosDownloadRecordStore.put(record.copy(migrating = true))
+                        stopLiveTask(id, restartAfter = false)
+                    } else {
+                        IosDownloadRecordStore.put(record.copy(allowCellular = allowCellular))
+                    }
+            }
+        }
+    }
