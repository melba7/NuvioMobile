+package com.nuvio.app.features.downloads
+
+import com.nuvio.app.features.downloads.core.DownloadNetworkGate
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+
+data class DownloadSettings(
+    /** Downloads only use Wi-Fi (or wired); they wait instead of using mobile data. */
+    val wifiOnly: Boolean = true,
+    /** Delete a watched downloaded episode and download the next one. */
+    val smartDownloads: Boolean = true,
+)
+
+/** Device-wide download settings (not per profile). Main thread only. */
+object DownloadSettingsRepository {
+    private const val wifiOnlyKey = "download_settings_wifi_only"
+    private const val smartDownloadsKey = "download_settings_smart"
+
+    private val _state = MutableStateFlow(DownloadSettings())
+    val state: StateFlow<DownloadSettings> = _state.asStateFlow()
+
+    private var loaded = false
+
+    fun ensureLoaded() {
+        if (loaded) return
+        loaded = true
+        val settings = DownloadSettings(
+            wifiOnly = DownloadsStorage.loadValue(wifiOnlyKey).toFlag(default = true),
+            smartDownloads = DownloadsStorage.loadValue(smartDownloadsKey).toFlag(default = true),
+        )
+        _state.value = settings
+        DownloadsPlatformDownloader.applyNetworkPolicy(DownloadNetworkGate.allowsCellular(settings.wifiOnly))
+    }
+
+    fun setWifiOnly(enabled: Boolean) {
+        ensureLoaded()
+        if (_state.value.wifiOnly == enabled) return
+        _state.update { it.copy(wifiOnly = enabled) }
+        DownloadsStorage.saveValue(wifiOnlyKey, enabled.toStoredFlag())
+        DownloadsPlatformDownloader.applyNetworkPolicy(DownloadNetworkGate.allowsCellular(enabled))
+        DownloadsOrchestrator.kickResolver()
+    }
+
+    fun setSmartDownloads(enabled: Boolean) {
+        ensureLoaded()
+        if (_state.value.smartDownloads == enabled) return
+        _state.update { it.copy(smartDownloads = enabled) }
+        DownloadsStorage.saveValue(smartDownloadsKey, enabled.toStoredFlag())
+        if (!enabled) {
+            DownloadsOrchestrator.clearPendingSmart()
+        }
+        DownloadsOrchestrator.kickResolver()
+    }
+
+    private fun String?.toFlag(default: Boolean): Boolean = when (this) {
+        "1" -> true
+        "0" -> false
+        else -> default
+    }
+
+    private fun Boolean.toStoredFlag(): String = if (this) "1" else "0"
+}
