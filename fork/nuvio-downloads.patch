@@ -0,0 +1,25 @@
+package com.nuvio.app.features.downloads.core
+
+/** Limits progress callbacks per key (download id) to roughly one per [minIntervalMs]. */
+class DownloadProgressThrottle(private val minIntervalMs: Long = 1_000L) {
+    private class Last(val ms: Long, val bytes: Long)
+
+    private val last = HashMap<String, Last>()
+
+    fun shouldEmit(key: String, nowMs: Long, downloadedBytes: Long, totalBytes: Long?): Boolean {
+        val previous = last[key]
+        val emit = when {
+            previous == null -> true
+            nowMs < previous.ms -> true
+            totalBytes != null && downloadedBytes >= totalBytes && downloadedBytes != previous.bytes -> true
+            nowMs - previous.ms >= minIntervalMs && downloadedBytes != previous.bytes -> true
+            else -> false
+        }
+        if (emit) last[key] = Last(nowMs, downloadedBytes)
+        return emit
+    }
+
+    fun reset(key: String) {
+        last.remove(key)
+    }
+}
diff --git a/composeApp/src/commonMain/kotlin/com/nuvio/app/features/downloads/core/DownloadStateMachine.kt b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/downloads/core/DownloadStateMachine.kt
new file mode 100644
index 0000000..4d08a49
--- /dev/null
+++ b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/downloads/core/DownloadStateMachine.kt
@@ -0,0 +1,250 @@
+package com.nuvio.app.features.downloads.core
+
+/**
+ * Pure download state machine. This file (like everything in `core/`) may only import `kotlin.*`.
+ *
+ * `state == null` means "no item" (nothing downloaded or requested).
+ */
+enum class DlState { Queued, Downloading, Paused, Completed, Failed }
+
+enum class DlOrigin { User, Season, Smart }
+
+enum class DlFailureKind { Network, LinkExpired, Http, Storage, BackgroundRefreshOff, InvalidUrl, Unknown }
+
+data class DlContext(
+    val origin: DlOrigin = DlOrigin.User,
+    val autoSelected: Boolean = false,
+    val resolveAttempts: Int = 0,
+    val hasSourceUrl: Boolean = false,
+    val failureKind: DlFailureKind? = null,
+)
+
+sealed interface DlEvent {
+    data object Request : DlEvent
+    data object StreamResolved : DlEvent
+    data object ResolveNoMatch : DlEvent
+    /** A queued item that already had a transfer (expired link, retry) could not be resolved again. */
+    data object ResolveFailed : DlEvent
+    data object ManualStreamChosen : DlEvent
+    data object Progress : DlEvent
+    data object TransferSucceeded : DlEvent
+    data class TransferFailed(val kind: DlFailureKind) : DlEvent
+    data object TransferPaused : DlEvent
+    data object UserPause : DlEvent
+    data object UserResume : DlEvent
+    data object UserRetry : DlEvent
+    data object Delete : DlEvent
+}
+
+enum class DlEffect {
+    StartResolve,
+    StartTransfer,
+    PauseTransfer,
+    CancelTransfer,
+    DeleteFiles,
+    RemoveItem,
+    RecordPreference,
+    NotifyNeedsSource,
+    DeleteReplacedItem,
+    Persist,
+}
+
+data class DlTransition(
+    val next: DlState?,
+    val context: DlContext,
+    val effects: List<DlEffect>,
+    val changed: Boolean,
+)
+
+object DownloadStateMachine {
+    const val MAX_RESOLVE_ATTEMPTS = 1
+
+    fun reduce(state: DlState?, context: DlContext, event: DlEvent): DlTransition {
+        return when (event) {
+            DlEvent.Request -> onRequest(state, context)
+            DlEvent.StreamResolved -> onStreamResolved(state, context)
+            DlEvent.ResolveNoMatch -> onResolveNoMatch(state, context)
+            DlEvent.ResolveFailed -> onResolveFailed(state, context)
+            DlEvent.ManualStreamChosen -> onManualStreamChosen(state, context)
+            DlEvent.Progress -> onProgress(state, context)
+            DlEvent.TransferSucceeded -> onTransferSucceeded(state, context)
+            is DlEvent.TransferFailed -> onTransferFailed(state, context, event.kind)
+            DlEvent.TransferPaused -> onTransferPaused(state, context)
+            DlEvent.UserPause -> onUserPause(state, context)
+            DlEvent.UserResume -> onUserResume(state, context)
+            DlEvent.UserRetry -> onUserRetry(state, context)
+            DlEvent.Delete -> onDelete(state, context)
+        }
+    }
+
+    private fun unchanged(state: DlState?, context: DlContext): DlTransition =
+        DlTransition(next = state, context = context, effects = emptyList(), changed = false)
+
+    private fun change(next: DlState?, context: DlContext, vararg effects: DlEffect): DlTransition =
+        DlTransition(next = next, context = context, effects = effects.toList(), changed = true)
+
+    // Rows 1 and 2.
+    private fun onRequest(state: DlState?, context: DlContext): DlTransition = when (state) {
+        null -> change(DlState.Queued, context, DlEffect.Persist, DlEffect.StartResolve)
+        DlState.Failed -> change(
+            DlState.Queued,
+            context.copy(resolveAttempts = 0, failureKind = null, hasSourceUrl = false),
+            DlEffect.CancelTransfer,
+            DlEffect.DeleteFiles,
+            DlEffect.Persist,
+            DlEffect.StartResolve,
+        )
+        else -> unchanged(state, context)
+    }
+
+    // Row 3.
+    private fun onStreamResolved(state: DlState?, context: DlContext): DlTransition {
+        if (state != DlState.Queued) return unchanged(state, context)
+        return change(
+            DlState.Downloading,
+            context.copy(autoSelected = true, hasSourceUrl = true, failureKind = null),
+            DlEffect.Persist,
+            DlEffect.StartTransfer,
+            DlEffect.RecordPreference,
+            DlEffect.DeleteReplacedItem,
+        )
+    }
+
+    // Row 4.
+    private fun onResolveNoMatch(state: DlState?, context: DlContext): DlTransition {
+        if (state != DlState.Queued) return unchanged(state, context)
+        return change(null, context, DlEffect.RemoveItem, DlEffect.NotifyNeedsSource)
+    }
+
+    // Row 17: the item stays visible (as failed, with "Retry") instead of vanishing.
+    private fun onResolveFailed(state: DlState?, context: DlContext): DlTransition {
+        if (state != DlState.Queued) return unchanged(state, context)
+        return change(DlState.Failed, context.copy(failureKind = DlFailureKind.LinkExpired), DlEffect.Persist)
+    }
+
+    // Row 5.
+    private fun onManualStreamChosen(state: DlState?, context: DlContext): DlTransition {
+        val next = context.copy(
+            autoSelected = false,
+            resolveAttempts = 0,
+            hasSourceUrl = true,
+            failureKind = null,
+        )
+        return if (state != null) {
+            change(
+                DlState.Downloading,
+                next,
+                DlEffect.CancelTransfer,
+                DlEffect.DeleteFiles,
+                DlEffect.Persist,
+                DlEffect.StartTransfer,
+                DlEffect.RecordPreference,
+            )
+        } else {
+            change(
+                DlState.Downloading,
+                next,
+                DlEffect.Persist,
+                DlEffect.StartTransfer,
+                DlEffect.RecordPreference,
+            )
+        }
+    }
+
+    // Row 6.
+    private fun onProgress(state: DlState?, context: DlContext): DlTransition {
+        if (state != DlState.Downloading) return unchanged(state, context)
+        return change(DlState.Downloading, context)
+    }
+
+    // Row 7.
+    private fun onTransferSucceeded(state: DlState?, context: DlContext): DlTransition {
+        if (state != DlState.Downloading) return unchanged(state, context)
+        return change(DlState.Completed, context.copy(failureKind = null), DlEffect.Persist)
+    }
+
+    // Rows 8 and 9.
+    private fun onTransferFailed(state: DlState?, context: DlContext, kind: DlFailureKind): DlTransition {
+        if (state != DlState.Downloading) return unchanged(state, context)
+        val reResolve = kind == DlFailureKind.LinkExpired &&
+            context.autoSelected &&
+            context.resolveAttempts < MAX_RESOLVE_ATTEMPTS
+        return if (reResolve) {
+            change(
+                DlState.Queued,
+                context.copy(
+                    resolveAttempts = context.resolveAttempts + 1,
+                    hasSourceUrl = false,
+                    failureKind = null,
+                ),
+                DlEffect.CancelTransfer,
+                DlEffect.DeleteFiles,
+                DlEffect.Persist,
+                DlEffect.StartResolve,
+            )
+        } else {
+            change(DlState.Failed, context.copy(failureKind = kind), DlEffect.Persist)
+        }
+    }
+
+    // Row 10.
+    private fun onTransferPaused(state: DlState?, context: DlContext): DlTransition {
+        if (state != DlState.Downloading) return unchanged(state, context)
+        return change(DlState.Paused, context, DlEffect.Persist)
+    }
+
+    // Row 11 (a queued item cannot be paused, only deleted).
+    private fun onUserPause(state: DlState?, context: DlContext): DlTransition {
+        if (state != DlState.Downloading) return unchanged(state, context)
+        return change(DlState.Paused, context, DlEffect.PauseTransfer, DlEffect.Persist)
+    }
+
+    // Rows 12 and 15.
+    private fun onUserResume(state: DlState?, context: DlContext): DlTransition = when (state) {
+        DlState.Paused ->
+            if (context.hasSourceUrl) {
+                change(
+                    DlState.Downloading,
+                    context.copy(failureKind = null),
+                    DlEffect.Persist,
+                    DlEffect.StartTransfer,
+                )
+            } else {
+                unchanged(state, context)
+            }
+        DlState.Failed -> retryFailed(context)
+        else -> unchanged(state, context)
+    }
+
+    // Rows 13 and 14.
+    private fun onUserRetry(state: DlState?, context: DlContext): DlTransition =
+        if (state == DlState.Failed) retryFailed(context) else unchanged(state, context)
+
+    private fun retryFailed(context: DlContext): DlTransition {
+        val reResolve = context.autoSelected &&
+            (context.failureKind == DlFailureKind.LinkExpired || !context.hasSourceUrl)
+        return when {
+            reResolve -> change(
+                DlState.Queued,
+                context.copy(resolveAttempts = 0, hasSourceUrl = false, failureKind = null),
+                DlEffect.CancelTransfer,
+                DlEffect.DeleteFiles,
+                DlEffect.Persist,
+                DlEffect.StartResolve,
+            )
+            context.hasSourceUrl -> change(
+                DlState.Downloading,
+                context.copy(failureKind = null),
+                DlEffect.Persist,
+                DlEffect.StartTransfer,
+            )
+            else -> unchanged(DlState.Failed, context)
+        }
+    }
+
+    // Row 16.
+    private fun onDelete(state: DlState?, context: DlContext): DlTransition {
+        if (state == null) return unchanged(null, context)
+        return change(null, context, DlEffect.CancelTransfer, DlEffect.DeleteFiles, DlEffect.RemoveItem)
+    }
+}
diff --git a/composeApp/src/commonMain/kotlin/com/nuvio/app/features/downloads/core/DownloadStorageMath.kt b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/downloads/core/DownloadStorageMath.kt
new file mode 100644
index 0000000..7b2d8b0
--- /dev/null
+++ b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/downloads/core/DownloadStorageMath.kt
@@ -0,0 +1,75 @@
+package com.nuvio.app.features.downloads.core
+
+data class StorageEntry(
+    val completed: Boolean,
+    val downloadedBytes: Long,
+    val totalBytes: Long?,
+)
+
+data class DeviceStorageInfo(
+    val totalBytes: Long,
+    val freeBytes: Long,
+)
+
+data class StorageBreakdown(
+    val downloadsBytes: Long,
+    val otherBytes: Long,
+    val freeBytes: Long,
+    val downloadsFraction: Float,
+    val otherFraction: Float,
+    val freeFraction: Float,
+)
+
+enum class ByteUnit { B, KB, MB, GB }
+
+data class FormattedBytes(
+    val value: String,
+    val unit: ByteUnit,
+)
+
+object DownloadStorageMath {
+    private const val KB = 1024L
+    private const val MB = 1024L * 1024L
+    private const val GB = 1024L * 1024L * 1024L
+
+    fun usedBytes(entries: List<StorageEntry>): Long {
+        var sum = 0L
+        for (entry in entries) {
+            val downloaded = entry.downloadedBytes.coerceAtLeast(0L)
+            val total = (entry.totalBytes ?: 0L).coerceAtLeast(0L)
+            sum += if (entry.completed) maxOf(total, downloaded) else downloaded
+        }
+        return sum
+    }
+
+    fun breakdown(downloadsBytes: Long, device: DeviceStorageInfo?): StorageBreakdown? {
+        if (device == null || device.totalBytes <= 0L) return null
+        val total = device.totalBytes
+        val free = device.freeBytes.coerceIn(0L, total)
+        val downloads = downloadsBytes.coerceIn(0L, total - free)
+        val other = total - free - downloads
+        val totalF = total.toFloat()
+        return StorageBreakdown(
+            downloadsBytes = downloads,
+            otherBytes = other,
+            freeBytes = free,
+            downloadsFraction = downloads.toFloat() / totalF,
+            otherFraction = other.toFloat() / totalF,
+            freeFraction = free.toFloat() / totalF,
+        )
+    }
+
+    /** Truncates (does not round) to one decimal, like the previous private formatter of the Downloads screen. */
+    fun format(bytes: Long): FormattedBytes {
+        if (bytes <= 0L) return FormattedBytes("0", ByteUnit.B)
+        if (bytes < KB) return FormattedBytes(bytes.toString(), ByteUnit.B)
+        val (size, unit) = when {
+            bytes < MB -> KB to ByteUnit.KB
+            bytes < GB -> MB to ByteUnit.MB
+            else -> GB to ByteUnit.GB
+        }
+        val v = bytes.toDouble() / size.toDouble()
+        val truncated = (v * 10.0).toLong() / 10.0
+        return FormattedBytes(truncated.toString(), unit)
+    }
+}
diff --git a/composeApp/src/commonMain/kotlin/com/nuvio/app/features/downloads/core/DownloadStreamSelector.kt b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/downloads/core/DownloadStreamSelector.kt
new file mode 100644
index 0000000..197257d
--- /dev/null
+++ b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/downloads/core/DownloadStreamSelector.kt
@@ -0,0 +1,112 @@
+package com.nuvio.app.features.downloads.core
+
+data class StreamCandidate(
+    val index: Int,
+    val addonId: String,
+    val addonName: String,
+    val name: String?,
+    val description: String?,
+    val filename: String?,
+    val bingeGroup: String?,
+    val directUrl: String?,
+    val resolvable: Boolean,
+)
+
+data class StreamPreference(
+    val addonId: String,
+    val addonName: String,
+    val resolution: Int,
+    val bingeGroup: String?,
+    val updatedAtEpochMs: Long,
+)
+
+enum class StreamSelectionFailure { NoPreference, ProviderMissing, QualityMissing, NoDownloadableStream }
+
+data class StreamSelection(
+    val picks: List<StreamCandidate>,
+    val failure: StreamSelectionFailure?,
+)
+
+/** Exactly the rule the downloader used before (magnet, HLS, DASH and torrent links are not downloadable files). */
+object DownloadUrlRules {
+    fun isSupported(url: String?): Boolean {
+        if (url == null) return false
+        val normalized = url.trim().lowercase()
+        if (normalized.isEmpty()) return false
+        if (normalized.startsWith("magnet:")) return false
+        if (normalized.endsWith(".m3u8") || normalized.contains(".m3u8?")) return false
+        if (normalized.endsWith(".mpd") || normalized.contains(".mpd?")) return false
+        if (normalized.endsWith(".torrent") || normalized.contains(".torrent?")) return false
+        return normalized.startsWith("http://") || normalized.startsWith("https://")
+    }
+}
+
+object DownloadStreamSelector {
+    const val MAX_PICKS = 3
+
+    fun select(candidates: List<StreamCandidate>, preference: StreamPreference?): StreamSelection {
+        if (preference == null) {
+            return StreamSelection(emptyList(), StreamSelectionFailure.NoPreference)
+        }
+
+        val eligible = candidates.filter { candidate ->
+            DownloadUrlRules.isSupported(candidate.directUrl) ||
+                (candidate.directUrl == null && candidate.resolvable)
+        }
+        if (eligible.isEmpty()) {
+            return StreamSelection(emptyList(), StreamSelectionFailure.NoDownloadableStream)
+        }
+
+        var pool: List<StreamCandidate> = if (preference.addonId.isNotBlank()) {
+            eligible.filter { it.addonId == preference.addonId }
+        } else {
+            emptyList()
+        }
+        if (pool.isEmpty() && preference.addonName.isNotBlank()) {
+            val wanted = preference.addonName.trim()
+            pool = eligible.filter { it.addonName.trim().equals(wanted, ignoreCase = true) }
+        }
+        if (pool.isEmpty()) {
+            return StreamSelection(emptyList(), StreamSelectionFailure.ProviderMissing)
+        }
+
+        val wantedBinge = preference.bingeGroup?.trim().orEmpty()
+        val tierA = if (wantedBinge.isNotEmpty()) {
+            pool.filter { it.bingeGroup?.trim() == wantedBinge }.sortedBy { it.index }
+        } else {
+            emptyList()
+        }
+        val tierB = pool
+            .filter { candidate ->
+                val text = listOfNotNull(candidate.name, candidate.description, candidate.filename)
+                    .joinToString(" ")
+                StreamQualityParser.resolution(text) == preference.resolution
+            }
+            .sortedBy { it.index }
+
+        val picks = ArrayList<StreamCandidate>()
+        val seen = HashSet<Int>()
+        for (candidate in tierA + tierB) {
+            if (picks.size >= MAX_PICKS) break
+            if (seen.add(candidate.index)) picks.add(candidate)
+        }
+        if (picks.isEmpty()) {
+            return StreamSelection(emptyList(), StreamSelectionFailure.QualityMissing)
+        }
+        return StreamSelection(picks, null)
+    }
+
+    /** Newest candidate wins; ties go to the earlier argument; candidates with no identity are ignored. */
+    fun resolvePreference(vararg candidates: StreamPreference?): StreamPreference? {
+        var best: StreamPreference? = null
+        for (candidate in candidates) {
+            if (candidate == null) continue
+            if (candidate.addonId.isBlank() && candidate.addonName.isBlank()) continue
+            val current = best
+            if (current == null || candidate.updatedAtEpochMs > current.updatedAtEpochMs) {
+                best = candidate
+            }
+        }
+        return best
+    }
+}
diff --git a/composeApp/src/commonMain/kotlin/com/nuvio/app/features/downloads/core/SmartDownloadsPlanner.kt b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/downloads/core/SmartDownloadsPlanner.kt
