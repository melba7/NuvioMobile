+
+@Serializable
+internal data class SmartPending(
+    val parentMetaId: String,
+    val parentMetaType: String,
+    val videoId: String,
+    val seasonNumber: Int,
+    val episodeNumber: Int,
+    val createdAtEpochMs: Long,
+) {
