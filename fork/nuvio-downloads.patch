+import nuvio.composeapp.generated.resources.downloads_action_retry_download
+import org.jetbrains.compose.resources.stringResource
+
+/**
+ * What a tap on a download icon opens when the item already exists. [title] is the episode or movie title.
+ * [onPlay] is only offered for completed items, [onChooseSource] only for failed ones.
+ */
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+internal fun DownloadActionsSheet(
+    item: DownloadItem,
+    title: String,
+    onDismiss: () -> Unit,
+    onPlay: (() -> Unit)? = null,
+    onChooseSource: (() -> Unit)? = null,
+) {
+    val iconState = rememberDownloadIconState(item)
+    val sheetState = rememberModalBottomSheetState(skipPartiallyExpanded = true)
+    val coroutineScope = rememberCoroutineScope()
+    val downloadId = item.id
+
+    fun perform(action: () -> Unit) {
+        action()
+        coroutineScope.launch {
+            dismissNuvioBottomSheet(sheetState = sheetState, onDismiss = onDismiss)
+        }
+    }
+
+    NuvioModalBottomSheet(
+        onDismissRequest = {
+            coroutineScope.launch {
+                dismissNuvioBottomSheet(sheetState = sheetState, onDismiss = onDismiss)
+            }
+        },
+        sheetState = sheetState,
+    ) {
+        Column(
+            modifier = Modifier
+                .fillMaxWidth()
+                .padding(bottom = nuvioSafeBottomPadding(16.dp)),
+        ) {
+            Column(
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .padding(horizontal = 16.dp, vertical = 14.dp),
+                verticalArrangement = Arrangement.spacedBy(4.dp),
+            ) {
+                Text(
+                    text = title,
+                    style = MaterialTheme.typography.titleLarge,
+                    color = MaterialTheme.colorScheme.onSurface,
+                    fontWeight = FontWeight.SemiBold,
+                    maxLines = 2,
+                    overflow = TextOverflow.Ellipsis,
+                )
+                Text(
+                    text = downloadStatusText(item, iconState),
+                    style = MaterialTheme.typography.bodyMedium,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    maxLines = 2,
+                    overflow = TextOverflow.Ellipsis,
+                )
+            }
+
+            NuvioBottomSheetDivider()
+
+            when (item.status) {
+                DownloadStatus.Queued -> {
+                    CancelRow { perform { DownloadsRepository.cancelDownload(downloadId) } }
+                }
+
+                DownloadStatus.Downloading -> {
+                    NuvioBottomSheetActionRow(
+                        icon = Icons.Rounded.Pause,
+                        title = stringResource(Res.string.downloads_action_pause_download),
+                        onClick = { perform { DownloadsRepository.pauseDownload(downloadId) } },
+                    )
+                    CancelRow { perform { DownloadsRepository.cancelDownload(downloadId) } }
+                }
+
+                DownloadStatus.Paused -> {
+                    NuvioBottomSheetActionRow(
+                        icon = Icons.Rounded.ArrowDownward,
+                        title = stringResource(Res.string.downloads_action_resume_download),
+                        onClick = { perform { DownloadsRepository.resumeDownload(downloadId) } },
+                    )
+                    CancelRow { perform { DownloadsRepository.cancelDownload(downloadId) } }
+                }
+
+                DownloadStatus.Completed -> {
+                    if (onPlay != null) {
+                        NuvioBottomSheetActionRow(
+                            icon = Icons.Rounded.PlayArrow,
+                            title = stringResource(Res.string.action_play),
+                            onClick = { perform(onPlay) },
+                        )
+                    }
+                    DeleteRow { perform { DownloadsRepository.cancelDownload(downloadId) } }
+                }
+
+                DownloadStatus.Failed -> {
+                    NuvioBottomSheetActionRow(
+                        icon = Icons.Rounded.Refresh,
+                        title = stringResource(Res.string.downloads_action_retry_download),
+                        onClick = { perform { DownloadsRepository.retryDownload(downloadId) } },
+                    )
+                    if (onChooseSource != null) {
+                        NuvioBottomSheetActionRow(
+                            icon = Icons.AutoMirrored.Filled.PlaylistPlay,
+                            title = stringResource(Res.string.downloads_action_choose_source),
+                            onClick = { perform(onChooseSource) },
+                        )
+                    }
+                    DeleteRow { perform { DownloadsRepository.cancelDownload(downloadId) } }
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun CancelRow(onClick: () -> Unit) {
+    NuvioBottomSheetActionRow(
+        icon = Icons.Rounded.Close,
+        title = stringResource(Res.string.downloads_action_cancel_download),
+        onClick = onClick,
+    )
+}
+
+@Composable
+private fun DeleteRow(onClick: () -> Unit) {
+    NuvioBottomSheetActionRow(
+        icon = Icons.Rounded.Delete,
+        title = stringResource(Res.string.downloads_action_delete_download),
+        onClick = onClick,
+    )
+}
