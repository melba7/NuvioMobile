@@ -0,0 +1,145 @@
+package com.nuvio.app.features.downloads.core
+
+enum class TransferErrorAction { Ignore, MarkPaused, RestartWithResumeData, RestartFresh, Fail }
+
+data class TransferErrorInput(
+    val domain: String,
+    val code: Long,
+    val hasResumeData: Boolean,
+    val cancelReason: Int?,
+    val pauseRequested: Boolean,
+    val removed: Boolean,
+    val migrating: Boolean,
+    val startedFromResumeData: Boolean,
+    val autoRetries: Int,
+    val freshRestarts: Int,
+)
+
+data class TransferErrorDecision(
+    val action: TransferErrorAction,
+    val failureKind: DlFailureKind?,
+    val retryDelaySeconds: Int = 0,
+)
+
+data class DownloadTransferFailure(
+    val message: String,
+    val kind: DlFailureKind = DlFailureKind.Unknown,
+    val httpStatus: Int? = null,
+)
+
+/** Pure decision table for NSURLSession background transfer errors. Constants are plain literals on purpose. */
+object TransferErrorPolicy {
+    const val MAX_AUTO_RETRIES = 3
+    const val MAX_FRESH_RESTARTS = 1
+
+    private const val URL_ERROR_DOMAIN = "NSURLErrorDomain"
+    private const val POSIX_ERROR_DOMAIN = "NSPOSIXErrorDomain"
+    private const val CODE_CANCELLED = -999L
+    private const val CANCEL_REASON_BACKGROUND_UPDATES_DISABLED = 1
+    private const val CANCEL_REASON_INSUFFICIENT_RESOURCES = 2
+
+    // -1001 timed out, -1003 cannot find host, -1004 cannot connect to host, -1005 connection lost,
+    // -1006 DNS lookup failed, -1009 not connected, -1018 international roaming off, -1019 call active,
+    // -1020 data not allowed, -997 lost connection to the background transfer service.
+    private val retryableNetworkCodes: Set<Long> = setOf(
+        -1001L, -1003L, -1004L, -1005L, -1006L, -1009L, -1018L, -1019L, -1020L, -997L,
+    )
+
+    fun decide(input: TransferErrorInput): TransferErrorDecision {
+        // 1
+        if (input.removed) return TransferErrorDecision(TransferErrorAction.Ignore, null)
+
+        val isUrlDomain = input.domain == URL_ERROR_DOMAIN
+
+        if (isUrlDomain && input.code == CODE_CANCELLED) {
+            // 2
+            if (input.pauseRequested) {
+                return TransferErrorDecision(TransferErrorAction.MarkPaused, null)
+            }
+            // 3
+            if (input.migrating) {
+                return if (input.hasResumeData) {
+                    TransferErrorDecision(TransferErrorAction.RestartWithResumeData, null)
+                } else {
+                    TransferErrorDecision(TransferErrorAction.RestartFresh, null)
+                }
+            }
+            // 4
+            if (input.cancelReason == CANCEL_REASON_BACKGROUND_UPDATES_DISABLED) {
+                return TransferErrorDecision(TransferErrorAction.MarkPaused, DlFailureKind.BackgroundRefreshOff)
+            }
+            // 5
+            if (input.cancelReason == CANCEL_REASON_INSUFFICIENT_RESOURCES) {
+                return TransferErrorDecision(TransferErrorAction.MarkPaused, null)
+            }
+            // 6
+            return when {
+                input.hasResumeData ->
+                    TransferErrorDecision(TransferErrorAction.RestartWithResumeData, null)
+                input.autoRetries < MAX_AUTO_RETRIES ->
+                    TransferErrorDecision(TransferErrorAction.RestartFresh, null)
+                else ->
+                    TransferErrorDecision(TransferErrorAction.MarkPaused, null)
+            }
+        }
+
+        // 7
+        if (isUrlDomain && input.code in retryableNetworkCodes) {
+            if (input.autoRetries < MAX_AUTO_RETRIES) {
+                val delay = 15 * (1 shl input.autoRetries)
+                val action = if (input.hasResumeData) {
+                    TransferErrorAction.RestartWithResumeData
+                } else {
+                    TransferErrorAction.RestartFresh
+                }
+                return TransferErrorDecision(action, DlFailureKind.Network, delay)
+            }
+            return TransferErrorDecision(TransferErrorAction.Fail, DlFailureKind.Network)
+        }
+
+        // 9 (kept ahead of rule 10: a full disk is never fixed by restarting)
+        if (input.domain == POSIX_ERROR_DOMAIN && input.code == 28L) {
+            return TransferErrorDecision(TransferErrorAction.Fail, DlFailureKind.Storage)
+        }
+
+        // 10 (kept ahead of rule 8: a task created from resume data can fail with a file error because the resume
+        // data did not fit the other session; that is not a storage problem and one restart from zero is allowed)
+        if (input.startedFromResumeData && !input.hasResumeData && input.freshRestarts < MAX_FRESH_RESTARTS) {
+            return TransferErrorDecision(TransferErrorAction.RestartFresh, null)
+        }
+
+        // 8
+        if (isUrlDomain && input.code in -3007L..-3000L) {
+            return TransferErrorDecision(TransferErrorAction.Fail, DlFailureKind.Storage)
+        }
+
+        // 11
+        return TransferErrorDecision(TransferErrorAction.Fail, DlFailureKind.Unknown)
+    }
+
+    fun decideHttp(
+        status: Int,
+        startedFromResumeData: Boolean,
+        autoRetries: Int,
+        freshRestarts: Int,
+    ): TransferErrorDecision {
+        if (status in 200..299) return TransferErrorDecision(TransferErrorAction.Ignore, null)
+        return when (status) {
+            416 ->
+                if (freshRestarts < MAX_FRESH_RESTARTS) {
+                    TransferErrorDecision(TransferErrorAction.RestartFresh, null)
+                } else {
+                    TransferErrorDecision(TransferErrorAction.Fail, DlFailureKind.Http)
+                }
+            401, 403, 404, 410, 451 ->
+                TransferErrorDecision(TransferErrorAction.Fail, DlFailureKind.LinkExpired)
+            408, 429, in 500..599 ->
+                if (autoRetries < MAX_AUTO_RETRIES) {
+                    TransferErrorDecision(TransferErrorAction.RestartFresh, null, 30 * (1 shl autoRetries))
+                } else {
+                    TransferErrorDecision(TransferErrorAction.Fail, DlFailureKind.Http)
+                }
+            else -> TransferErrorDecision(TransferErrorAction.Fail, DlFailureKind.Http)
+        }
+    }
+}
