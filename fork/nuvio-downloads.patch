+package com.nuvio.app.features.downloads.core
+
+/**
+ * Heuristic resolution detection from add-on provided text (stream name, description, file name).
+ * Returns one of 2160, 1440, 1080, 720, 576, 480, 360 or 0 (unknown).
+ */
+object StreamQualityParser {
+    // Order matters: the first token found wins.
+    private val tokens: List<Pair<String, Int>> = listOf(
+        "2160p" to 2160,
+        "2160" to 2160,
+        "1440p" to 1440,
+        "1440" to 1440,
+        "1080p" to 1080,
+        "1080i" to 1080,
+        "1080" to 1080,
+        "720p" to 720,
+        "720" to 720,
+        "576p" to 576,
+        "480p" to 480,
+        "480" to 480,
+        "360p" to 360,
+        "4k" to 2160,
+        "uhd" to 2160,
+        "2k" to 1440,
+        "qhd" to 1440,
+        "fhd" to 1080,
+        "hd" to 720,
+        "sd" to 480,
+    )
+
+    fun resolution(text: String?): Int {
+        if (text.isNullOrEmpty()) return 0
+        val lower = text.lowercase()
+        for ((token, value) in tokens) {
+            if (containsToken(lower, token)) return value
+        }
+        return 0
+    }
+
+    private fun containsToken(text: String, token: String): Boolean {
+        var from = 0
+        while (from <= text.length - token.length) {
+            val index = text.indexOf(token, from)
+            if (index < 0) return false
+            val before = if (index == 0) null else text[index - 1]
+            val afterIndex = index + token.length
+            val after = if (afterIndex >= text.length) null else text[afterIndex]
+            if (!isWordChar(before) && !isWordChar(after)) return true
+            from = index + 1
+        }
+        return false
+    }
+
+    private fun isWordChar(c: Char?): Boolean =
+        c != null && ((c in 'a'..'z') || (c in '0'..'9'))
+}
