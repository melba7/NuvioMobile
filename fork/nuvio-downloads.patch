+    var resumeDataDone: Boolean = false,
+    var completionDone: Boolean = false,
+    var restartAfter: Boolean = false,
+)
+
+private class LiveTask(
+    val task: NSURLSessionDownloadTask,
+    val sessionIdentifier: String,
+) {
+    fun matches(other: NSURLSessionTask, otherSessionIdentifier: String): Boolean =
+        task.taskIdentifier == other.taskIdentifier && sessionIdentifier == otherSessionIdentifier
+}
