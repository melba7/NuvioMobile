+internal fun DownloadItem?.iconProgress(): Float {
+    val item = this ?: return 0f
+    val total = item.totalBytes?.takeIf { it > 0L } ?: return DOWNLOAD_PROGRESS_UNKNOWN
+    return (item.downloadedBytes.toDouble() / total.toDouble()).toFloat().coerceIn(0f, 1f)
+}
+
+/**
+ * Icon state of a download for the current settings and network. [item] null means "not downloaded".
+ * Reads the Wi-Fi only setting and the network state, so a "waiting" state appears and disappears live.
+ */
+@Composable
+internal fun rememberDownloadIconState(item: DownloadItem?): DownloadIconState {
+    val settings by remember {
+        DownloadSettingsRepository.ensureLoaded()
+        DownloadSettingsRepository.state
+    }.collectAsStateWithLifecycle()
+    val network by remember {
+        DownloadsNetworkMonitor.ensureStarted()
+        DownloadsNetworkMonitor.state
+    }.collectAsStateWithLifecycle()
+    return DownloadNetworkGate.iconState(
+        state = item?.status?.toDlState(),
+        downloadedBytes = item?.downloadedBytes ?: 0L,
+        totalBytes = item?.totalBytes,
+        wifiOnly = settings.wifiOnly,
+        network = network,
+    )
+}
+
+@Composable
+internal fun downloadStateLabel(state: DownloadIconState, progress: Float, subject: String): String =
+    when (state) {
+        DownloadIconState.NotDownloaded -> stringResource(Res.string.downloads_cd_download, subject)
+        DownloadIconState.Queued -> stringResource(Res.string.downloads_cd_queued)
+        DownloadIconState.WaitingForWifi -> stringResource(Res.string.downloads_cd_waiting_wifi)
+        DownloadIconState.WaitingForNetwork -> stringResource(Res.string.downloads_cd_waiting_network)
+        DownloadIconState.Downloading ->
+            if (progress in 0f..1f) {
+                stringResource(Res.string.downloads_cd_downloading, (progress * 100f).toInt())
+            } else {
+                stringResource(Res.string.downloads_cd_downloading_indeterminate)
+            }
+        DownloadIconState.Paused -> stringResource(Res.string.downloads_cd_paused)
+        DownloadIconState.Completed -> stringResource(Res.string.downloads_cd_completed)
+        DownloadIconState.Failed -> stringResource(Res.string.downloads_cd_failed)
+    }
+
+/** The 26 dp state glyph: a progress ring around a small icon, or a bare icon. No touch handling. */
+@Composable
+internal fun DownloadStateIcon(
+    state: DownloadIconState,
+    progress: Float,
+    onImage: Boolean,
+    modifier: Modifier = Modifier,
+) {
+    val colors = MaterialTheme.nuvio.colors
+    val base = if (onImage) Color.White else MaterialTheme.colorScheme.onSurfaceVariant
+    val track = base.copy(alpha = 0.30f)
+    val animatedProgress by animateFloatAsState(
+        targetValue = progress.coerceIn(0f, 1f),
+        label = "downloadProgress",
+    )
+    val known = progress in 0f..1f
+
+    Box(
+        modifier = modifier.size(IconBoxSize),
+        contentAlignment = Alignment.Center,
+    ) {
+        when (state) {
+            DownloadIconState.NotDownloaded -> Glyph(Icons.Rounded.Download, 24.dp, base)
+            DownloadIconState.Completed -> Glyph(Icons.Rounded.DownloadDone, 24.dp, colors.accent)
+            DownloadIconState.Failed -> Glyph(Icons.Rounded.ErrorOutline, 24.dp, colors.danger)
+            DownloadIconState.Queued -> {
+                SpinningRing(track = track, arc = colors.accent)
+                Glyph(Icons.Rounded.HourglassEmpty, 12.dp, colors.textMuted)
+            }
+            DownloadIconState.WaitingForWifi -> {
+                StaticRing(track)
+                Glyph(Icons.Rounded.WifiOff, 14.dp, colors.warning)
+            }
+            DownloadIconState.WaitingForNetwork -> {
+                StaticRing(track)
+                Glyph(Icons.Rounded.CloudOff, 14.dp, colors.warning)
+            }
+            DownloadIconState.Downloading -> {
+                if (known) {
+                    ProgressRing(track = track, arc = colors.accent, fraction = animatedProgress)
+                } else {
+                    SpinningRing(track = track, arc = colors.accent)
+                }
+                Glyph(Icons.Rounded.Pause, 12.dp, base)
+            }
+            DownloadIconState.Paused -> {
+                ProgressRing(track = track, arc = colors.textMuted, fraction = if (known) animatedProgress else 0f)
+                Glyph(Icons.Rounded.ArrowDownward, 12.dp, base)
+            }
+        }
+    }
+}
+
+/**
+ * [DownloadStateIcon] inside a 44 dp touch target. With [onImage] a dark circular scrim keeps the icon readable on
+ * artwork.
+ */
+@Composable
+internal fun DownloadStateButton(
+    state: DownloadIconState,
+    progress: Float,
+    onImage: Boolean,
+    label: String,
+    onClick: () -> Unit,
+    modifier: Modifier = Modifier,
+    touchSize: Dp = TouchTargetSize,
+) {
+    Box(
+        modifier = modifier
+            .size(touchSize)
+            .clip(CircleShape)
+            .semantics {
+                contentDescription = label
+                if (state == DownloadIconState.Downloading && progress in 0f..1f) {
+                    progressBarRangeInfo = ProgressBarRangeInfo(progress, 0f..1f)
+                }
+            }
+            .clickable(role = Role.Button, onClick = onClick),
+        contentAlignment = Alignment.Center,
+    ) {
+        if (onImage) {
+            Box(
+                modifier = Modifier
+                    .size(ScrimSize)
+                    .clip(CircleShape)
+                    .background(Color.Black.copy(alpha = 0.42f)),
+            )
+        }
+        DownloadStateIcon(state = state, progress = progress, onImage = onImage)
+    }
+}
+
+@Composable
+private fun Glyph(icon: ImageVector, size: Dp, tint: Color) {
+    Icon(
+        imageVector = icon,
+        contentDescription = null,
+        tint = tint,
+        modifier = Modifier.size(size),
+    )
+}
+
+@Composable
+private fun StaticRing(track: Color) {
+    Canvas(Modifier.fillMaxSize()) {
+        drawRing(track)
+    }
+}
+
+@Composable
+private fun ProgressRing(track: Color, arc: Color, fraction: Float) {
+    Canvas(Modifier.fillMaxSize()) {
+        drawRing(track)
+        drawRingArc(arc, startAngle = -90f, sweep = 360f * fraction.coerceIn(0f, 1f))
+    }
+}
+
+/** Only composed for the states that spin, so the infinite animation does not run for static icons. */
+@Composable
+private fun SpinningRing(track: Color, arc: Color) {
+    val transition = rememberInfiniteTransition(label = "downloadQueuedSpinner")
+    val rotation by transition.animateFloat(
+        initialValue = 0f,
+        targetValue = 360f,
+        animationSpec = infiniteRepeatable(
+            animation = tween(durationMillis = 1100, easing = LinearEasing),
+            repeatMode = RepeatMode.Restart,
+        ),
+        label = "downloadQueuedRotation",
+    )
+    Canvas(Modifier.fillMaxSize()) {
+        drawRing(track)
+        drawRingArc(arc, startAngle = -90f + rotation, sweep = 90f)
+    }
+}
+
+private fun DrawScope.drawRing(color: Color) {
+    val stroke = RingStroke.toPx()
+    drawArc(
+        color = color,
+        startAngle = 0f,
+        sweepAngle = 360f,
+        useCenter = false,
+        topLeft = Offset(stroke / 2f, stroke / 2f),
+        size = Size(size.width - stroke, size.height - stroke),
+        style = Stroke(width = stroke),
+    )
+}
+
+private fun DrawScope.drawRingArc(color: Color, startAngle: Float, sweep: Float) {
+    if (sweep <= 0f) return
+    val stroke = RingStroke.toPx()
+    drawArc(
+        color = color,
+        startAngle = startAngle,
+        sweepAngle = sweep,
+        useCenter = false,
+        topLeft = Offset(stroke / 2f, stroke / 2f),
+        size = Size(size.width - stroke, size.height - stroke),
+        style = Stroke(width = stroke, cap = StrokeCap.Round),
+    )
+}
