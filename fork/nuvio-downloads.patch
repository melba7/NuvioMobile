@@ -0,0 +1,62 @@
+package com.nuvio.app.features.downloads
+
+import android.content.Context
+import android.net.ConnectivityManager
+import android.net.Network
+import android.net.NetworkCapabilities
+import com.nuvio.app.features.downloads.core.DownloadNetworkKind
+import com.nuvio.app.features.downloads.core.DownloadNetworkState
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+internal actual object DownloadsNetworkMonitor {
+    private val _state = MutableStateFlow(DownloadNetworkState())
+    actual val state: StateFlow<DownloadNetworkState> = _state.asStateFlow()
+
+    private var appContext: Context? = null
+    private var started = false
+
+    fun initialize(context: Context) {
+        appContext = context.applicationContext
+    }
+
+    @Synchronized
+    actual fun ensureStarted() {
+        if (started) return
+        val context = appContext ?: return
+        val manager = context.getSystemService(ConnectivityManager::class.java) ?: return
+        started = true
+        runCatching {
+            publish(manager, manager.getNetworkCapabilities(manager.activeNetwork))
+            manager.registerDefaultNetworkCallback(
+                object : ConnectivityManager.NetworkCallback() {
+                    override fun onCapabilitiesChanged(network: Network, networkCapabilities: NetworkCapabilities) {
+                        publish(manager, networkCapabilities)
+                    }
+
+                    override fun onLost(network: Network) {
+                        publish(manager, null)
+                    }
+                },
+            )
+        }
+    }
+
+    private fun publish(manager: ConnectivityManager, caps: NetworkCapabilities?) {
+        val kind = when {
+            caps == null || !caps.hasCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET) ->
+                DownloadNetworkKind.None
+            caps.hasTransport(NetworkCapabilities.TRANSPORT_WIFI) ||
+                caps.hasTransport(NetworkCapabilities.TRANSPORT_ETHERNET) -> DownloadNetworkKind.Wifi
+            caps.hasTransport(NetworkCapabilities.TRANSPORT_CELLULAR) -> DownloadNetworkKind.Cellular
+            caps.hasCapability(NetworkCapabilities.NET_CAPABILITY_NOT_METERED) -> DownloadNetworkKind.Wifi
+            else -> DownloadNetworkKind.Cellular
+        }
+        val expensive = caps != null && !caps.hasCapability(NetworkCapabilities.NET_CAPABILITY_NOT_METERED)
+        val constrained = runCatching {
+            manager.restrictBackgroundStatus == ConnectivityManager.RESTRICT_BACKGROUND_STATUS_ENABLED
+        }.getOrDefault(false)
+        _state.value = DownloadNetworkState(kind = kind, isExpensive = expensive, isConstrained = constrained)
+    }
+}
