+package com.nuvio.app.features.downloads
+
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.decodeFromString
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import platform.Foundation.NSData
+import platform.Foundation.NSUserDefaults
+
+/**
+ * What the native side knows about one download. It survives app termination; the app-level item list is
+ * reconciled against it (`IosBackgroundDownloads.restore`).
+ */
+@Serializable
+internal data class IosDownloadRecord(
+    val downloadId: String,
+    /** Destination name inside `Documents/nuvio_downloads`. */
+    val fileName: String,
+    val sourceUrl: String,
+    val requestHeaders: Map<String, String> = emptyMap(),
+    /** Which session owns (or will own) the task. */
+    val allowCellular: Boolean,
+    /** "running" | "paused" | "completed" | "failed" */
+    val phase: String,
+    val downloadedBytes: Long = 0L,
+    val totalBytes: Long? = null,
+    /** `DlFailureKind.name` */
+    val failureKind: String? = null,
+    val httpStatus: Int? = null,
+    /** `NSError.localizedDescription`, used as the message when no specific string applies. */
+    val errorText: String? = null,
+    val autoRetries: Int = 0,
+    val freshRestarts: Int = 0,
+    val startedFromResumeData: Boolean = false,
+    val pauseRequested: Boolean = false,
+    val migrating: Boolean = false,
+    val updatedAtEpochMs: Long = 0L,
+)
+
+internal object IosDownloadPhase {
+    const val RUNNING = "running"
+    const val PAUSED = "paused"
+    const val COMPLETED = "completed"
+    const val FAILED = "failed"
+}
+
+/** Main thread only. */
+internal object IosDownloadRecordStore {
+    private const val RECORDS_KEY = "nuvio.downloads.bg.records.v1"
+    private const val RESUME_KEY_PREFIX = "nuvio.downloads.bg.resume."
+
+    private val json = Json {
+        ignoreUnknownKeys = true
+        encodeDefaults = true
+    }
+
+    private var cache: MutableMap<String, IosDownloadRecord>? = null
+
+    fun all(): Map<String, IosDownloadRecord> = load()
+
+    fun get(downloadId: String): IosDownloadRecord? = load()[downloadId]
+
+    fun findByFileName(fileName: String): IosDownloadRecord? =
+        load().values.firstOrNull { it.fileName == fileName }
+
+    fun put(record: IosDownloadRecord) {
+        val records = load()
+        records[record.downloadId] = record.copy(updatedAtEpochMs = DownloadsClock.nowEpochMs())
+        persist(records)
+    }
+
+    /** Also removes the stored resume data. */
+    fun remove(downloadId: String) {
+        val records = load()
+        if (records.remove(downloadId) != null) persist(records)
+        saveResumeData(downloadId, null)
+    }
+
+    fun resumeData(downloadId: String): NSData? =
+        NSUserDefaults.standardUserDefaults.dataForKey(resumeKey(downloadId))
+
+    fun saveResumeData(downloadId: String, data: NSData?) {
+        val defaults = NSUserDefaults.standardUserDefaults
+        if (data == null || data.length.toLong() == 0L) {
+            defaults.removeObjectForKey(resumeKey(downloadId))
+        } else {
+            defaults.setObject(data, forKey = resumeKey(downloadId))
+        }
+    }
+
+    private fun resumeKey(downloadId: String): String = "$RESUME_KEY_PREFIX$downloadId"
+
+    private fun load(): MutableMap<String, IosDownloadRecord> {
+        cache?.let { return it }
+        val payload = NSUserDefaults.standardUserDefaults.stringForKey(RECORDS_KEY).orEmpty().trim()
+        val decoded: Map<String, IosDownloadRecord> = if (payload.isEmpty()) {
+            emptyMap()
+        } else {
+            runCatching { json.decodeFromString<Map<String, IosDownloadRecord>>(payload) }
+                .getOrDefault(emptyMap())
+        }
+        val records = decoded.toMutableMap()
+        cache = records
+        return records
+    }
+
+    private fun persist(records: Map<String, IosDownloadRecord>) {
+        val defaults = NSUserDefaults.standardUserDefaults
+        if (records.isEmpty()) {
+            defaults.removeObjectForKey(RECORDS_KEY)
+        } else {
+            defaults.setObject(json.encodeToString(records), forKey = RECORDS_KEY)
+        }
+    }
+}
