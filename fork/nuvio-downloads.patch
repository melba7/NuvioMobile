+                        // The Wi-Fi only setting changed while the app was not running.
+                        IosDownloadRecordStore.put(record.copy(migrating = true))
+                        stopLiveTask(id, restartAfter = false)
+                    }
+                }
+                IosDownloadPhase.PAUSED -> {
+                    // The pause was requested but the task survived (app killed in between): stop it properly.
+                    liveTasks[id] = LiveTask(task, identifier)
+                    stopLiveTask(id, restartAfter = false)
+                }
+                else -> task.cancel()
+            }
+        }
+        enumeratedSessions += 1
+    }
+
+    /** Starts every record that should be running but has no task (reinstall/restore, lost tasks). */
+    private fun reconcileOrphans() {
+        for (record in IosDownloadRecordStore.all().values.toList()) {
+            val id = record.downloadId
+            if (record.phase != IosDownloadPhase.RUNNING) continue
+            if (id in liveTasks || id in stops || id in tombstones) continue
+            startTask(record)
+        }
+    }
+
+    // ---------------------------------------------------------------------------------------------
+    // Facade operations
+    // ---------------------------------------------------------------------------------------------
+
+    fun attach(item: DownloadItem, listener: IosDownloadListener) {
+        ensureSessions()
+        val id = item.id
+        listeners[id] = listener
+        tombstones.remove(id)
