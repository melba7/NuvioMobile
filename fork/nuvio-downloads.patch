+    actual fun applyNetworkPolicy(allowCellular: Boolean) {
+        // The first call only applies the stored setting; everything scheduled so far was scheduled under it.
+        val changed = networkPolicyApplied && pendingAllowCellular != allowCellular
+        networkPolicyApplied = true
+        pendingAllowCellular = allowCellular
+        downloadScheduler?.allowCellular = allowCellular
+        // The network constraint of a job is fixed when it is scheduled, so transfers that are already running (or
