+package com.nuvio.app.features.downloads
+
+import com.nuvio.app.core.storage.ProfileScopedKey
+import com.nuvio.app.features.downloads.core.DownloadStreamSelector
+import com.nuvio.app.features.downloads.core.StreamPreference
+import com.nuvio.app.features.downloads.core.StreamQualityParser
+import com.nuvio.app.features.streams.BingeGroupCacheRepository
+import com.nuvio.app.features.streams.StreamItem
+import com.nuvio.app.features.watchprogress.WatchProgressRepository
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.decodeFromString
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+
+@Serializable
+internal data class StoredStreamPreference(
+    val addonId: String,
+    val addonName: String,
+    val resolution: Int = 0,
+    val bingeGroup: String? = null,
+    val updatedAtEpochMs: Long = 0L,
+)
+
+/**
+ * "The stream the user last chose for this show". Three sources, newest wins:
+ * the stored download preference, the newest download of the show and the newest playback of the show.
+ * Main thread only.
+ */
+internal object DownloadStreamPreferences {
+    private const val storageKey = "download_stream_prefs"
+    private const val maxEntries = 200
+
+    private val json = Json {
+        ignoreUnknownKeys = true
+        encodeDefaults = true
+    }
+
+    private var cache: MutableMap<String, StoredStreamPreference>? = null
+
+    /** Remembers the stream of a download that starts (manual or automatic pick). */
+    fun record(parentMetaId: String, stream: StreamItem) {
+        val key = parentMetaId.trim()
+        if (key.isEmpty()) return
+        val entries = loadAll()
+        entries[key] = StoredStreamPreference(
+            addonId = stream.addonId,
+            addonName = stream.addonName,
+            resolution = StreamQualityParser.resolution(
+                listOfNotNull(
+                    stream.name,
+                    stream.description,
+                    stream.behaviorHints.filename,
+                    stream.clientResolve?.stream?.raw?.parsed?.resolution,
+                ).joinToString(" "),
+            ),
+            bingeGroup = stream.behaviorHints.bingeGroup,
+            updatedAtEpochMs = DownloadsClock.nowEpochMs(),
+        )
+        if (entries.size > maxEntries) {
+            entries.entries
+                .sortedBy { it.value.updatedAtEpochMs }
+                .take(entries.size - maxEntries)
+                .forEach { entries.remove(it.key) }
+        }
+        persist(entries)
+    }
+
+    fun preferenceFor(parentMetaId: String): StreamPreference? {
+        val key = parentMetaId.trim()
+        if (key.isEmpty()) return null
+
+        val stored = loadAll()[key]?.let {
+            StreamPreference(
+                addonId = it.addonId,
+                addonName = it.addonName,
+                resolution = it.resolution,
+                bingeGroup = it.bingeGroup,
+                updatedAtEpochMs = it.updatedAtEpochMs,
+            )
+        }
+
+        val fromDownloads = DownloadsRepository.uiState.value.items
+            .filter { item ->
+                item.parentMetaId.trim() == key &&
+                    item.status != DownloadStatus.Queued &&
+                    !item.providerAddonId.isNullOrBlank()
+            }
+            .maxByOrNull { it.createdAtEpochMs }
+            ?.let { item ->
+                StreamPreference(
+                    addonId = item.providerAddonId.orEmpty(),
+                    addonName = item.providerName,
+                    resolution = StreamQualityParser.resolution(
+                        "${item.streamTitle} ${item.streamSubtitle.orEmpty()} ${item.fileName}",
+                    ),
+                    bingeGroup = null,
+                    updatedAtEpochMs = item.createdAtEpochMs,
+                )
+            }
+
+        WatchProgressRepository.ensureLoaded()
+        val fromPlayback = WatchProgressRepository.uiState.value.entries
+            .filter { entry ->
+                entry.parentMetaId.trim() == key &&
+                    !entry.providerAddonId.isNullOrBlank() &&
+                    !entry.providerAddonId.startsWith("cloud:")
+            }
+            .maxByOrNull { it.lastUpdatedEpochMs }
+            ?.let { entry ->
+                StreamPreference(
+                    addonId = entry.providerAddonId.orEmpty(),
+                    addonName = entry.providerName.orEmpty(),
+                    resolution = StreamQualityParser.resolution(
+                        "${entry.lastStreamTitle.orEmpty()} ${entry.lastStreamSubtitle.orEmpty()}",
+                    ),
+                    bingeGroup = BingeGroupCacheRepository.get(key),
+                    updatedAtEpochMs = entry.lastUpdatedEpochMs,
+                )
+            }
+
+        return DownloadStreamSelector.resolvePreference(stored, fromDownloads, fromPlayback)
+    }
+
+    fun onProfileChanged() {
+        cache = null
+    }
+
+    private fun loadAll(): MutableMap<String, StoredStreamPreference> {
+        cache?.let { return it }
+        val payload = DownloadsStorage.loadValue(ProfileScopedKey.of(storageKey)).orEmpty().trim()
+        val decoded = if (payload.isEmpty()) {
+            emptyMap()
+        } else {
+            runCatching {
+                json.decodeFromString<Map<String, StoredStreamPreference>>(payload)
+            }.getOrDefault(emptyMap())
+        }
+        return decoded.toMutableMap().also { cache = it }
+    }
+
+    private fun persist(entries: Map<String, StoredStreamPreference>) {
+        DownloadsStorage.saveValue(
+            ProfileScopedKey.of(storageKey),
+            json.encodeToString(entries),
+        )
+    }
+}
