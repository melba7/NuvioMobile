+        var record = IosDownloadRecordStore.get(id)
+        if (record != null && item.sourceUrl.isNotBlank() && record.sourceUrl != item.sourceUrl) {
+            // A record of an earlier link of the same item: start over.
+            discardNative(id)
+            listeners[id] = listener // discardNative forgets the listener registered above
+            record = null
+        }
+
+        if (record == null) {
+            if (item.fileName.isBlank() || item.sourceUrl.isBlank()) {
+                deliverFailure(id, DlFailureKind.InvalidUrl, httpStatus = null, errorText = null)
+                return
+            }
+            val created = IosDownloadRecord(
+                downloadId = id,
+                fileName = item.fileName,
+                sourceUrl = item.sourceUrl,
+                requestHeaders = item.sourceHeaders,
+                allowCellular = allowCellular,
+                phase = IosDownloadPhase.RUNNING,
+                downloadedBytes = item.downloadedBytes.coerceAtLeast(0L),
+                totalBytes = item.totalBytes,
+            )
