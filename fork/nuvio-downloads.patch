+/** The download icon of one episode. Draws nothing when downloads are unavailable for it. */
+@Composable
+internal fun EpisodeDownloadButton(
+    video: MetaVideo,
+    onImage: Boolean,
+    modifier: Modifier = Modifier,
+) {
+    val controller = LocalDetailsDownloads.current ?: return
+    val season = video.season ?: return
+    val episode = video.episode ?: return
+    val key = downloadLogicalKey(controller.meta.id, season, episode)
+    val videoId = remember(controller, video) { controller.request(video).videoId }
+    val canStart = video.available &&
+        isEpisodeReleaseAired(video.released) != false &&
+        controller.canStream(videoId)
+    val episodeCode = stringResource(Res.string.compose_player_episode_code_full, season, episode)
+    val episodeTitle = video.title.takeIf { it.isNotBlank() }
+    DownloadControl(
+        controller = controller,
+        video = video,
+        key = key,
+        canStart = canStart,
+        subject = listOfNotNull(episodeCode, episodeTitle).joinToString(" "),
+        sheetTitle = episodeTitle ?: episodeCode,
+        onImage = onImage,
+        touchSize = 44.dp,
+        modifier = modifier,
+    )
+}
+
+/** True when [EpisodeDownloadButton] would draw something for this episode (used to reserve layout space). */
+@Composable
+internal fun rememberEpisodeDownloadAvailable(video: MetaVideo): Boolean {
+    val controller = LocalDetailsDownloads.current ?: return false
+    val season = video.season ?: return false
+    val episode = video.episode ?: return false
+    val key = downloadLogicalKey(controller.meta.id, season, episode)
+    val item by remember(key) { DownloadsRepository.observeItem(key) }
+        .collectAsStateWithLifecycle(initialValue = DownloadsRepository.itemForKey(key))
+    if (item != null) return true
+    val videoId = remember(controller, video) { controller.request(video).videoId }
+    return video.available &&
+        isEpisodeReleaseAired(video.released) != false &&
+        controller.canStream(videoId)
+}
+
+/**
+ * The movie download button next to Play. [size] is the diameter of the round button; [leadingGap] is emitted only
+ * when the button itself is drawn, so a hidden button leaves no gap in the action row.
+ */
+@Composable
+internal fun MovieDownloadButton(size: Dp, leadingGap: Dp = 0.dp) {
+    val controller = LocalDetailsDownloads.current ?: return
+    if (controller.isSeries) return
+    val key = downloadLogicalKey(controller.meta.id, null, null)
+    val canStart = controller.canStream(controller.meta.id)
+    val existing by remember(key) { DownloadsRepository.observeItem(key) }
+        .collectAsStateWithLifecycle(initialValue = DownloadsRepository.itemForKey(key))
+    // Nothing is drawn (not even the round button) when there is nothing to download and nothing downloaded.
+    if (existing == null && !canStart) return
+    if (leadingGap > 0.dp) Spacer(modifier = Modifier.width(leadingGap))
+    Surface(
+        shape = CircleShape,
+        color = backdropControlColor(MaterialTheme.colorScheme.surfaceVariant),
+        contentColor = MaterialTheme.colorScheme.onSurface,
+        tonalElevation = 6.dp,
+    ) {
+        Box(modifier = Modifier.size(size), contentAlignment = Alignment.Center) {
+            DownloadControl(
+                controller = controller,
+                video = null,
+                key = key,
+                canStart = canStart,
+                subject = controller.meta.name,
+                sheetTitle = controller.meta.name,
+                onImage = false,
+                touchSize = size,
+                modifier = Modifier,
+            )
+        }
+    }
+}
+
+@Composable
+private fun DownloadControl(
+    controller: DetailsDownloadController,
+    video: MetaVideo?,
+    key: String,
+    canStart: Boolean,
+    subject: String,
+    sheetTitle: String,
+    onImage: Boolean,
+    touchSize: Dp,
+    modifier: Modifier,
+) {
+    val item by remember(key) { DownloadsRepository.observeItem(key) }
+        .collectAsStateWithLifecycle(initialValue = DownloadsRepository.itemForKey(key))
+    val current = item
+    if (current == null && !canStart) return
+
+    val iconState = rememberDownloadIconState(current)
+    val progress = current.iconProgress()
+    val label = downloadStateLabel(iconState, progress, subject)
+    var sheetOpen by remember(key) { mutableStateOf(false) }
+    // Cancel/Delete removes the item while the sheet is closing. On Android the sheet's coroutine is cancelled with
+    // it, so onDismiss never runs and the next tap on the icon would queue a download and reopen the sheet.
+    if (current == null && sheetOpen) SideEffect { sheetOpen = false }
+
+    DownloadStateButton(
+        state = iconState,
+        progress = progress,
+        onImage = onImage,
+        label = label,
+        touchSize = touchSize,
+        modifier = modifier,
+        onClick = {
+            if (current == null) {
+                controller.requestDownload(video)
+            } else {
+                sheetOpen = true
+            }
+        },
+    )
+
+    if (sheetOpen && current != null) {
+        DownloadActionsSheet(
+            item = current,
+            title = sheetTitle,
+            onDismiss = { sheetOpen = false },
+            onPlay = { controller.play(video) },
+            onChooseSource = { controller.openSourcePicker(controller.request(video)) },
+        )
+    }
+}
