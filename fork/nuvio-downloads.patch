+            val request = buildRequest(record)
+            if (request == null) {
+                failRecord(record, DlFailureKind.InvalidUrl, httpStatus = null, errorText = null)
+                return
+            }
+            session.downloadTaskWithRequest(request)
+        }
+
+        task.taskDescription = id
+        if (delaySeconds > 0) {
+            task.earliestBeginDate = NSDate(
+                timeIntervalSinceReferenceDate = NSDate().timeIntervalSinceReferenceDate + delaySeconds.toDouble(),
+            )
+        }
+
+        liveTasks[id] = LiveTask(task, sessionIdentifierFor(record.allowCellular))
+        IosDownloadRecordStore.put(
+            record.copy(
+                phase = IosDownloadPhase.RUNNING,
+                migrating = false,
+                startedFromResumeData = resumeData != null,
+                failureKind = null,
+                httpStatus = null,
+                errorText = null,
+            ),
+        )
+        IosDownloadRecordStore.saveResumeData(id, null)
+        throttle.reset(id)
+        task.resume()
+    }
+
+    private fun buildRequest(record: IosDownloadRecord): NSMutableURLRequest? {
+        val url = NSURL.URLWithString(record.sourceUrl) ?: return null
+        val request = NSMutableURLRequest(
+            uRL = url,
+            cachePolicy = NSURLRequestReloadIgnoringLocalCacheData,
+            timeoutInterval = REQUEST_TIMEOUT_SECONDS,
+        )
+        request.setHTTPMethod("GET")
+        record.requestHeaders.forEach { (key, value) ->
+            request.setValue(value, forHTTPHeaderField = key)
+        }
+        return request
+    }
+
+    /** Cancels the task of [id] and asks for resume data. A stop already in flight is left alone. */
+    private fun stopLiveTask(id: String, restartAfter: Boolean) {
+        val live = liveTasks[id] ?: return
+        if (id in stops) {
+            if (restartAfter) stops[id]?.restartAfter = true
+            return
+        }
+        val stop = StopInFlight(serial = ++nextStopSerial, restartAfter = restartAfter)
+        stops[id] = stop
+        live.task.cancelByProducingResumeData { data ->
+            scope.launch { onResumeDataProduced(id, data) }
+        }
+        scope.launch {
+            delay(STOP_SAFETY_MS)
+            // Only the stop that was started here; a later pause of the same download has its own timer.
+            if (stops[id]?.serial == stop.serial) forceFinishStop(id)
+        }
+    }
+
+    private fun onResumeDataProduced(id: String, data: NSData?) {
+        val stop = stops[id]
+        if (stop == null) {
+            // The safety timer already finished this stop. The data is still good for a download that stays paused.
+            val record = IosDownloadRecordStore.get(id)
+            if (
+                data != null &&
+                record != null &&
+                id !in tombstones &&
+                record.phase == IosDownloadPhase.PAUSED &&
+                IosDownloadRecordStore.resumeData(id) == null
+            ) {
+                IosDownloadRecordStore.saveResumeData(id, data)
+            }
+            return
+        }
+        if (id in tombstones || IosDownloadRecordStore.get(id) == null) {
+            stops.remove(id)
+            return
+        }
+        // "No data" must not erase resume data that already arrived through the task error.
+        if (data != null) IosDownloadRecordStore.saveResumeData(id, data)
+        stop.resumeDataDone = true
+        finishStopIfReady(id)
+    }
+
+    private fun forceFinishStop(id: String) {
+        val stop = stops[id] ?: return
+        stop.resumeDataDone = true
+        stop.completionDone = true
+        finishStopIfReady(id)
+    }
+
+    private fun finishStopIfReady(id: String) {
+        val stop = stops[id] ?: return
+        if (!stop.resumeDataDone || !stop.completionDone) return
+        stops.remove(id)
+
+        val record = IosDownloadRecordStore.get(id) ?: return
+        if (id in tombstones || record.phase == IosDownloadPhase.COMPLETED) return
+        if (stop.restartAfter || record.migrating) {
+            val updated = record.copy(
+                migrating = false,
+                phase = IosDownloadPhase.RUNNING,
+                pauseRequested = false,
+                allowCellular = allowCellular,
+            )
+            IosDownloadRecordStore.put(updated)
+            startTask(updated)
+        }
+    }
+
+    /** Forgets everything about [id]: task, stop, outcome, record, resume data. Does not touch files. */
+    private fun discardNative(id: String) {
+        liveTasks.remove(id)?.task?.cancel()
+        stops.remove(id)
+        pendingOutcomes.remove(id)
+        listeners.remove(id)
+        madeProgress.remove(id)
+        throttle.reset(id)
+        IosDownloadRecordStore.remove(id)
+    }
+
+    // ---------------------------------------------------------------------------------------------
+    // Delegate entry points
+    // ---------------------------------------------------------------------------------------------
+
+    internal fun onProgress(sessionIdentifier: String, task: NSURLSessionDownloadTask, written: Long, expected: Long) {
+        val id = task.taskDescription ?: return
+        val live = liveTasks[id]
+        if (live != null && !live.matches(task, sessionIdentifier)) return
+        if (written > 0L) madeProgress += id
+        val listener = listeners[id] ?: return
+        if (IosDownloadRecordStore.get(id)?.phase != IosDownloadPhase.RUNNING) return
+        val total = expected.takeIf { it > 0L }
+        if (throttle.shouldEmit(id, DownloadsClock.nowEpochMs(), written, total)) {
+            listener.onProgress(written.coerceAtLeast(0L), total)
+        }
+    }
+
+    /** Runs synchronously: the file at [location] is deleted by the system when this method returns. */
+    internal fun onFileReady(sessionIdentifier: String, task: NSURLSessionDownloadTask, location: NSURL) {
+        val id = task.taskDescription ?: return
+        if (id in tombstones) return
+        val record = IosDownloadRecordStore.get(id) ?: return
+        val live = liveTasks[id]
+        if (live != null && !live.matches(task, sessionIdentifier)) return
+
+        // A download task "succeeds" with the error body as its file for 4xx and 5xx answers.
+        val status = (task.response as? NSHTTPURLResponse)?.statusCode?.toInt() ?: 200
+        if (status !in 200..299) {
+            pendingOutcomes[id] = FileOutcome.Http(status)
+            return
+        }
+
+        val destination = destinationPath(record.fileName)
+        removePathIfExists(destination)
+        val source = location.path
+        val moved = source != null && NSFileManager.defaultManager.moveItemAtPath(
+            srcPath = source,
+            toPath = destination,
+            error = null,
+        )
+        pendingOutcomes[id] = if (moved) {
+            FileOutcome.Success(fileUriFor(destination), fileSizeOrNull(destination))
+        } else {
+            FileOutcome.MoveFailed
+        }
+    }
+
+    internal fun onTaskCompleted(sessionIdentifier: String, task: NSURLSessionTask, error: NSError?) {
+        val id = task.taskDescription ?: return
+        val live = liveTasks[id]
+        if (live != null) {
+            // The completion of a task that was replaced meanwhile must not touch the new one.
+            if (!live.matches(task, sessionIdentifier)) return
+            liveTasks.remove(id)
+        }
+        if (id in tombstones) {
+            pendingOutcomes.remove(id)
+            stops.remove(id)
+            return
+        }
+        var record = IosDownloadRecordStore.get(id)
+        if (record == null) {
+            pendingOutcomes.remove(id)
+            stops.remove(id)
+            return
+        }
+        if (record.phase == IosDownloadPhase.COMPLETED || record.phase == IosDownloadPhase.FAILED) {
+            // A task that was cancelled because its record is already final reports -999 later; do not restart it.
+            pendingOutcomes.remove(id)
+            stops.remove(id)
+            return
+        }
+        if (madeProgress.remove(id) && (record.autoRetries != 0)) {
+            record = record.copy(autoRetries = 0)
+            IosDownloadRecordStore.put(record)
+        }
+
+        if (error == null) {
+            onTaskSucceeded(record)
+        } else {
+            onTaskFailed(record, error)
+        }
+    }
+
+    private fun onTaskSucceeded(record: IosDownloadRecord) {
+        val id = record.downloadId
+        stops.remove(id)
+        when (val outcome = pendingOutcomes.remove(id)) {
+            is FileOutcome.Success -> markCompleted(record, outcome)
+            is FileOutcome.Http -> applyDecision(
+                record = record,
+                decision = TransferErrorPolicy.decideHttp(
+                    status = outcome.status,
+                    startedFromResumeData = record.startedFromResumeData,
+                    autoRetries = record.autoRetries,
+                    freshRestarts = record.freshRestarts,
+                ),
+                httpStatus = outcome.status,
+                errorText = null,
+            )
+            else -> failRecord(record, DlFailureKind.Storage, httpStatus = null, errorText = FINALIZE_FAILED_MARKER)
+        }
+    }
+
+    private fun onTaskFailed(record: IosDownloadRecord, error: NSError) {
+        val id = record.downloadId
+        val userInfo = error.userInfo
+        val resumeData = userInfo["NSURLSessionDownloadTaskResumeData"] as? NSData
+        val stop = stops[id]
+        if (resumeData != null && IosDownloadRecordStore.resumeData(id) == null) {
+            IosDownloadRecordStore.saveResumeData(id, resumeData)
+        }
+        val cancelReason = userInfo["NSURLErrorBackgroundTaskCancelledReasonKey"].asIntOrNull()
+
+        val decision = TransferErrorPolicy.decide(
+            TransferErrorInput(
+                // NSErrorDomain is a typedef of NSString and may be bound as String? or String.
+                domain = error.domain.orEmpty(),
+                code = error.code,
+                hasResumeData = IosDownloadRecordStore.resumeData(id) != null,
+                cancelReason = cancelReason,
+                pauseRequested = record.pauseRequested,
+                removed = false,
+                migrating = record.migrating,
+                startedFromResumeData = record.startedFromResumeData,
+                autoRetries = record.autoRetries,
+                freshRestarts = record.freshRestarts,
+            ),
+        )
+
+        if (stop != null) {
+            if (decision.action != TransferErrorAction.Fail) {
+                stop.completionDone = true
+                finishStopIfReady(id)
+                return
+            }
+            stops.remove(id)
+        }
+
+        applyDecision(
+            record = record,
+            decision = decision,
+            httpStatus = null,
+            errorText = error.localizedDescription,
+        )
+    }
+
+    private fun applyDecision(
+        record: IosDownloadRecord,
+        decision: TransferErrorDecision,
+        httpStatus: Int?,
+        errorText: String?,
+    ) {
+        val id = record.downloadId
+        when (decision.action) {
+            TransferErrorAction.Ignore -> Unit
+
+            TransferErrorAction.MarkPaused -> {
+                if (decision.failureKind == DlFailureKind.BackgroundRefreshOff) {
+                    // The user has to act (Settings), so this is surfaced as a failure with an explanation.
+                    failRecord(record, DlFailureKind.BackgroundRefreshOff, httpStatus = null, errorText = errorText)
+                } else {
+                    IosDownloadRecordStore.put(record.copy(phase = IosDownloadPhase.PAUSED, failureKind = null))
+                    deliver(id) { it.onPaused() }
+                }
+            }
+
+            TransferErrorAction.RestartWithResumeData -> {
+                if (staysPaused(record)) return
+                val next = record.copy(autoRetries = record.autoRetries + 1)
+                IosDownloadRecordStore.put(next)
+                startTask(next, decision.retryDelaySeconds)
+            }
+
+            TransferErrorAction.RestartFresh -> {
+                IosDownloadRecordStore.saveResumeData(id, null)
+                if (staysPaused(record)) return
+                val next = if (record.startedFromResumeData) {
+                    record.copy(freshRestarts = record.freshRestarts + 1, startedFromResumeData = false)
+                } else {
+                    record.copy(autoRetries = record.autoRetries + 1)
+                }
+                IosDownloadRecordStore.put(next)
+                startTask(next, decision.retryDelaySeconds)
+            }
+
+            TransferErrorAction.Fail ->
+                failRecord(
+                    record = record,
+                    kind = decision.failureKind ?: DlFailureKind.Unknown,
+                    httpStatus = httpStatus,
+                    errorText = errorText,
+                )
+        }
+    }
+
+    /** The user paused while the transfer ended on its own: do not restart behind the user's back. */
+    private fun staysPaused(record: IosDownloadRecord): Boolean {
+        if (!record.pauseRequested || record.migrating) return false
+        deliver(record.downloadId) { it.onPaused() }
+        return true
+    }
+
+    private fun markCompleted(record: IosDownloadRecord, outcome: FileOutcome.Success) {
+        val id = record.downloadId
+        val size = outcome.bytes ?: record.totalBytes ?: record.downloadedBytes
+        IosDownloadRecordStore.put(
+            record.copy(
+                phase = IosDownloadPhase.COMPLETED,
+                downloadedBytes = size,
+                totalBytes = size.takeIf { it > 0L },
+                failureKind = null,
+                httpStatus = null,
+                errorText = null,
+                migrating = false,
+            ),
+        )
+        IosDownloadRecordStore.saveResumeData(id, null)
+        throttle.reset(id)
+
+        // A pause that raced the completion leaves the record in place; the next resume reports the success.
+        if (record.pauseRequested) return
+        val listener = listeners[id] ?: return
+        scope.launch {
+            if (listeners[id] !== listener) return@launch
+            listener.onSuccess(outcome.localFileUri, size.takeIf { it > 0L })
+            // The completed record stays: the repository may have ignored the result (other profile active, the
+            // item was paused meanwhile). restore() or the next attach() reconciles it, restore() and
+            // remove(fileName) delete it.
+        }
+    }
+
+    private fun failRecord(
+        record: IosDownloadRecord,
+        kind: DlFailureKind,
+        httpStatus: Int?,
+        errorText: String?,
+    ) {
+        val id = record.downloadId
+        IosDownloadRecordStore.put(
+            record.copy(
+                phase = IosDownloadPhase.FAILED,
+                failureKind = kind.name,
+                httpStatus = httpStatus,
+                errorText = errorText,
+                pauseRequested = false,
+                migrating = false,
+            ),
+        )
+        deliverFailure(id, kind, httpStatus, errorText)
+    }
+
+    private fun deliverFailure(id: String, kind: DlFailureKind, httpStatus: Int?, errorText: String?) {
+        deliver(id) { listener ->
+            listener.onFailure(
+                DownloadTransferFailure(
+                    message = failureMessage(kind.name, httpStatus, errorText),
+                    kind = kind,
+                    httpStatus = httpStatus,
+                ),
+            )
+        }
+    }
+
+    /** A completed record that nobody was listening to; reported once an app-level listener shows up. */
+    private fun deliverStoredCompletion(record: IosDownloadRecord) {
+        val id = record.downloadId
+        val path = destinationPath(record.fileName)
+        if (!NSFileManager.defaultManager.fileExistsAtPath(path)) {
+            failRecord(record, DlFailureKind.Storage, httpStatus = null, errorText = null)
+            return
+        }
+        val size = fileSizeOrNull(path) ?: record.totalBytes ?: record.downloadedBytes
+        val uri = fileUriFor(path)
+        // The record stays (see markCompleted); the delivery is idempotent for the repository.
+        deliver(id) { listener -> listener.onSuccess(uri, size.takeIf { it > 0L }) }
+    }
+
+    /** Never runs [block] inside the caller: terminal callbacks must not fire before `start()` has returned. */
+    private fun deliver(id: String, block: (IosDownloadListener) -> Unit) {
+        val listener = listeners[id] ?: return
+        scope.launch {
+            if (listeners[id] === listener) block(listener)
+        }
+    }
+
+    internal fun onSessionEventsFinished(identifier: String?) {
+        if (identifier == null) return
+        val handler = completionHandlers.remove(identifier)
+        if (handler != null) {
+            handler()
+        } else {
+            finishedWithoutHandler[identifier] = DownloadsClock.nowEpochMs()
+        }
+    }
+
+    // ---------------------------------------------------------------------------------------------
+    // Messages
+    // ---------------------------------------------------------------------------------------------
+
+    private fun failureMessage(kindName: String?, httpStatus: Int?, errorText: String?): String {
+        if (errorText == FINALIZE_FAILED_MARKER) {
+            return blockingString { getString(Res.string.downloads_error_finalize_file_failed) }
+        }
+        val kind = kindName?.let { name -> DlFailureKind.entries.firstOrNull { it.name == name } }
+        return when (kind) {
+            DlFailureKind.Http, DlFailureKind.LinkExpired ->
+                if (httpStatus != null) {
+                    blockingString { getString(Res.string.network_request_failed_http, httpStatus) }
+                } else {
+                    errorText?.takeIf { it.isNotBlank() } ?: blockingString { getString(Res.string.download_failed) }
+                }
+            DlFailureKind.Storage -> blockingString { getString(Res.string.downloads_error_storage_full) }
+            DlFailureKind.BackgroundRefreshOff ->
+                blockingString { getString(Res.string.downloads_error_background_refresh_off) }
+            DlFailureKind.InvalidUrl -> blockingString { getString(Res.string.downloads_error_invalid_url) }
+            else -> errorText?.takeIf { it.isNotBlank() } ?: blockingString { getString(Res.string.download_failed) }
+        }
+    }
+
+    private fun blockingString(block: suspend () -> String): String = runBlocking { block() }
+}
+
+@OptIn(ExperimentalForeignApi::class, BetaInteropApi::class)
+private class IosBackgroundDownloadDelegate : NSObject(), NSURLSessionDownloadDelegateProtocol {
+    override fun URLSession(
+        session: NSURLSession,
+        downloadTask: NSURLSessionDownloadTask,
+        didFinishDownloadingToURL: NSURL,
+    ) {
+        IosBackgroundDownloads.onFileReady(session.identifierOrEmpty(), downloadTask, didFinishDownloadingToURL)
+    }
+
+    override fun URLSession(
+        session: NSURLSession,
+        downloadTask: NSURLSessionDownloadTask,
+        didWriteData: Long,
+        totalBytesWritten: Long,
+        totalBytesExpectedToWrite: Long,
+    ) {
+        IosBackgroundDownloads.onProgress(
+            session.identifierOrEmpty(),
+            downloadTask,
+            totalBytesWritten,
+            totalBytesExpectedToWrite,
+        )
+    }
+
+    override fun URLSession(
+        session: NSURLSession,
+        downloadTask: NSURLSessionDownloadTask,
+        didResumeAtOffset: Long,
+        expectedTotalBytes: Long,
+    ) {
+        IosBackgroundDownloads.onProgress(
+            session.identifierOrEmpty(),
+            downloadTask,
+            didResumeAtOffset,
+            expectedTotalBytes,
+        )
+    }
+
+    override fun URLSession(
+        session: NSURLSession,
+        task: NSURLSessionTask,
+        didCompleteWithError: NSError?,
+    ) {
+        IosBackgroundDownloads.onTaskCompleted(session.identifierOrEmpty(), task, didCompleteWithError)
+    }
+
+    override fun URLSessionDidFinishEventsForBackgroundURLSession(session: NSURLSession) {
+        IosBackgroundDownloads.onSessionEventsFinished(session.configuration.identifier)
+    }
+}
+
+@OptIn(ExperimentalForeignApi::class)
+private fun NSURLSession.identifierOrEmpty(): String = configuration.identifier.orEmpty()
+
+internal fun destinationPath(fileName: String): String = "${downloadsDirectoryPath()}/$fileName"
+
+internal fun fileUriFor(path: String): String = NSURL.fileURLWithPath(path).absoluteString ?: "file://$path"
+
+/** Accepts every shape an `NSNumber` can arrive in through Kotlin/Native's bridging. */
+internal fun Any?.asIntOrNull(): Int? = this.asLongOrNull()?.toInt()
