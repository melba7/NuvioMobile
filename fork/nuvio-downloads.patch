+            when (record.phase) {
+                IosDownloadPhase.RUNNING -> {
+                    liveTasks[id] = LiveTask(task, identifier)
+                    listeners[id]?.onProgress(
+                        task.countOfBytesReceived.coerceAtLeast(0L),
+                        task.countOfBytesExpectedToReceive.takeIf { it > 0L },
+                    )
