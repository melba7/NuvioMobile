+internal fun DownloadStatus.toDlState(): DlState = when (this) {
+    DownloadStatus.Queued -> DlState.Queued
+    DownloadStatus.Downloading -> DlState.Downloading
+    DownloadStatus.Paused -> DlState.Paused
+    DownloadStatus.Completed -> DlState.Completed
+    DownloadStatus.Failed -> DlState.Failed
+}
+
+internal fun DlState.toDownloadStatus(): DownloadStatus = when (this) {
+    DlState.Queued -> DownloadStatus.Queued
+    DlState.Downloading -> DownloadStatus.Downloading
+    DlState.Paused -> DownloadStatus.Paused
+    DlState.Completed -> DownloadStatus.Completed
+    DlState.Failed -> DownloadStatus.Failed
+}
+
+internal fun DownloadOrigin.toDlOrigin(): DlOrigin = when (this) {
+    DownloadOrigin.User -> DlOrigin.User
+    DownloadOrigin.Season -> DlOrigin.Season
+    DownloadOrigin.Smart -> DlOrigin.Smart
+}
+
+internal fun DlOrigin.toDownloadOrigin(): DownloadOrigin = when (this) {
+    DlOrigin.User -> DownloadOrigin.User
+    DlOrigin.Season -> DownloadOrigin.Season
+    DlOrigin.Smart -> DownloadOrigin.Smart
+}
+
+internal fun DownloadItem.dlContext(): DlContext =
+    DlContext(
+        origin = origin.toDlOrigin(),
+        autoSelected = autoSelected,
+        resolveAttempts = resolveAttempts,
+        hasSourceUrl = sourceUrl.isNotBlank(),
+        failureKind = failureKind?.let { name -> DlFailureKind.entries.firstOrNull { it.name == name } },
+    )
+
+/**
+ * A queued item that already had a transfer (expired link, retry): `requeueItem` keeps its stream info on purpose,
+ * while a fresh request starts with none (`enqueueQueued` clears it).
+ */
+internal val DownloadItem.hadTransfer: Boolean
+    get() = !providerAddonId.isNullOrBlank() || providerName.isNotBlank() || streamTitle.isNotBlank()
+
+internal fun DownloadItem.toStorageEntry(): StorageEntry =
+    StorageEntry(
+        completed = status == DownloadStatus.Completed,
+        downloadedBytes = downloadedBytes,
+        totalBytes = totalBytes,
+    )
+
+internal fun DownloadItem.toRequest(): DownloadRequest =
+    DownloadRequest(
+        contentType = contentType,
+        videoId = videoId,
+        parentMetaId = parentMetaId,
+        parentMetaType = parentMetaType,
+        title = title,
+        logo = logo,
+        poster = poster,
+        background = background,
+        seasonNumber = seasonNumber,
+        episodeNumber = episodeNumber,
+        episodeTitle = episodeTitle,
+        episodeThumbnail = episodeThumbnail,
+        origin = origin,
+        smartReplacesItemId = smartReplacesItemId,
+    )
