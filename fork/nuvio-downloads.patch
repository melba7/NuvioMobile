+}
+
+/**
+ * App-wide download coordinator: turns queued requests into transfers (stream selection), and runs Smart Downloads.
+ * Everything runs on the main thread; the scope is `Dispatchers.Main`. The `init` block must not touch
+ * [DownloadsRepository] (the repository starts the orchestrator while it is loading).
+ */
+object DownloadsOrchestrator {
+    private const val STREAM_FETCH_TIMEOUT_MS = 30_000L
+    private const val SMART_RETRY_DELAY_MS = 1_500L
+    private const val SMART_PENDING_MAX_AGE_MS = 7L * 24L * 60L * 60L * 1000L
+    private const val SEASON_BATCH_MAX_AGE_MS = 10L * 60L * 1000L
+    private const val MAX_CLAIMED_EVENTS = 64
+    private const val SMART_PENDING_KEY = "download_smart_pending"
+
+    private val log = Logger.withTag("DownloadsOrchestrator")
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Main)
+    private val json = Json {
+        ignoreUnknownKeys = true
+        encodeDefaults = true
+    }
+
+    private val _events = MutableSharedFlow<DownloadUiEvent>(extraBufferCapacity = 16)
+    val events: SharedFlow<DownloadUiEvent> = _events.asSharedFlow()
+
+    private val resolverKicks = Channel<Unit>(Channel.CONFLATED)
+    private var started = false
+    private var nextEventId = 0L
+    private val claimedEvents = ArrayDeque<Long>()
+
+    // Smart Downloads
+    private val activePlayback = mutableMapOf<String, Int>()
+    private var smartPending: MutableList<SmartPending> = mutableListOf()
+    private var smartPendingLoaded = false
+    private var smartJob: Job? = null
+    private var smartRunning = false
+    private var smartDirty = false
+
+    // Season downloads
+    private class SeasonBatch(
+        val parentMetaId: String,
+        val requests: List<DownloadRequest>,
+        val pending: MutableSet<String>,
+        var failed: Int = 0,
+    )
+
+    private class PendingSeasonBatch(
+        val parentMetaId: String,
+        val requests: List<DownloadRequest>,
+        val createdAtEpochMs: Long,
+    )
+
+    private val seasonBatches = mutableListOf<SeasonBatch>()
+    private var pendingSeasonBatch: PendingSeasonBatch? = null
+
+    // ---------------------------------------------------------------------------------------------
+    // Lifecycle
+    // ---------------------------------------------------------------------------------------------
+
+    /** Idempotent: starts the resolver loop and the collectors on network and settings. */
+    fun ensureStarted() {
+        if (started) return
+        started = true
+        DownloadSettingsRepository.ensureLoaded()
+        DownloadsNetworkMonitor.ensureStarted()
+        loadSmartPending()
+        scope.launch { runResolverLoop() }
+        scope.launch {
+            DownloadsNetworkMonitor.state.collect {
+                kickResolver()
+                scheduleSmart(0L)
+            }
+        }
+        scope.launch {
+            DownloadSettingsRepository.state.collect {
+                kickResolver()
+                scheduleSmart(0L)
+            }
+        }
+        scheduleSmart(0L)
+    }
+
+    fun kickResolver() {
+        resolverKicks.trySend(Unit)
+    }
+
+    /** True only for the first caller of an event id, so that two visible screens do not both react. */
+    fun claim(eventId: Long): Boolean {
+        if (eventId in claimedEvents) return false
+        claimedEvents.addLast(eventId)
+        while (claimedEvents.size > MAX_CLAIMED_EVENTS) claimedEvents.removeFirst()
+        return true
+    }
+
+    fun onProfileChanged() {
+        loadSmartPending()
+        pendingSeasonBatch = null
+        seasonBatches.clear()
+        kickResolver()
+        scheduleSmart(0L)
+    }
+
+    fun onAllDeleted() {
+        clearPendingSmart()
+        pendingSeasonBatch = null
+        seasonBatches.clear()
+    }
+
+    /** The user cancelled or deleted a season: forget its batches so nothing is queued again behind their back. */
+    fun onSeasonCancelled(parentMetaId: String) {
+        val parent = parentMetaId.trim()
+        seasonBatches.removeAll { it.parentMetaId.trim() == parent }
+        if (pendingSeasonBatch?.parentMetaId?.trim() == parent) pendingSeasonBatch = null
+    }
+
+    fun clearPendingSmart() {
+        ensureSmartPendingLoaded()
+        if (smartPending.isNotEmpty()) {
+            smartPending.clear()
+            saveSmartPending()
+        }
+    }
+
+    // ---------------------------------------------------------------------------------------------
+    // Requests
+    // ---------------------------------------------------------------------------------------------
+
+    fun requestDownload(request: DownloadRequest): DownloadEnqueueResult {
+        DownloadsRepository.ensureLoaded()
+        ensureStarted()
+        return DownloadsRepository.enqueueQueued(request)
+    }
+
+    /**
+     * Queues every released, not yet downloaded episode of [requests] (one season). Returns how many were queued.
+     * [parentMetaId] and [seasonNumber] only describe the batch.
+     */
+    fun requestSeason(parentMetaId: String, seasonNumber: Int, requests: List<DownloadRequest>): Int {
+        DownloadsRepository.ensureLoaded()
+        ensureStarted()
+        val seasonRequests = requests.filter { it.seasonNumber == seasonNumber && it.episodeNumber != null }
+        val plan = SeasonDownloadPlanner.plan(
+            seasonRequests.map { request ->
+                PlannerEpisode(
+                    season = seasonNumber,
+                    episode = request.episodeNumber ?: 0,
+                    released = true,
+                    download = DownloadsRepository.itemForKey(request.logicalKey)?.status?.toDlState(),
+                )
+            },
+        )
+        val byEpisode = seasonRequests.associateBy { it.episodeNumber }
+        val queuedRequests = mutableListOf<DownloadRequest>()
+        for (episode in plan.toQueue) {
+            val request = byEpisode[episode.episode]?.copy(origin = DownloadOrigin.Season) ?: continue
+            if (DownloadsRepository.enqueueQueued(request) == DownloadEnqueueResult.Queued) {
+                queuedRequests += request
+            }
+        }
+        trackSeasonBatch(parentMetaId, queuedRequests)
+        return queuedRequests.size
+    }
+
+    /** A manual pick from the stream list. Also continues a season download that was waiting for a first choice. */
+    fun enqueueManual(
+        contentType: String,
+        videoId: String,
+        parentMetaId: String,
+        parentMetaType: String,
+        title: String,
+        logo: String?,
+        poster: String?,
+        background: String?,
+        seasonNumber: Int?,
+        episodeNumber: Int?,
+        episodeTitle: String?,
+        episodeThumbnail: String?,
+        stream: StreamItem,
+    ): DownloadEnqueueResult {
+        ensureStarted()
+        val result = DownloadsRepository.enqueueFromStream(
+            contentType = contentType,
+            videoId = videoId,
+            parentMetaId = parentMetaId,
+            parentMetaType = parentMetaType,
+            title = title,
+            logo = logo,
+            poster = poster,
+            background = background,
+            seasonNumber = seasonNumber,
+            episodeNumber = episodeNumber,
+            episodeTitle = episodeTitle,
+            episodeThumbnail = episodeThumbnail,
+            stream = stream,
+        )
+        if (result == DownloadEnqueueResult.Started || result == DownloadEnqueueResult.Replaced) {
+            resumeSeasonBatchAfterManualPick(
+                parentMetaId = parentMetaId,
+                manualKey = downloadLogicalKey(parentMetaId, seasonNumber, episodeNumber),
+            )
+        }
+        return result
+    }
+
+    // ---------------------------------------------------------------------------------------------
+    // Playback hooks (Smart Downloads). Called from the player / watch progress, possibly off the main thread.
+    // ---------------------------------------------------------------------------------------------
+
+    fun onPlaybackActive(videoId: String) {
+        scope.launch {
+            activePlayback[videoId] = (activePlayback[videoId] ?: 0) + 1
+        }
+    }
+
+    fun onPlaybackInactive(videoId: String) {
+        scope.launch {
+            val count = (activePlayback[videoId] ?: 0) - 1
+            if (count > 0) activePlayback[videoId] = count else activePlayback.remove(videoId)
+            scheduleSmart(SMART_RETRY_DELAY_MS)
+        }
+    }
+
+    fun isPlaybackActive(videoId: String): Boolean = (activePlayback[videoId] ?: 0) > 0
+
+    /**
+     * Re-checked right before every automatic delete, which can happen long after the playback that reported the
+     * episode as finished (the fetch waits for Wi-Fi). False when the watch history now holds an unfinished entry
+     * for this episode, i.e. it is being watched again. No entry (or an unreadable history) leaves the earlier
+     * "finished" report standing.
+     */
+    internal fun isStillWatched(item: DownloadItem): Boolean {
+        val entry = runCatching {
+            WatchProgressRepository.progressForVideo(
+                videoId = item.videoId,
+                seasonNumber = item.seasonNumber,
+                episodeNumber = item.episodeNumber,
+            )
+        }.getOrNull() ?: return true
+        return entry.isEffectivelyCompleted
+    }
+
+    /** Cheap and idempotent: called on every progress write of a finished episode. */
+    fun onEpisodePlaybackCompleted(
+        parentMetaId: String,
+        videoId: String,
+        seasonNumber: Int,
+        episodeNumber: Int,
+    ) {
+        scope.launch {
+            DownloadSettingsRepository.ensureLoaded()
+            if (!DownloadSettingsRepository.state.value.smartDownloads) return@launch
+            val item = DownloadsRepository.findCompletedDownload(
+                videoId = videoId,
+                parentMetaId = parentMetaId,
+                seasonNumber = seasonNumber,
+                episodeNumber = episodeNumber,
+            ) ?: return@launch
+            // Downloads that existed before Smart Downloads are never touched.
+            if (!item.smartEligible) return@launch
+            ensureStarted()
+            ensureSmartPendingLoaded()
+            val key = item.logicalContentKey
+            if (smartPending.none { it.logicalKey == key }) {
+                smartPending += SmartPending(
+                    parentMetaId = item.parentMetaId,
+                    parentMetaType = item.parentMetaType,
+                    videoId = videoId,
+                    seasonNumber = seasonNumber,
+                    episodeNumber = episodeNumber,
+                    createdAtEpochMs = DownloadsClock.nowEpochMs(),
+                )
+                saveSmartPending()
+            }
+            if (!isPlaybackActive(videoId) && !isPlaybackActive(item.videoId)) {
+                scheduleSmart(SMART_RETRY_DELAY_MS)
+            }
+        }
+    }
+
+    // ---------------------------------------------------------------------------------------------
+    // Resolver
+    // ---------------------------------------------------------------------------------------------
+
+    private suspend fun runResolverLoop() {
+        for (kick in resolverKicks) {
+            while (true) {
+                val progressed = try {
+                    resolveNext()
+                } catch (error: Throwable) {
+                    // Only a cancellation of this loop itself ends it. A CancellationException that comes out of a
+                    // callee (a cancelled or timed out request) must not stop every later download from resolving.
+                    if (error is CancellationException) currentCoroutineContext().ensureActive()
+                    log.w(error) { "Download resolver failed" }
+                    false
+                }
+                if (!progressed) break
+            }
+        }
+    }
+
+    /** Resolves the oldest queued item. Returns true when an item was handled (so the loop continues). */
+    private suspend fun resolveNext(): Boolean {
+        val item = DownloadsRepository.nextQueuedItem() ?: return false
+        if (!DownloadNetworkGate.canResolve(DownloadsNetworkMonitor.state.value)) return false
+
+        val preference = DownloadStreamPreferences.preferenceFor(item.parentMetaId)
+        if (preference == null) {
+            noMatch(item, StreamSelectionFailure.NoPreference)
+            return true
+        }
+
+        try {
+            PlayerStreamsRepository.loadDownloadStreams(
+                type = item.contentType,
+                videoId = item.videoId,
+                season = item.seasonNumber,
+                episode = item.episodeNumber,
+                forceRefresh = true,
+            )
+            val state = withTimeoutOrNull(STREAM_FETCH_TIMEOUT_MS) {
+                PlayerStreamsRepository.downloadStreamsState.first { it.settledFor(preference) }
+            } ?: PlayerStreamsRepository.downloadStreamsState.value
+
+            if (!isStillQueued(item.id)) return true
+
+            val streams = state.groups.flatMap { it.streams }
+            val candidates = streams.mapIndexed { index, stream ->
+                StreamCandidate(
+                    index = index,
+                    addonId = stream.addonId,
+                    addonName = stream.addonName,
+                    name = stream.name,
+                    // Same texts as DownloadStreamPreferences.record(), so the stored resolution and the candidates agree.
+                    description = listOfNotNull(
+                        stream.description,
+                        stream.clientResolve?.stream?.raw?.parsed?.resolution,
+                    ).joinToString(" ").takeIf { it.isNotBlank() },
+                    filename = stream.behaviorHints.filename,
+                    bingeGroup = stream.behaviorHints.bingeGroup,
+                    directUrl = stream.playableDirectUrl,
+                    resolvable = DirectDebridPlaybackResolver.shouldResolveToPlayableStream(stream),
+                )
+            }
+            val selection = DownloadStreamSelector.select(candidates, preference)
+
+            for (pick in selection.picks) {
+                val stream = streams.getOrNull(pick.index) ?: continue
+                val resolved = if (pick.resolvable) {
+                    (DirectDebridPlaybackResolver.resolveToPlayableStream(
+                        stream = stream,
+                        season = item.seasonNumber,
+                        episode = item.episodeNumber,
+                    ) as? DirectDebridPlayableResult.Success)?.stream
+                } else {
+                    stream
+                }
+                if (!isStillQueued(item.id)) return true
+                if (
+                    resolved != null &&
+                    DownloadUrlRules.isSupported(resolved.playableDirectUrl) &&
+                    DownloadsRepository.attachResolvedStream(item.id, resolved, autoSelected = true)
+                ) {
+                    onSeasonItemSettled(item, success = true)
+                    return true
+                }
+            }
+
+            noMatch(item, selection.failure ?: StreamSelectionFailure.NoDownloadableStream)
+            return true
+        } catch (error: Throwable) {
+            // See runResolverLoop: a callee's CancellationException is an ordinary failure of this one item.
+            if (error is CancellationException) currentCoroutineContext().ensureActive()
+            log.w(error) { "Could not resolve a stream for ${item.logicalContentKey}" }
+            if (isStillQueued(item.id)) noMatch(item, StreamSelectionFailure.NoDownloadableStream)
+            return true
+        } finally {
+            // Only the preferred add-on was awaited; stop whatever is still loading.
+            PlayerStreamsRepository.clearDownloadStreams()
+        }
+    }
+
+    private fun isStillQueued(downloadId: String): Boolean =
+        DownloadsRepository.itemById(downloadId)?.status == DownloadStatus.Queued
+
+    private fun StreamsUiState.settledFor(preference: StreamPreference): Boolean =
+        emptyStateReason != null ||
+            (
+                groups.isNotEmpty() &&
+                    (!isAnyLoading || groups.any { it.addonId == preference.addonId && !it.isLoading })
+                )
+
+    /**
+     * State machine row 4 followed by the fallback of the item's origin. An item that already had a transfer (its
+     * link expired and it was queued again) is not removed: row 17 keeps it as a failed item the user can retry.
+     */
+    private suspend fun noMatch(item: DownloadItem, reason: StreamSelectionFailure) {
+        if (item.hadTransfer) {
+            DownloadsRepository.failQueued(item.id, getString(Res.string.download_failed))
+            onSeasonItemSettled(item, success = false)
+            return
+        }
+        val request = item.toRequest()
+        DownloadsRepository.removeQueued(item.id)
+
+        when (item.origin) {
+            DownloadOrigin.User -> requestManualSelection(request, reason)
+            DownloadOrigin.Season -> handleSeasonNoMatch(item, request, reason)
+            DownloadOrigin.Smart -> Unit
+        }
+    }
+
+    private suspend fun requestManualSelection(request: DownloadRequest, reason: StreamSelectionFailure) {
+        _events.tryEmit(DownloadUiEvent.NeedsManualSelection(++nextEventId, request, reason))
+        NuvioToastController.show(getString(Res.string.downloads_auto_select_failed))
+    }
+
+    private suspend fun handleSeasonNoMatch(
+        item: DownloadItem,
+        request: DownloadRequest,
+        reason: StreamSelectionFailure,
+    ) {
+        val batch = seasonBatches.firstOrNull { item.id in it.pending }
+        if (reason == StreamSelectionFailure.NoPreference) {
+            if (batch == null) {
+                requestManualSelection(request, reason)
+                return
+            }
+            // Nothing is known about this show yet: ask once for the first episode, then continue the rest.
+            seasonBatches.remove(batch)
+            batch.pending.remove(item.id)
+            batch.pending.toList().forEach { DownloadsRepository.removeQueued(it) }
+            batch.pending.clear()
+            pendingSeasonBatch = PendingSeasonBatch(
+                parentMetaId = batch.parentMetaId,
+                requests = batch.requests,
+                createdAtEpochMs = DownloadsClock.nowEpochMs(),
+            )
+            _events.tryEmit(DownloadUiEvent.NeedsManualSelection(++nextEventId, request, reason))
+            NuvioToastController.show(getString(Res.string.downloads_season_needs_source_toast))
+            return
+        }
+        onSeasonItemSettled(item, success = false)
+    }
+
+    // ---------------------------------------------------------------------------------------------
+    // Season batches
+    // ---------------------------------------------------------------------------------------------
+
+    private fun trackSeasonBatch(parentMetaId: String, queuedRequests: List<DownloadRequest>) {
+        if (queuedRequests.isEmpty()) return
+        val ids = queuedRequests
+            .mapNotNull { DownloadsRepository.itemForKey(it.logicalKey)?.id }
+            .toMutableSet()
+        if (ids.isEmpty()) return
+        seasonBatches += SeasonBatch(
+            parentMetaId = parentMetaId,
+            requests = queuedRequests,
+            pending = ids,
+        )
+    }
+
+    private suspend fun onSeasonItemSettled(item: DownloadItem, success: Boolean) {
+        if (item.origin != DownloadOrigin.Season) return
+        val batch = seasonBatches.firstOrNull { item.id in it.pending } ?: return
+        batch.pending.remove(item.id)
+        if (!success) batch.failed += 1
+        // Items the user deleted meanwhile no longer count.
+        batch.pending.removeAll { id -> DownloadsRepository.itemById(id)?.status != DownloadStatus.Queued }
+        if (batch.pending.isEmpty()) {
+            seasonBatches.remove(batch)
+            if (batch.failed > 0) {
+                NuvioToastController.show(getString(Res.string.downloads_season_partial_toast, batch.failed))
+            }
+        }
+    }
+
+    private fun resumeSeasonBatchAfterManualPick(parentMetaId: String, manualKey: String) {
+        val batch = pendingSeasonBatch ?: return
+        if (batch.parentMetaId.trim() != parentMetaId.trim()) return
+        pendingSeasonBatch = null
+        if (DownloadsClock.nowEpochMs() - batch.createdAtEpochMs > SEASON_BATCH_MAX_AGE_MS) return
+
+        val remaining = batch.requests.filter { it.logicalKey != manualKey }
+        val queued = remaining.filter { request ->
+            DownloadsRepository.enqueueQueued(request.copy(origin = DownloadOrigin.Season)) ==
+                DownloadEnqueueResult.Queued
+        }
+        trackSeasonBatch(batch.parentMetaId, queued)
+    }
+
+    // ---------------------------------------------------------------------------------------------
+    // Smart Downloads
+    // ---------------------------------------------------------------------------------------------
+
+    private fun scheduleSmart(delayMs: Long) {
+        if (smartRunning) {
+            smartDirty = true
+            return
+        }
+        smartJob?.cancel()
+        smartJob = scope.launch {
+            if (delayMs > 0L) delay(delayMs)
+            runSmart()
+        }
+    }
+
+    private suspend fun runSmart() {
+        smartRunning = true
+        try {
+            do {
+                smartDirty = false
+                try {
+                    processSmartPending()
+                } catch (cancelled: CancellationException) {
+                    throw cancelled
+                } catch (error: Throwable) {
+                    log.w(error) { "Smart Downloads pass failed" }
+                }
+            } while (smartDirty)
+        } finally {
+            smartRunning = false
+        }
+    }
+
+    private suspend fun processSmartPending() {
+        ensureSmartPendingLoaded()
+        if (smartPending.isEmpty()) return
+        DownloadsRepository.ensureLoaded()
+        val settings = DownloadSettingsRepository.state.value
+        val network = DownloadsNetworkMonitor.state.value
+        val now = DownloadsClock.nowEpochMs()
+
+        for (pending in smartPending.toList()) {
+            val key = pending.logicalKey
+
+            // 1: drop what no longer applies.
+            val watched = DownloadsRepository.itemForKey(key)
+                ?.takeIf { it.status == DownloadStatus.Completed && it.smartEligible }
+            if (!settings.smartDownloads || now - pending.createdAtEpochMs > SMART_PENDING_MAX_AGE_MS || watched == null) {
+                removeSmartPending(pending)
+                continue
+            }
+
+            // 2: keep it for later while the network does not allow it or the episode is still playing.
+            if (!DownloadNetworkGate.canRunSmart(settings.smartDownloads, settings.wifiOnly, network)) continue
+            if (isPlaybackActive(pending.videoId) || isPlaybackActive(watched.videoId)) continue
+
+            // 3: series metadata
+            val meta = MetaDetailsRepository.peek(watched.parentMetaType, watched.parentMetaId)
+                ?: MetaDetailsRepository.fetch(watched.parentMetaType, watched.parentMetaId)
+                ?: continue
+
+            // The pass above suspended; the profile (and with it the pending list and the download list) or the
+            // watched item may have changed meanwhile.
+            if (pending !in smartPending) continue
+            val stillWatched = DownloadsRepository.itemForKey(key)
+                ?.takeIf { it.status == DownloadStatus.Completed && it.smartEligible }
+            if (stillWatched == null || stillWatched.id != watched.id) continue
+            if (isPlaybackActive(stillWatched.videoId) || isPlaybackActive(pending.videoId)) continue
+            // Smart Downloads may have been switched off while the metadata was loading.
+            if (!DownloadSettingsRepository.state.value.smartDownloads) continue
+            // The episode is being watched again since it was reported as finished: keep the file. The next
+            // finished playback reports it again.
+            if (!isStillWatched(stillWatched)) {
+                removeSmartPending(pending)
+                continue
+            }
+
+            // 4, 5: plan
+            val episodes = plannerEpisodes(meta)
+            val plan = SmartDownloadsPlanner.plan(
+                enabled = true,
+                watchedSeason = pending.seasonNumber,
+                watchedEpisode = pending.episodeNumber,
+                episodes = episodes.map { it.second },
+            )
+
+            val fetch = plan.fetch
+            if (fetch != null) {
+                // 6: queue the next episode; the watched file goes away once that fetch starts.
+                val video = episodes.firstOrNull { (_, planned) ->
+                    planned.season == fetch.season && planned.episode == fetch.episode
+                }?.first
+                if (video != null) {
+                    DownloadsRepository.enqueueQueued(
+                        meta.toDownloadRequest(
+                            video = video,
+                            origin = DownloadOrigin.Smart,
+                            smartReplacesItemId = stillWatched.id,
+                        ),
+                    )
+                    kickResolver()
+                }
+            } else if (
+                plan.deleteWatched &&
+                SmartDeletionPolicy.mayDelete(
+                    smartEnabled = DownloadSettingsRepository.state.value.smartDownloads,
+                    state = stillWatched.status.toDlState(),
+                    smartEligible = stillWatched.smartEligible,
+                    playbackActive = isPlaybackActive(stillWatched.videoId) || isPlaybackActive(pending.videoId),
+                    watchedConfirmed = isStillWatched(stillWatched),
+                )
+            ) {
+                // 7: a later episode is already downloaded and nothing is left to fetch.
+                DownloadsRepository.cancelDownload(stillWatched.id)
+            }
+
+            // 8
+            removeSmartPending(pending)
+        }
+    }
+
+    private fun plannerEpisodes(meta: MetaDetails): List<Pair<MetaVideo, PlannerEpisode>> {
+        val today = CurrentDateProvider.todayIsoDate()
+        return meta.sortedPlayableEpisodes().mapNotNull { video ->
+            val episode = video.episode ?: return@mapNotNull null
+            val season = normalizeSeasonNumber(video.season)
+            val item = if (season > 0) {
+                DownloadsRepository.itemForKey(downloadLogicalKey(meta.id, season, episode))
+            } else {
+                null
+            }
+            video to PlannerEpisode(
+                season = season,
+                episode = episode,
+                released = video.isReleasedBy(today),
+                download = item?.status?.toDlState(),
+                smartEligible = item?.smartEligible == true,
+            )
+        }
+    }
+
+    private fun loadSmartPending() {
+        val payload = DownloadsStorage.loadValue(ProfileScopedKey.of(SMART_PENDING_KEY)).orEmpty().trim()
+        smartPending = if (payload.isEmpty()) {
+            mutableListOf()
+        } else {
+            runCatching { json.decodeFromString<List<SmartPending>>(payload) }
+                .getOrDefault(emptyList())
+                .toMutableList()
+        }
