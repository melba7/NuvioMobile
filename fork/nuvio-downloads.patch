+        val session = NSURLSession.sessionWithConfiguration(
+            configuration = configuration,
+            delegate = delegate,
+            delegateQueue = NSOperationQueue.mainQueue,
+        )
+        session.getAllTasksWithCompletionHandler { tasks ->
+            val enumerated = tasks.asTaskList()
+            scope.launch { onTasksEnumerated(identifier, enumerated) }
+        }
+        return session
+    }
+
+    private fun Any?.asTaskList(): List<Any?> = (this as? List<*>)?.toList() ?: emptyList()
+
+    private fun sessionFor(cellular: Boolean): NSURLSession? = if (cellular) anySession else wifiSession
+
+    private fun sessionIdentifierFor(cellular: Boolean): String =
+        if (cellular) ANY_SESSION_IDENTIFIER else WIFI_SESSION_IDENTIFIER
+
+    // ---------------------------------------------------------------------------------------------
+    // Enumeration and reconciliation
+    // ---------------------------------------------------------------------------------------------
+
+    private fun onTasksEnumerated(identifier: String, tasks: List<Any?>) {
+        val sessionAllowsCellular = identifier == ANY_SESSION_IDENTIFIER
+        for (raw in tasks) {
+            val task = raw as? NSURLSessionDownloadTask
+            if (task == null) {
+                (raw as? NSURLSessionTask)?.cancel()
+                continue
+            }
