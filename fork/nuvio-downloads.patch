+package com.nuvio.app.features.downloads.core
+
+data class PlannerEpisode(
+    val season: Int,
+    val episode: Int,
+    val released: Boolean,
+    val download: DlState?,
+    /**
+     * The download of this episode was created by code that knows Smart Downloads (stored flag, false for every
+     * download that existed before that code shipped). Only meaningful for the watched episode.
+     */
+    val smartEligible: Boolean = false,
+)
+
+data class SmartPlan(
+    val fetch: PlannerEpisode?,
+    val deleteWatched: Boolean,
+    val deleteAfterFetchStarts: Boolean,
+)
+
+object SmartDownloadsPlanner {
+    private val nothing = SmartPlan(fetch = null, deleteWatched = false, deleteAfterFetchStarts = false)
+
+    fun plan(
+        enabled: Boolean,
+        watchedSeason: Int?,
+        watchedEpisode: Int?,
+        episodes: List<PlannerEpisode>,
+    ): SmartPlan {
+        if (!enabled || watchedSeason == null || watchedEpisode == null || watchedSeason <= 0) return nothing
+
+        val ordered = episodes
+            .filter { it.season > 0 }
+            .sortedWith(compareBy<PlannerEpisode> { it.season }.thenBy { it.episode })
+        val watchedIndex = ordered.indexOfFirst { it.season == watchedSeason && it.episode == watchedEpisode }
+        if (watchedIndex < 0) return nothing
+        if (ordered[watchedIndex].download != DlState.Completed) return nothing
+        // Never touch a download that existed before Smart Downloads did, nor anything the app did not create itself.
+        if (!ordered[watchedIndex].smartEligible) return nothing
+
+        val later = ordered.subList(watchedIndex + 1, ordered.size)
+
+        var fetch: PlannerEpisode? = null
+        for (candidate in later) {
+            if (!candidate.released) break
+            if (candidate.download != null) continue
+            fetch = candidate
+            break
+        }
+
+        // Only a later episode that is playable or on its way replaces the watched one; a failed, queued or paused
+        // later item must not cost the user the file they can play now.
+        val laterHasDownload = later.any { it.download == DlState.Completed || it.download == DlState.Downloading }
+        return SmartPlan(
+            fetch = fetch,
+            deleteWatched = fetch != null || laterHasDownload,
+            deleteAfterFetchStarts = fetch != null,
+        )
+    }
+}
+
+/** The one gate in front of every automatic delete done by Smart Downloads. */
+object SmartDeletionPolicy {
+    /**
+     * [smartEligible] is false for every download that existed before Smart Downloads did (it is a stored flag that
+     * older data does not contain), so such downloads are never deleted automatically. Only a completed download is
+     * ever deleted, never while it is playing, and never when the feature is off. [watchedConfirmed] is checked
+     * again at the moment of the delete: it is false when the episode is being watched again since it was finished
+     * (the delete can happen long after the playback that triggered it, for example once Wi-Fi is back).
+     */
+    fun mayDelete(
+        smartEnabled: Boolean,
+        state: DlState?,
+        smartEligible: Boolean,
+        playbackActive: Boolean,
+        watchedConfirmed: Boolean,
+    ): Boolean = smartEnabled && state == DlState.Completed && smartEligible && !playbackActive && watchedConfirmed
+}
+
+enum class SeasonDownloadPhase { Idle, InProgress, AllDownloaded, Unavailable }
+
+data class SeasonPlan(
+    val toQueue: List<PlannerEpisode>,
+    val phase: SeasonDownloadPhase,
+    val completed: Int,
+    val active: Int,
+    val total: Int,
+)
+
+object SeasonDownloadPlanner {
+    fun plan(episodes: List<PlannerEpisode>): SeasonPlan {
+        val released = episodes.filter { it.released }
+        val total = released.size
+        val completed = released.count { it.download == DlState.Completed }
+        val active = released.count {
+            it.download == DlState.Queued || it.download == DlState.Downloading || it.download == DlState.Paused
+        }
+        val toQueue = released
+            .filter { it.download == null || it.download == DlState.Failed }
+            .sortedWith(compareBy<PlannerEpisode> { it.season }.thenBy { it.episode })
+        val phase = when {
+            total == 0 -> SeasonDownloadPhase.Unavailable
+            completed == total -> SeasonDownloadPhase.AllDownloaded
+            active > 0 -> SeasonDownloadPhase.InProgress
+            else -> SeasonDownloadPhase.Idle
+        }
+        return SeasonPlan(
+            toQueue = toQueue,
+            phase = phase,
+            completed = completed,
+            active = active,
+            total = total,
+        )
+    }
+}
