+    private val listeners = mutableMapOf<String, IosDownloadListener>()
+    private val liveTasks = mutableMapOf<String, LiveTask>()
+    private val pendingOutcomes = mutableMapOf<String, FileOutcome>()
+    private val stops = mutableMapOf<String, StopInFlight>()
+    private val tombstones = mutableSetOf<String>()
+    private val madeProgress = mutableSetOf<String>()
+    private val completionHandlers = mutableMapOf<String, () -> Unit>()
+    /** Session identifier -> when its events finished although the system had not handed over a handler yet. */
+    private val finishedWithoutHandler = mutableMapOf<String, Long>()
+    private var nextStopSerial = 0L
+
+    // ---------------------------------------------------------------------------------------------
+    // Sessions
+    // ---------------------------------------------------------------------------------------------
+
+    /** Idempotent. Never invalidates a session and never creates a second one with the same identifier. */
+    fun ensureSessions() {
+        if (sessionsStarted) return
+        sessionsStarted = true
+        wifiSession = createSession(WIFI_SESSION_IDENTIFIER, cellular = false)
+        anySession = createSession(ANY_SESSION_IDENTIFIER, cellular = true)
+        scope.launch {
+            var waitedMs = 0L
+            while (enumeratedSessions < 2 && waitedMs < ENUMERATION_WAIT_LIMIT_MS) {
+                delay(250L)
+                waitedMs += 250L
+            }
+            // Completion events of tasks that finished while the app was dead arrive first.
+            delay(ORPHAN_GRACE_MS)
+            graceElapsed = true
+            reconcileOrphans()
+        }
+    }
+
+    private fun createSession(identifier: String, cellular: Boolean): NSURLSession {
+        val configuration = NSURLSessionConfiguration.backgroundSessionConfigurationWithIdentifier(identifier)
+        configuration.allowsCellularAccess = cellular
+        configuration.allowsExpensiveNetworkAccess = true
+        configuration.allowsConstrainedNetworkAccess = true
+        configuration.sessionSendsLaunchEvents = true
+        configuration.discretionary = false
+        configuration.timeoutIntervalForRequest = REQUEST_TIMEOUT_SECONDS
+        configuration.timeoutIntervalForResource = RESOURCE_TIMEOUT_SECONDS
+        configuration.HTTPMaximumConnectionsPerHost = MAX_CONNECTIONS_PER_HOST
