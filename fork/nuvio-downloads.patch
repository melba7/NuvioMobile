@@ -0,0 +1,81 @@
+package com.nuvio.app.features.downloads.core
+
+enum class DownloadNetworkKind { Unknown, None, Cellular, Wifi }
+
+data class DownloadNetworkState(
+    val kind: DownloadNetworkKind = DownloadNetworkKind.Unknown,
+    val isExpensive: Boolean = false,
+    val isConstrained: Boolean = false,
+)
+
+enum class DownloadIconState {
+    NotDownloaded,
+    Queued,
+    WaitingForWifi,
+    WaitingForNetwork,
+    Downloading,
+    Paused,
+    Completed,
+    Failed,
+}
+
+object DownloadNetworkGate {
+    fun classify(
+        satisfied: Boolean,
+        usesWifi: Boolean,
+        usesWired: Boolean,
+        usesCellular: Boolean,
+    ): DownloadNetworkKind = when {
+        !satisfied -> DownloadNetworkKind.None
+        usesWifi || usesWired -> DownloadNetworkKind.Wifi
+        usesCellular -> DownloadNetworkKind.Cellular
+        // A satisfied path that is neither Wi-Fi, wired nor cellular (for example a VPN-only interface).
+        else -> DownloadNetworkKind.Wifi
+    }
+
+    /** Value handed to `DownloadsPlatformDownloader.applyNetworkPolicy`. */
+    fun allowsCellular(wifiOnly: Boolean): Boolean = !wifiOnly
+
+    /** Stream resolution only needs small metadata requests, so any connection is fine. Unknown counts as connected. */
+    fun canResolve(network: DownloadNetworkState): Boolean =
+        network.kind != DownloadNetworkKind.None
+
+    fun canRunSmart(
+        smartEnabled: Boolean,
+        wifiOnly: Boolean,
+        network: DownloadNetworkState,
+    ): Boolean =
+        smartEnabled &&
+            network.kind != DownloadNetworkKind.None &&
+            network.kind != DownloadNetworkKind.Unknown &&
+            !network.isConstrained &&
+            !(wifiOnly && network.kind == DownloadNetworkKind.Cellular)
+
+    fun iconState(
+        state: DlState?,
+        downloadedBytes: Long,
+        totalBytes: Long?,
+        wifiOnly: Boolean,
+        network: DownloadNetworkState,
+    ): DownloadIconState {
+        val waitingForWifi = wifiOnly && network.kind == DownloadNetworkKind.Cellular
+        val noNetwork = network.kind == DownloadNetworkKind.None
+        return when (state) {
+            null -> DownloadIconState.NotDownloaded
+            DlState.Queued -> when {
+                noNetwork -> DownloadIconState.WaitingForNetwork
+                waitingForWifi -> DownloadIconState.WaitingForWifi
+                else -> DownloadIconState.Queued
+            }
+            DlState.Downloading -> when {
+                waitingForWifi -> DownloadIconState.WaitingForWifi
+                noNetwork -> DownloadIconState.WaitingForNetwork
+                downloadedBytes <= 0L && totalBytes == null -> DownloadIconState.Queued
+                else -> DownloadIconState.Downloading
+            }
+            DlState.Paused -> DownloadIconState.Paused
+            DlState.Completed -> DownloadIconState.Completed
+            DlState.Failed -> DownloadIconState.Failed
+        }
+    }
+}
