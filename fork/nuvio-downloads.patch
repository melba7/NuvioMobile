+/**
+ * Owns the two background `NSURLSession`s (Wi-Fi only / any network) and every native download task.
+ *
+ * Threading: everything runs on the main thread. The delegate queue of both sessions is `NSOperationQueue.mainQueue`;
+ * callbacks that arrive on other queues (resume data, task enumeration) hop to the main thread via [scope].
+ */
+@OptIn(ExperimentalForeignApi::class, BetaInteropApi::class)
+internal object IosBackgroundDownloads {
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Main)
+    private val delegate = IosBackgroundDownloadDelegate()
+    private val throttle = DownloadProgressThrottle(1_000L)
+
+    private var wifiSession: NSURLSession? = null
+    private var anySession: NSURLSession? = null
+    private var sessionsStarted = false
+    private var enumeratedSessions = 0
+    private var graceElapsed = false
+    private var allowCellular = false
