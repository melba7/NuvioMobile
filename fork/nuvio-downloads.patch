+/** Callbacks of the app-level repository for one download. They are never invoked inside `attach`. */
+internal class IosDownloadListener(
+    val onProgress: (downloadedBytes: Long, totalBytes: Long?) -> Unit,
+    val onSuccess: (localFileUri: String, totalBytes: Long?) -> Unit,
+    val onFailure: (failure: DownloadTransferFailure) -> Unit,
+    val onPaused: () -> Unit,
+)
+
+private sealed interface FileOutcome {
+    class Success(val localFileUri: String, val bytes: Long?) : FileOutcome
+    class Http(val status: Int) : FileOutcome
