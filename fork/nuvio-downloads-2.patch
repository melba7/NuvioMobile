+/** "Torrentio • 1080p • 1.4 GB": what is known about the source of a download; empty when nothing is. */
+internal fun downloadSourceSummary(item: DownloadItem): String {
+    val resolution = StreamQualityParser.resolution(
+        "${item.streamTitle} ${item.streamSubtitle.orEmpty()} ${item.fileName}",
+    )
+    val size = item.totalBytes ?: item.expectedBytes
+    return listOfNotNull(
+        item.providerName.takeIf { it.isNotBlank() },
+        "${resolution}p".takeIf { resolution > 0 },
+        size?.takeIf { it > 0L }?.let { formatBytes(it) },
+    ).joinToString(" • ")
+}
