@@ -0,0 +1,86 @@
+package com.nuvio.app.features.downloads.core
+
+/**
+ * Pure helpers for the size of a stream (download mode shows and orders the stream list by it).
+ * This file (like everything in `core/`) may only import `kotlin.*`.
+ */
+object StreamSizeParser {
+    const val MIN_PLAUSIBLE_BYTES = 1L * 1024 * 1024               // 1 MB
+    const val MAX_PLAUSIBLE_BYTES = 500L * 1024 * 1024 * 1024      // 500 GB
+
+    private const val DISK_EMOJI = "💾"                  // the disk emoji used by add-ons in front of the file size
+    private const val MARK_LOOKBACK = 4
+
+    // No look-behind / look-ahead on purpose: the surrounding characters are checked in code.
+    private val sizePattern = Regex(
+        "(\\d{1,5}(?:[.,]\\d{1,3})?)[ \\u00A0\\t]{0,2}(tib|gib|mib|tb|gb|mb)",
+        RegexOption.IGNORE_CASE,
+    )
+
+    /** Size of the file a stream text talks about, in bytes; null when the text names none. */
+    fun parse(text: String?): Long? {
+        if (text.isNullOrEmpty()) return null
+
+        var smallest: Long? = null
+        for (match in sizePattern.findAll(text)) {
+            val start = match.range.first
+            val endExclusive = match.range.last + 1
+
+            if (start > 0) {
+                val before = text[start - 1]
+                if (before.isLetterOrDigit()) continue
+                if ((before == '.' || before == ',') && start > 1 && text[start - 2].isDigit()) continue
+            }
+            if (endExclusive < text.length) {
+                val after = text[endExclusive]
+                if (after.isLetter() || after == '/') continue
+            }
+
+            val number = match.groupValues[1].replace(',', '.').toDoubleOrNull() ?: continue
+            val multiplier: Long = when (match.groupValues[2].lowercase().first()) {
+                't' -> 1024L * 1024L * 1024L * 1024L
+                'g' -> 1024L * 1024L * 1024L
+                else -> 1024L * 1024L
+            }
+            val bytes = (number * multiplier.toDouble()).toLong()
+            if (bytes < MIN_PLAUSIBLE_BYTES || bytes > MAX_PLAUSIBLE_BYTES) continue
+
+            val marked = text.substring(maxOf(0, start - MARK_LOOKBACK), start).contains(DISK_EMOJI)
+            if (marked) return bytes
+
+            val current = smallest
+            if (current == null || bytes < current) smallest = bytes
+        }
+        return smallest
+    }
+
+    /** First usable value of: videoSize, rawSize, cachedSize (each must be > 0), then parse() of each text in order. */
+    fun resolve(videoSize: Long?, rawSize: Long?, cachedSize: Long?, texts: List<String?>): Long? {
+        if (videoSize != null && videoSize > 0L) return videoSize
+        if (rawSize != null && rawSize > 0L) return rawSize
+        if (cachedSize != null && cachedSize > 0L) return cachedSize
+        for (text in texts) {
+            val parsed = parse(text)
+            if (parsed != null) return parsed
+        }
+        return null
+    }
+}
+
+data class SizedStream(val index: Int, val sizeBytes: Long?, val downloadable: Boolean)
+
+object DownloadModeOrdering {
+    /** Download-mode order: known sizes ascending, then unknown sizes, then streams that cannot be downloaded. */
+    fun order(streams: List<SizedStream>): List<SizedStream> {
+        fun group(stream: SizedStream): Int = when {
+            !stream.downloadable -> 2
+            stream.sizeBytes == null || stream.sizeBytes <= 0L -> 1
+            else -> 0
+        }
+        fun key(stream: SizedStream): Long {
+            val size = stream.sizeBytes
+            return if (size != null && size > 0L) size else Long.MAX_VALUE
+        }
+        return streams.sortedWith(compareBy<SizedStream>({ group(it) }, { key(it) }, { it.index }))
+    }
+}
