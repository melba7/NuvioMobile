+package com.nuvio.app.features.downloads.core
+
+enum class DownloadQualityMode { SameAsLast, Max1080, Max720, Max480, AlwaysAsk }
+
+object DownloadQualityPolicy {
+    fun parse(stored: String?): DownloadQualityMode =
+        DownloadQualityMode.entries.firstOrNull { it.name == stored } ?: DownloadQualityMode.SameAsLast
+
+    /** 0 = no cap. */
+    fun maxResolution(mode: DownloadQualityMode): Int = when (mode) {
+        DownloadQualityMode.SameAsLast -> 0
+        DownloadQualityMode.Max1080 -> 1080
+        DownloadQualityMode.Max720 -> 720
+        DownloadQualityMode.Max480 -> 480
+        DownloadQualityMode.AlwaysAsk -> 0
+    }
+
+    /** "Always ask": every download the user starts opens the stream list instead of being picked automatically. */
+    fun asksEveryTime(mode: DownloadQualityMode): Boolean = mode == DownloadQualityMode.AlwaysAsk
+
+    /**
+     * The origin to judge a queued item by. An item that already had a transfer (its link expired and it was queued
+     * again) is not a new question to the user: it never falls under "Always ask", only the stored or the
+     * download-derived choice counts (what a season download uses).
+     */
+    fun preferenceOrigin(origin: DlOrigin, hadTransfer: Boolean): DlOrigin =
+        if (hadTransfer && origin == DlOrigin.User) DlOrigin.Season else origin
+
+    /**
+     * The preference the automatic selector may use; null = ask the user (open the stream list).
+     * [fromPlayback] is the show's last streamed source: it is only used when the user did not ask to be asked.
+     */
+    fun effectivePreference(
+        mode: DownloadQualityMode,
+        origin: DlOrigin,
+        stored: StreamPreference?,
+        fromDownloads: StreamPreference?,
+        fromPlayback: StreamPreference?,
+    ): StreamPreference? {
+        if (mode == DownloadQualityMode.AlwaysAsk) {
+            if (origin == DlOrigin.User) return null
+            return DownloadStreamSelector.resolvePreference(stored, fromDownloads)
+        }
+        return DownloadStreamSelector.resolvePreference(stored, fromDownloads, fromPlayback)
+    }
+}
