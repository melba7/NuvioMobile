@@ -0,0 +1,64 @@
+package com.nuvio.app.features.downloads.core
+
+/** What the app knows about the download that already exists for an episode or movie. */
+data class ExistingDownload(
+    val state: DlState,
+    val hadTransfer: Boolean,
+    val downloadedBytes: Long,
+    val providerAddonId: String?,
+    val streamTitle: String,
+    val streamSubtitle: String?,
+    val sourceUrl: String,
+)
+
+/** The stream the user tapped in the download-mode list. */
+data class PickedSource(
+    val addonId: String,
+    val label: String,
+    val subtitle: String?,
+    val directUrl: String?,
+)
+
+enum class ChangeSourceAction { StartNew, ReplaceNow, ConfirmReplace, SameSource }
+
+object ChangeSourcePolicy {
+    const val CONFIRM_PARTIAL_BYTES = 256L * 1024L * 1024L
+
+    fun isSameSource(existing: ExistingDownload, picked: PickedSource): Boolean {
+        if (!existing.hadTransfer) return false
+        val existingUrl = existing.sourceUrl.trim()
+        if (existingUrl.isNotEmpty() && existingUrl == picked.directUrl?.trim()) return true
+        return picked.addonId.isNotBlank() &&
+            picked.addonId == existing.providerAddonId &&
+            existing.streamTitle.trim().isNotEmpty() &&
+            existing.streamTitle.trim() == picked.label.trim() &&
+            existing.streamSubtitle.orEmpty().trim() == picked.subtitle.orEmpty().trim()
+    }
+
+    fun decide(existing: ExistingDownload?, picked: PickedSource): ChangeSourceAction {
+        if (existing == null) return ChangeSourceAction.StartNew
+        val same = isSameSource(existing, picked)
+        return when (existing.state) {
+            DlState.Completed ->
+                if (same) ChangeSourceAction.SameSource else ChangeSourceAction.ConfirmReplace
+            DlState.Downloading, DlState.Paused ->
+                when {
+                    same -> ChangeSourceAction.SameSource
+                    existing.downloadedBytes >= CONFIRM_PARTIAL_BYTES -> ChangeSourceAction.ConfirmReplace
+                    else -> ChangeSourceAction.ReplaceNow
+                }
+            // A queued or failed download is replaced at once; picking the same source again is simply a retry.
+            DlState.Queued, DlState.Failed -> ChangeSourceAction.ReplaceNow
+        }
+    }
+
+    /**
+     * The action to apply when the chosen link is finally ready. The tap and the link can be minutes apart (a debrid
+     * link has to be resolved first), so the existing download is looked at again. [confirmed] means the user has
+     * already agreed to the replacement the dialog asked about.
+     */
+    fun finalAction(existing: ExistingDownload?, picked: PickedSource, confirmed: Boolean): ChangeSourceAction {
+        val action = decide(existing, picked)
+        return if (confirmed && action == ChangeSourceAction.ConfirmReplace) ChangeSourceAction.ReplaceNow else action
+    }
+}
