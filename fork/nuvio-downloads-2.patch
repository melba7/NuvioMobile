@@ -0,0 +1,87 @@
+package com.nuvio.app.features.downloads.core
+
+/** One queued download as the resolver sees it. Pure data so that the scheduling rules can be tested. */
+data class QueuedRef(
+    val id: String,
+    val parentKey: String,              // parentMetaId.trim()
+    val createdAtEpochMs: Long,
+    val order: Int,                     // insertion order, lower = earlier
+    val nextAttemptAtEpochMs: Long,
+    val showHasPreference: Boolean,     // an automatic pick is possible for this show
+)
+
+object ResolveQueuePolicy {
+    /** Must equal `PlayerStreamsRepository.DOWNLOAD_STREAM_SLOTS`. */
+    const val PARALLELISM = 3
+
+    /**
+     * The queued items to start resolving now. Oldest first; an item that is postponed (back-off) or already in flight
+     * is skipped; a show without a usable preference never has more than one resolution in flight (the first one asks
+     * the user which source to use, the rest of the season continues from that answer).
+     */
+    fun pick(queued: List<QueuedRef>, inFlight: List<QueuedRef>, nowMs: Long, freeSlots: Int): List<QueuedRef> {
+        if (freeSlots <= 0) return emptyList()
+        val inFlightIds = inFlight.map { it.id }.toSet()
+        val eligible = queued
+            .filter { it.id !in inFlightIds && it.nextAttemptAtEpochMs <= nowMs }
+            .sortedWith(compareBy<QueuedRef>({ it.createdAtEpochMs }, { it.order }))
+
+        val busyParents = HashSet<String>()
+        for (ref in inFlight) busyParents.add(ref.parentKey)
+
+        val picks = ArrayList<QueuedRef>()
+        for (ref in eligible) {
+            if (picks.size >= freeSlots) break
+            if (!ref.showHasPreference && ref.parentKey in busyParents) continue
+            picks.add(ref)
+            busyParents.add(ref.parentKey)
+        }
+        return picks
+    }
+
+    /** Delay until the earliest postponed item is due; null when none is postponed. */
+    fun nextWakeDelayMs(queued: List<QueuedRef>, inFlightIds: Set<String>, nowMs: Long): Long? {
+        var earliest: Long? = null
+        for (ref in queued) {
+            if (ref.id in inFlightIds) continue
+            if (ref.nextAttemptAtEpochMs <= nowMs) continue
+            val current = earliest
+            if (current == null || ref.nextAttemptAtEpochMs < current) earliest = ref.nextAttemptAtEpochMs
+        }
+        val due = earliest ?: return null
+        return due - nowMs
+    }
+}
+
+enum class ResolveFailureKind { NoPreference, ProviderMissing, QualityMissing, NoDownloadableStream, Transient }
+
+data class ResolveRetryDecision(val retry: Boolean, val delayMs: Long)
+
+object ResolveRetryPolicy {
+    const val MAX_TRANSIENT_RETRIES = 4
+
+    private val delaysMs = longArrayOf(5_000L, 20_000L, 60_000L, 180_000L)
+
+    fun decide(kind: ResolveFailureKind, retriesSoFar: Int): ResolveRetryDecision {
+        if (kind == ResolveFailureKind.Transient && retriesSoFar >= 0 && retriesSoFar < MAX_TRANSIENT_RETRIES) {
+            return ResolveRetryDecision(true, delaysMs[retriesSoFar])
+        }
+        return ResolveRetryDecision(false, 0L)
+    }
+
+    /**
+     * Whether a queued item carries retry state that a fresh look at it (the app came to the foreground) should clear:
+     * attempts that were each cut short by the app being suspended must not use up the budget.
+     */
+    fun needsReset(retriesSoFar: Int, nextAttemptAtEpochMs: Long): Boolean =
+        retriesSoFar != 0 || nextAttemptAtEpochMs != 0L
+
+    /** Transient -> NoDownloadableStream (what the old code did on any failure), every other kind maps 1:1. */
+    fun toSelectionFailure(kind: ResolveFailureKind): StreamSelectionFailure = when (kind) {
+        ResolveFailureKind.NoPreference -> StreamSelectionFailure.NoPreference
+        ResolveFailureKind.ProviderMissing -> StreamSelectionFailure.ProviderMissing
+        ResolveFailureKind.QualityMissing -> StreamSelectionFailure.QualityMissing
+        ResolveFailureKind.NoDownloadableStream -> StreamSelectionFailure.NoDownloadableStream
+        ResolveFailureKind.Transient -> StreamSelectionFailure.NoDownloadableStream
+    }
+}
