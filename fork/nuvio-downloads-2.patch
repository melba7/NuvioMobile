new file mode 100644
index 0000000..53be57e
--- /dev/null
+++ b/iosApp/iosApp/DownloadsBackgroundCoordinator.swift
@@ -0,0 +1,135 @@
+import UIKit
+import BackgroundTasks
+import ComposeApp
+
+/// Keeps the process alive while the shared code still has download work that needs it (resolving queued downloads,
+/// restarting transfers, delivering the last Live Activity update), and wires the three ways the app gets to run in
+/// the background: leaving the app, background URLSession events, and the opportunistic refresh task.
+/// Main thread only.
+final class DownloadsBackgroundCoordinator {
+    static let shared = DownloadsBackgroundCoordinator()
+    static let refreshTaskIdentifier = "com.nuvio.downloads.refresh"
+
+    private var observers: [NSObjectProtocol] = []
+    private var backgroundTask: UIBackgroundTaskIdentifier = .invalid
+    private var drainTimer: Timer?
+    private var drainDeadline = Date.distantPast
+    private var idlePolls = 0
+    private var drainCompletions: [() -> Void] = []
+    private var refreshRegistered = false
+
+    private init() {}
+
+    /// Must be called from didFinishLaunching before it returns (BGTaskScheduler requires early registration).
+    func start() {
+        guard observers.isEmpty else { return }
+
+        let permitted = Bundle.main.object(forInfoDictionaryKey: "BGTaskSchedulerPermittedIdentifiers") as? [String] ?? []
+        if permitted.contains(Self.refreshTaskIdentifier) {
+            refreshRegistered = BGTaskScheduler.shared.register(
+                forTaskWithIdentifier: Self.refreshTaskIdentifier,
+                using: nil
+            ) { task in
+                DispatchQueue.main.async {
+                    DownloadsBackgroundCoordinator.shared.handleRefresh(task)
+                }
+            }
+        }
+
+        let center = NotificationCenter.default
+        observers.append(center.addObserver(forName: UIApplication.didEnterBackgroundNotification, object: nil, queue: .main) { [weak self] _ in
+            self?.didEnterBackground()
+        })
+        observers.append(center.addObserver(forName: UIApplication.willEnterForegroundNotification, object: nil, queue: .main) { [weak self] _ in
+            self?.willEnterForeground()
+        })
+    }
+
+    private func didEnterBackground() {
+        beginBackgroundWork(maxSeconds: 25)
+        DownloadsPlatformDownloader_iosKt.downloadsAppDidEnterBackground()
+        scheduleRefreshIfNeeded()
+    }
+
+    private func willEnterForeground() {
+        DownloadsPlatformDownloader_iosKt.downloadsAppWillEnterForeground()
+        if refreshRegistered {
+            BGTaskScheduler.shared.cancel(taskRequestWithIdentifier: Self.refreshTaskIdentifier)
+        }
+    }
+
+    /// Holds a UIKit background task until the shared code reports no pending work three polls in a row (1.5 s),
+    /// or `maxSeconds` have passed. Safe to call again while already running (the deadline is extended).
+    func beginBackgroundWork(maxSeconds: TimeInterval, completion: (() -> Void)? = nil) {
+        if let completion { drainCompletions.append(completion) }
+        drainDeadline = max(drainDeadline, Date().addingTimeInterval(maxSeconds))
+        idlePolls = 0
+
+        if backgroundTask == .invalid {
+            backgroundTask = UIApplication.shared.beginBackgroundTask(withName: "nuvio.downloads.work") { [weak self] in
+                self?.finishBackgroundWork()            // the system is about to suspend us
+            }
+        }
+        if drainTimer == nil {
+            let timer = Timer(timeInterval: 0.5, repeats: true) { [weak self] _ in
+                self?.pollDrain()
+            }
+            RunLoop.main.add(timer, forMode: .common)
+            drainTimer = timer
+        }
+    }
+
+    private func pollDrain() {
+        let pending = DownloadsPlatformDownloader_iosKt.downloadsPendingWorkCount() > 0
+        let busy = pending || DownloadsLiveActivityManager.shared.isBusy
+        idlePolls = busy ? 0 : idlePolls + 1
+        if idlePolls >= 3 || Date() >= drainDeadline {
+            finishBackgroundWork()
+        }
+    }
+
+    private func finishBackgroundWork() {
+        drainTimer?.invalidate()
+        drainTimer = nil
+        drainDeadline = Date.distantPast
+
+        let completions = drainCompletions
+        drainCompletions = []
+        completions.forEach { $0() }
+
+        if backgroundTask != .invalid {
+            UIApplication.shared.endBackgroundTask(backgroundTask)
+            backgroundTask = .invalid
+        }
+    }
+
+    private func scheduleRefreshIfNeeded() {
+        guard refreshRegistered else { return }
+        guard DownloadsPlatformDownloader_iosKt.downloadsActiveCount() > 0 else { return }
+        let request = BGAppRefreshTaskRequest(identifier: Self.refreshTaskIdentifier)
+        request.earliestBeginDate = Date(timeIntervalSinceNow: 10 * 60)
+        do {
+            try BGTaskScheduler.shared.submit(request)
+        } catch {
+            // Not available (Background App Refresh off, Simulator). Nothing depends on it.
+        }
+    }
+
+    private func handleRefresh(_ task: BGTask) {
+        var finished = false
+        let finish: (Bool) -> Void = { success in
+            guard !finished else { return }
+            finished = true
+            task.setTaskCompleted(success: success)
+        }
+        task.expirationHandler = {
+            DispatchQueue.main.async { finish(false) }
+        }
+
+        DownloadsPlatformDownloader_iosKt.downloadsBackgroundWake()
+        beginBackgroundWork(maxSeconds: 20) { [weak self] in
+            self?.scheduleRefreshIfNeeded()             // chain the next run while downloads are still active
+            finish(true)
+        }
+    }
+}
