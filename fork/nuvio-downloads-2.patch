+/**
+ * Size of the file behind this stream as advertised by its source: the structured fields first, then the sizes
+ * add-ons write into their text (see [StreamSizeParser]). Null when nothing names a size.
+ */
+internal fun StreamItem.downloadSizeBytes(): Long? = StreamSizeParser.resolve(
+    videoSize = behaviorHints.videoSize,
+    rawSize = clientResolve?.stream?.raw?.size,
+    cachedSize = debridCacheStatus?.cachedSize,
+    texts = listOf(description, title, name, behaviorHints.filename),
+)
+
+/** Same rule as `DownloadStreamSelector`'s "eligible". */
+internal fun StreamItem.isDownloadCandidate(): Boolean =
+    DownloadUrlRules.isSupported(playableDirectUrl) ||
+        (playableDirectUrl == null && DirectDebridPlaybackResolver.shouldResolveToPlayableStream(this))
+
+internal fun StreamItem.toPickedSource(): PickedSource =
+    PickedSource(addonId = addonId, label = streamLabel, subtitle = streamSubtitle, directUrl = playableDirectUrl)
+
+internal data class DownloadModeRow(val stream: StreamItem, val sizeBytes: Long?, val downloadable: Boolean)
+
+/** Flat, size-ordered rows for the stream list in download mode: smallest first, unknown sizes after, not downloadable last. */
