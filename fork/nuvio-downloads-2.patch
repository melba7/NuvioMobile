+package com.nuvio.app.features.downloads.core
+
+/**
+ * Small pure decisions of the iOS life-cycle code (`IosBackgroundDownloads`, `DownloadsLiveStatusPlatform`) and of the
+ * downloads screen, kept here so that they can be tested without a device. `kotlin.*` imports only.
+ */
+
+enum class PromotionAction {
+    /** The task has received bytes, so it is running: only the "created in the background" mark is cleared. */
+    ClearMark,
+
+    /** Leave the task alone: replacing it would throw away its resume data or skip its retry delay. */
+    Leave,
+
+    /** A plain request that has not received a byte (iOS may defer it while the app was away): start a new one. */
+    Replace,
+}
+
+object BackgroundPromotionPolicy {
+    /**
+     * How long after a foreground entry the decision is taken. The byte counter of a task is only brought up to date
+     * by the next progress message of the system's download service, so right at the entry a task that ran while the
+     * app was suspended can still read 0; replacing it then would throw its progress away.
+     */
+    const val SETTLE_DELAY_MS = 3_000L
+
+    /**
+     * What to do, back in the foreground, with a task that was created while the app was in the background.
+     * A task that was created from resume data (`startTask` has already consumed the stored copy, so a new task would
+     * begin at byte 0) or that waits for a retry delay (429/503 back-off) is never replaced, even with 0 bytes: it is
+     * looked at again on the next foreground entry. [progressSeen]: a progress message with bytes arrived for the task
+     * in this process, whatever its counter says right now.
+     */
+    fun decide(
+        bytesReceived: Long,
+        startedFromResumeData: Boolean,
+        autoRetries: Int,
+        freshRestarts: Int,
+        progressSeen: Boolean = false,
+    ): PromotionAction = when {
+        bytesReceived > 0L || progressSeen -> PromotionAction.ClearMark
+        startedFromResumeData || autoRetries > 0 || freshRestarts > 0 -> PromotionAction.Leave
+        else -> PromotionAction.Replace
+    }
+}
+
+object ProgressReportPolicy {
+    /**
+     * A task that is still waiting in the system queue (or a resumed one that has not reconnected) reports 0 bytes.
+     * That is no fact about the file and must not overwrite what the list and the Live Activity already show.
+     */
+    fun isMeaningful(bytesReceived: Long): Boolean = bytesReceived > 0L
+}
+
+/** Where the Live Activity payload is computed from at a wake of the process. */
+enum class LivePublishSource {
+    /** The loaded repository (`DownloadsLiveStatusPlatform.flush`). */
+    Repository,
+
+    /** The native records (`DownloadsLiveStatusPlatform.publishFromRecords`), a launch without UI and repository. */
+    Records,
+
+    /** Publish nothing now: a later event does it. */
+    Wait,
+}
+
+object ColdPublishPolicy {
+    /**
+     * A refresh task, a session wake or the end of a session's events. Without a loaded repository the byte counters of
+     * the native tasks are only readable once both sessions have reported their tasks; before that the records hold
+     * "0 bytes" for every running download, and publishing them would replace the running estimate by "0 %".
+     */
+    fun onWake(repositoryLoaded: Boolean, sessionsEnumerated: Boolean): LivePublishSource = when {
+        repositoryLoaded -> LivePublishSource.Repository
+        sessionsEnumerated -> LivePublishSource.Records
+        else -> LivePublishSource.Wait
+    }
+
+    /**
+     * Both sessions have just reported their tasks (or the wait gave up). A process that the system started for a
+     * background event publishes from the records; a normal launch waits for its repository, which publishes by itself.
+     */
+    fun onSessionsEnumerated(repositoryLoaded: Boolean, inForeground: Boolean): LivePublishSource = when {
+        repositoryLoaded -> LivePublishSource.Repository
+        !inForeground -> LivePublishSource.Records
+        else -> LivePublishSource.Wait
+    }
+}
+
+object LiveStatusPublishPolicy {
+    /**
+     * Whether "no activity any more" (removing the payload) may be posted now. Not right after this process has posted
+     * a finished payload: the Swift side applies only the newest payload, so removing it before the pending apply ran
+     * would end the activity at once instead of showing the "n downloads ready" summary.
+     */
+    fun mayRemovePayload(postedOnce: Boolean, lastPostedFinished: Boolean): Boolean =
+        !(postedOnce && lastPostedFinished)
+}
+
+object DownloadBulkActions {
+    /**
+     * "Pause all" needs several active downloads, at least one that runs, and none that still waits for its stream:
+     * a queued download cannot be paused and would start right after the button was used.
+     */
+    fun canPauseAll(active: List<DlState>): Boolean =
+        active.size > 1 &&
+            active.any { it == DlState.Downloading } &&
+            active.none { it == DlState.Queued }
+
+    fun canResumeAll(active: List<DlState>): Boolean =
+        active.size > 1 && active.any { it == DlState.Paused }
+}
diff --git a/composeApp/src/commonMain/kotlin/com/nuvio/app/features/downloads/core/LiveActivityModel.kt b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/downloads/core/LiveActivityModel.kt
new file mode 100644
index 0000000..75aa828
--- /dev/null
+++ b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/downloads/core/LiveActivityModel.kt
@@ -0,0 +1,252 @@
+package com.nuvio.app.features.downloads.core
+
+import kotlin.math.roundToLong
+
+/**
+ * Pure model of the one aggregate Live Activity ("the current batch of downloads").
+ * This file (like everything in `core/`) may only import `kotlin.*`.
+ */
+enum class LiveItemState { Preparing, Starting, Downloading, Paused, Failed, Completed }
+
+data class LiveItem(
+    val id: String,
+    val title: String,
+    val subtitle: String,
+    val state: LiveItemState,
+    val downloadedBytes: Long,
+    val totalBytes: Long?,
+    val expectedBytes: Long?,
+)
+
+data class LiveBatch(val startedAtEpochMs: Long, val ids: List<String>)
+
+enum class LivePhase { Preparing, Downloading, WaitingForWifi, WaitingForNetwork, Paused, Failed, Completed }
+
+data class LiveSnapshot(
+    val phase: LivePhase,
+    val title: String,
+    val subtitle: String,
+    val totalCount: Int,
+    val completedCount: Int,
+    val failedCount: Int,
+    val pausedCount: Int,
+    val preparingCount: Int,
+    val downloadedBytes: Long,
+    val totalBytes: Long?,
+    val progressPermille: Int,
+    val etaStartEpochMs: Long?,
+    val etaEndEpochMs: Long?,
+    val finished: Boolean,
+)
+
+object LiveActivityAggregator {
+    const val MIN_SPEED_BYTES_PER_SEC = 32L * 1024
+    const val MIN_ETA_SECONDS = 5L
+    const val MAX_ETA_SECONDS = 12L * 60 * 60
+    const val MAX_TIMER_FRACTION = 0.98
+
+    private fun isActive(item: LiveItem): Boolean =
+        item.state == LiveItemState.Preparing ||
+            item.state == LiveItemState.Starting ||
+            item.state == LiveItemState.Downloading
+
+    /** Known size of the file: the real length once the server reported it, else what the source advertised. */
+    private fun size(item: LiveItem): Long? {
+        val total = item.totalBytes
+        if (total != null && total > 0L) return total
+        val expected = item.expectedBytes
+        if (expected != null && expected > 0L) return expected
+        return null
+    }
+
+    private fun full(item: LiveItem): Long? {
+        val size = size(item)
+        return if (item.state == LiveItemState.Completed) size ?: maxOf(item.downloadedBytes, 0L) else size
+    }
+
+    private fun done(item: LiveItem): Long {
+        val written = maxOf(item.downloadedBytes, 0L)
+        if (item.state == LiveItemState.Completed) return full(item) ?: written
+        val size = size(item) ?: return written
+        return minOf(written, size)
+    }
+
+    /**
+     * The batch to track: started with the first active item (also a `Preparing` one), extended by every later active
+     * item, ends (null) when no member exists any more.
+     */
+    fun nextBatch(previous: LiveBatch?, items: List<LiveItem>, nowMs: Long): LiveBatch? {
+        val activeIds = items.filter { isActive(it) }.map { it.id }
+        if (previous == null) {
+            return if (activeIds.isEmpty()) null else LiveBatch(nowMs, activeIds)
+        }
+        val existing = items.map { it.id }.toSet()
+        val kept = previous.ids.filter { it in existing }
+        val ids = kept + activeIds.filter { it !in kept }
+        if (ids.isEmpty()) return null
+        return LiveBatch(previous.startedAtEpochMs, ids)
+    }
+
+    /** Ids of the batch members that still wait for a stream (they have no native record yet). */
+    fun preparingIds(batch: LiveBatch, items: List<LiveItem>): List<String> {
+        val byId = HashMap<String, LiveItem>()
+        for (item in items) byId[item.id] = item
+        return batch.ids.filter { byId[it]?.state == LiveItemState.Preparing }
+    }
+
+    /**
+     * Cold background launch: the native records only know items that have a transfer, so the members that were still
+     * waiting for a stream at the last full look ([preparingIds] of the stored batch) are put back as `Preparing`.
+     * Without them the batch would shrink, could look finished ("n downloads ready") and would not count them as
+     * needing the app.
+     */
+    fun withPlaceholders(preparingIds: List<String>, items: List<LiveItem>): List<LiveItem> {
+        if (preparingIds.isEmpty()) return items
+        val known = HashSet<String>()
+        for (item in items) known.add(item.id)
+        val missing = preparingIds.distinct().filter { it !in known }
+        if (missing.isEmpty()) return items
+        return items + missing.map { id ->
+            LiveItem(
+                id = id,
+                title = "",
+                subtitle = "",
+                state = LiveItemState.Preparing,
+                downloadedBytes = 0L,
+                totalBytes = null,
+                expectedBytes = null,
+            )
+        }
+    }
+
+    fun snapshot(
+        batch: LiveBatch,
+        items: List<LiveItem>,
+        network: DownloadNetworkState,
+        wifiOnly: Boolean,
+        speedBytesPerSec: Long?,
+        nowMs: Long,
+    ): LiveSnapshot {
+        val byId = HashMap<String, LiveItem>()
+        for (item in items) byId[item.id] = item
+        val members = batch.ids.mapNotNull { byId[it] }
+
+        val totalCount = members.size
+        val completedCount = members.count { it.state == LiveItemState.Completed }
+        val failedCount = members.count { it.state == LiveItemState.Failed }
+        val pausedCount = members.count { it.state == LiveItemState.Paused }
+        val preparingCount = members.count { it.state == LiveItemState.Preparing }
+        val finished = members.none { isActive(it) }
+
+        val downloadedBytes = members.sumOf { done(it) }
+        val fulls = members.map { full(it) }
+        val totalBytes: Long? =
+            if (members.isNotEmpty() && fulls.all { it != null }) fulls.sumOf { it ?: 0L } else null
+
+        val fraction: Double = when {
+            members.isEmpty() -> 1.0
+            totalBytes != null && totalBytes > 0L -> downloadedBytes.toDouble() / totalBytes.toDouble()
+            else -> members.sumOf { member ->
+                val fullBytes = full(member)
+                when {
+                    member.state == LiveItemState.Completed -> 1.0
+                    fullBytes != null && fullBytes > 0L -> done(member).toDouble() / fullBytes.toDouble()
+                    else -> 0.0
+                }
+            } / members.size.toDouble()
+        }
+        val progressPermille = (fraction * 1000.0).toInt().coerceIn(0, 1000)
+
+        val phase: LivePhase = when {
+            finished -> when {
+                failedCount > 0 -> LivePhase.Failed
+                pausedCount > 0 -> LivePhase.Paused
+                else -> LivePhase.Completed
+            }
+            network.kind == DownloadNetworkKind.None -> LivePhase.WaitingForNetwork
+            wifiOnly && network.kind == DownloadNetworkKind.Cellular -> LivePhase.WaitingForWifi
+            members.any { isActive(it) && it.state != LiveItemState.Preparing } -> LivePhase.Downloading
+            else -> LivePhase.Preparing
+        }
+
+        val label = members.firstOrNull { it.state == LiveItemState.Downloading }
+            ?: members.firstOrNull { it.state == LiveItemState.Starting }
+            ?: members.firstOrNull { it.state == LiveItemState.Preparing }
+            ?: members.lastOrNull()
+        val title = label?.title.orEmpty()
+        val subtitle = label?.subtitle.orEmpty()
+
+        var etaStart: Long? = null
+        var etaEnd: Long? = null
+        if (phase == LivePhase.Downloading && speedBytesPerSec != null && speedBytesPerSec >= MIN_SPEED_BYTES_PER_SEC) {
+            val running = members.filter { isActive(it) || it.state == LiveItemState.Completed }
+            if (running.isNotEmpty() && running.all { full(it) != null }) {
+                val runTotal = running.sumOf { full(it) ?: 0L }
+                val runDone = running.sumOf { done(it) }
+                val remaining = runTotal - runDone
+                if (remaining > 0L) {
+                    val etaSec = (remaining / speedBytesPerSec).coerceIn(MIN_ETA_SECONDS, MAX_ETA_SECONDS)
+                    val f = (runDone.toDouble() / runTotal.toDouble()).coerceIn(0.0, MAX_TIMER_FRACTION)
+                    val elapsedMs = (f / (1.0 - f) * etaSec.toDouble() * 1000.0).roundToLong()
+                    etaEnd = nowMs + etaSec * 1000L
+                    etaStart = nowMs - elapsedMs
+                }
+            }
+        }
+
+        return LiveSnapshot(
+            phase = phase,
+            title = title,
+            subtitle = subtitle,
+            totalCount = totalCount,
+            completedCount = completedCount,
+            failedCount = failedCount,
+            pausedCount = pausedCount,
+            preparingCount = preparingCount,
+            downloadedBytes = downloadedBytes,
+            totalBytes = totalBytes,
+            progressPermille = progressPermille,
+            etaStartEpochMs = etaStart,
+            etaEndEpochMs = etaEnd,
+            finished = finished,
+        )
+    }
+}
+
+/** Download speed over a sliding window of the summed byte counter. */
+class TransferSpeedMeter(
+    private val windowMs: Long = 20_000L,
+    private val minSpanMs: Long = 3_000L,
+    private val staleMs: Long = 10_000L,
+) {
+    private val times = ArrayList<Long>()
+    private val totals = ArrayList<Long>()
+
+    fun reset() {
+        times.clear()
+        totals.clear()
+    }
+
+    fun sample(nowMs: Long, totalDownloadedBytes: Long) {
+        if (times.isNotEmpty()) {
+            val lastTime = times[times.size - 1]
+            val lastTotal = totals[totals.size - 1]
+            if (totalDownloadedBytes < lastTotal || nowMs < lastTime) reset()
+        }
+        times.add(nowMs)
+        totals.add(totalDownloadedBytes)
+        while (times.size > 2 && nowMs - times[1] >= windowMs) {
+            times.removeAt(0)
+            totals.removeAt(0)
+        }
+    }
+
+    fun bytesPerSecond(nowMs: Long): Long? {
+        if (times.size < 2) return null
+        val newestTime = times[times.size - 1]
+        if (nowMs - newestTime > staleMs) return null
+        val span = newestTime - times[0]
+        if (span < minSpanMs) return null
+        return (totals[totals.size - 1] - totals[0]) * 1000L / span
+    }
+}
