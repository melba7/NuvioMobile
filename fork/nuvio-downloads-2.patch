+++ b/composeApp/src/iosMain/kotlin/com/nuvio/app/features/downloads/IosDownloadsLifecycle.kt
@@ -0,0 +1,83 @@
+package com.nuvio.app.features.downloads
+
+import com.nuvio.app.features.downloads.core.ColdPublishPolicy
+import com.nuvio.app.features.downloads.core.LivePublishSource
+
+/**
+ * What the downloads feature does when the app changes between foreground and background, and when the system wakes
+ * it for a finished transfer or a refresh task. The Swift side only calls the thin public functions in
+ * `DownloadsPlatformDownloader.ios.kt`; the decisions live here. Main thread only. No platform imports.
+ */
+internal object IosDownloadsLifecycle {
+    /**
+     * True while the app is (or is about to be) in the foreground. A process that the system starts for a background
+     * event begins as false (`onLaunchedInBackground`), a normal launch as true.
+     */
+    var inForeground: Boolean = true
+        private set
+
+    /** Nothing is known yet in a process started by the system; the first wake publishes from the stored records. */
+    fun onLaunchedInBackground() {
+        inForeground = false
+    }
+
+    /** The user left the app: tell the Live Activity (estimate, "needs the app" count) before iOS suspends us. */
+    fun onDidEnterBackground() {
+        inForeground = false
+        DownloadsLiveStatusPlatform.flush(force = true)
+    }
+
+    fun onWillEnterForeground() {
+        inForeground = true
+        IosBackgroundDownloads.ensureSessions()
+        IosBackgroundDownloads.refreshProgress()
+        // Not at once: the byte counters of tasks that ran while the app was suspended are not up to date yet.
+        IosBackgroundDownloads.schedulePromotion()
+        if (DownloadsRepository.isLoaded) DownloadsOrchestrator.onAppForeground()
+        DownloadsLiveStatusPlatform.flush(force = true)
+    }
+
+    /** A refresh task or a session wake: exact byte counts, then whatever the app-level queue can do. */
+    fun onBackgroundWake() {
+        IosBackgroundDownloads.ensureSessions()
+        IosBackgroundDownloads.refreshProgress()
+        val loaded = DownloadsRepository.isLoaded
+        if (loaded) DownloadsOrchestrator.onBackgroundWake()
+        publish(ColdPublishPolicy.onWake(loaded, IosBackgroundDownloads.sessionsEnumerated()))
+    }
+
+    /** Every event of a background session was delivered to the repository (see `onSessionEventsFinished`). */
+    fun onSessionEventsDelivered() {
+        publish(ColdPublishPolicy.onWake(DownloadsRepository.isLoaded, IosBackgroundDownloads.sessionsEnumerated()))
+    }
+
+    /**
+     * Both background sessions reported their tasks (or the wait gave up): the byte counters of the running tasks are
+     * real now, which is what a publish that had to wait for them (see [ColdPublishPolicy.onWake]) needs.
+     */
+    fun onSessionsEnumerated() {
+        publish(ColdPublishPolicy.onSessionsEnumerated(DownloadsRepository.isLoaded, inForeground))
+    }
+
+    private fun publish(source: LivePublishSource) {
+        when (source) {
+            LivePublishSource.Repository -> DownloadsLiveStatusPlatform.flush(force = true)
+            LivePublishSource.Records -> DownloadsLiveStatusPlatform.publishFromRecords()
+            LivePublishSource.Wait -> Unit
+        }
+    }
+
+    /**
+     * Work that needs the process to stay alive: resolutions (running or due), native stops still in flight and the
+     * sessions' first report of their tasks (the Live Activity of a cold wake needs the byte counters).
+     */
+    fun pendingWorkCount(): Int =
+        (if (DownloadsRepository.isLoaded) DownloadsOrchestrator.pendingWorkCount() else 0) +
+            IosBackgroundDownloads.pendingStopCount() +
+            (if (IosBackgroundDownloads.enumerationPending()) 1 else 0)
+
+    /** Transfers running natively plus items still waiting for a stream. */
+    fun activeCount(): Int =
+        IosBackgroundDownloads.runningCount() +
+            (if (DownloadsRepository.isLoaded) DownloadsRepository.queuedItems().size else 0)
+}
