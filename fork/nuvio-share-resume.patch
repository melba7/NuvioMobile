diff --git a/composeApp/src/commonMain/kotlin/com/nuvio/app/features/clipfinder/ClipEpisodeRank.kt b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/clipfinder/ClipEpisodeRank.kt
