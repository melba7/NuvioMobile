+package com.nuvio.app.features.clipfinder
+
+import com.nuvio.app.features.player.SubtitleSyncCue
+import kotlin.math.max
+import kotlin.random.Random
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertNull
+import kotlin.test.assertTrue
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.test.runTest
+
+/** Generated nonsense words shared by the Clip finder tests; no real dialogue. */
+internal object ClipTestText {
+    private val syllables = listOf("ba", "ko", "ri", "tu", "ne", "sa", "mo", "li", "da", "pe", "vu", "zi")
+    private val vocabulary: List<String> = run {
+        val random = Random(7)
+        List(500) { "${syllables.random(random)}${syllables.random(random)}${syllables.random(random)}" }.distinct()
+    }
+
+    /** [count] cues of 6 made-up words each. */
+    fun cueTexts(seed: Int, count: Int = 60): List<String> {
+        val random = Random(seed)
+        return List(count) { List(6) { vocabulary.random(random) }.joinToString(" ") }
+    }
+
+    /** SRT text with one cue every 4 s, each 3 s long. */
+    fun srt(texts: List<String>): String = texts.mapIndexed { index, text ->
+        "${index + 1}\n${stamp(index * 4_000L)} --> ${stamp(index * 4_000L + 3_000L)}\n$text\n\n"
+    }.joinToString("")
+
+    private fun stamp(ms: Long): String {
+        fun two(n: Long) = n.toString().padStart(2, '0')
+        return "${two(ms / 3_600_000)}:${two(ms / 60_000 % 60)}:${two(ms / 1_000 % 60)},${(ms % 1_000).toString().padStart(3, '0')}"
+    }
+
+    /** The clip as heard: cues [range] of [texts], timed from 0. */
+    fun linesFrom(texts: List<String>, range: IntRange): List<ClipLine> =
+        range.map { ClipLine(texts[it], (it - range.first) * 4_000L, (it - range.first) * 4_000L + 3_000L) }
+
+    /** A clip that is in no episode made from [cueTexts] with another seed. */
+    fun unrelatedLines(): List<ClipLine> = linesFrom(cueTexts(999), 0..11)
+}
+
+/** A subtitle add-on that serves one English subtitle per episode, named after the episode's subtitle id. */
+internal class FakeSubtitleAddon(private val texts: Map<String, List<String>> = emptyMap()) {
+    var listCalls = 0
+    val downloaded = mutableListOf<String>()
+    var clock = 0L
+    var downloadCostMs = 0L
+    var listDelayMs = 0L
+    var active = 0
+    var peak = 0
+    var failing = emptySet<String>()
+    var links: (String) -> List<ClipSubtitleLink> = { id -> listOf(ClipSubtitleLink("https://subs.example.test/$id.srt", "eng")) }
+
+    suspend fun list(id: String): List<ClipSubtitleLink> {
+        listCalls++
+        active++
+        peak = max(peak, active)
+        if (listDelayMs > 0) delay(listDelayMs)
+        active--
+        return links(id)
+    }
+
+    suspend fun download(url: String): String {
+        downloaded += url
+        clock += downloadCostMs
+        if (url in failing) throw IllegalStateException("subtitle server down")
+        return ClipTestText.srt(texts.getValue(url.substringAfterLast('/').removeSuffix(".srt")))
+    }
+}
+
+internal class MapSubtitleCache : ClipSubtitleCache {
+    val map = mutableMapOf<String, String>()
+    override fun read(key: String): String? = map[key]
+    override fun write(key: String, text: String) {
+        map[key] = text
+    }
+}
+
+class EpisodeSubtitleSourceTest {
+    private fun episode(id: String, season: Int? = 1, number: Int? = 1) =
+        ClipEpisode(videoId = id, subtitleId = id, type = "series", season = season, episode = number)
+
+    private fun source(addon: FakeSubtitleAddon, cache: ClipSubtitleCache = MapSubtitleCache()) =
+        EpisodeSubtitleSource({ _, id -> addon.list(id) }, { url -> addon.download(url) }, cache, { addon.clock })
+
+    private fun episodes(count: Int, prefix: String = "e") = (1..count).map { episode("$prefix$it", 1, it) }
+
+    private fun addonFor(episodes: List<ClipEpisode>, seedBase: Int) =
+        FakeSubtitleAddon(episodes.associate { it.videoId to ClipTestText.cueTexts(seedBase + it.episode!!) })
+
+    @Test
+    fun `the second request for an episode comes from the cache`() = runTest {
+        val addon = FakeSubtitleAddon(mapOf("e1" to ClipTestText.cueTexts(1)))
+        val source = source(addon)
+        val first = source.cues("show", episode("e1"))
+        val second = source.cues("show", episode("e1"))
+        assertEquals(60, first?.size)
+        assertEquals(first, second)
+        assertEquals(1, addon.downloaded.size)
+    }
+
+    @Test
+    fun `cues survive the cache format`() {
+        val cues = listOf(SubtitleSyncCue(1_000, 2_500, "first line\nsecond line"), SubtitleSyncCue(3_000, 4_000, "plain"))
+        assertEquals(cues, EpisodeSubtitleSource.decodeCues(EpisodeSubtitleSource.encodeCues(cues)))
+        val tabbed = EpisodeSubtitleSource.decodeCues(EpisodeSubtitleSource.encodeCues(listOf(SubtitleSyncCue(0, 1_000, "a\tb"))))
+        assertEquals("a b", tabbed.single().text)
+        assertTrue(EpisodeSubtitleSource.decodeCues("rubbish").isEmpty())
+    }
+
+    @Test
+    fun `only the english subtitle is downloaded`() = runTest {
+        val addon = FakeSubtitleAddon(mapOf("en" to ClipTestText.cueTexts(2), "fr" to ClipTestText.cueTexts(3)))
+        addon.links = {
+            listOf(ClipSubtitleLink("https://subs.example.test/fr.srt", "fre"), ClipSubtitleLink("https://subs.example.test/en.srt", "English"))
+        }
+        assertEquals(60, source(addon).cues("show", episode("e1"))?.size)
+        assertEquals(listOf("https://subs.example.test/en.srt"), addon.downloaded)
+        for (english in listOf("eng", "en", "en-US", "English")) assertTrue(EpisodeSubtitleSource.isEnglish(english), english)
+        for (other in listOf("fre", "spa", "")) assertFalse(EpisodeSubtitleSource.isEnglish(other), other)
+    }
+
+    @Test
+    fun `a failing or tiny first subtitle falls back to the second and two bad ones give nothing`() = runTest {
+        val bad = "https://subs.example.test/bad.srt"
+        val tiny = "https://subs.example.test/tiny.srt"
+        val good = "https://subs.example.test/good.srt"
+        val addon = FakeSubtitleAddon(
+            mapOf("bad" to ClipTestText.cueTexts(4), "tiny" to ClipTestText.cueTexts(5, count = 5), "good" to ClipTestText.cueTexts(6)),
+        )
+        addon.failing = setOf(bad)
+
+        addon.links = { listOf(ClipSubtitleLink(bad, "eng"), ClipSubtitleLink(good, "eng")) }
+        assertEquals(60, source(addon).cues("show", episode("e1"))?.size)
+
+        addon.links = { listOf(ClipSubtitleLink(tiny, "eng"), ClipSubtitleLink(good, "eng")) }
+        assertEquals(60, source(addon).cues("show", episode("e2"))?.size)
+
+        addon.links = { listOf(ClipSubtitleLink(bad, "eng"), ClipSubtitleLink(tiny, "eng")) }
+        val cache = MapSubtitleCache()
+        assertNull(source(addon, cache).cues("show", episode("e3")))
+        assertTrue(cache.map.isEmpty())
+    }
+
+    @Test
+    fun `at most six episodes are asked at the same time`() = runTest {
+        val list = episodes(20)
+        val addon = addonFor(list, 100)
+        addon.listDelayMs = 50
+        val result = source(addon).search("show", list, ClipTestText.unrelatedLines(), deadlineMs = Long.MAX_VALUE)
+        assertEquals(6, addon.peak)
+        assertEquals(20, result.tried)
+        assertEquals(20, result.withSubtitles)
+        assertFalse(result.decisive)
+    }
+
+    @Test
+    fun `the search stops after the batch that holds a clear match`() = runTest {
+        val list = episodes(30)
+        val addon = addonFor(list, 200)
+        val lines = ClipTestText.linesFrom(ClipTestText.cueTexts(203), 10..21)
+        val result = source(addon).search("show", list, lines, deadlineMs = Long.MAX_VALUE)
+        assertTrue(result.decisive)
+        assertEquals(6, result.tried)
+        assertEquals("e3", result.candidates.first().videoId)
+        assertTrue(addon.downloaded.size <= 6)
+    }
+
+    @Test
+    fun `the search stops when the time is used up`() = runTest {
+        val list = episodes(20)
+        val addon = addonFor(list, 300)
+        addon.downloadCostMs = 10_000
+        val result = source(addon).search("show", list, ClipTestText.unrelatedLines(), deadlineMs = 15_000)
+        assertEquals(6, result.tried)
+        assertFalse(result.decisive)
+    }
+
+    @Test
+    fun `episodes carried over from an earlier show are ranked with the new ones`() = runTest {
+        val showA = episodes(8, "a")
+        val showB = episodes(8, "b")
+        val addon = FakeSubtitleAddon(
+            showA.associate { it.videoId to ClipTestText.cueTexts(400 + it.episode!!) } +
+                showB.associate { it.videoId to ClipTestText.cueTexts(500 + it.episode!!) },
+        )
+        val lines = ClipTestText.linesFrom(ClipTestText.cueTexts(505), 10..21)
+        val source = source(addon)
+        val first = source.search("showA", showA, lines, deadlineMs = Long.MAX_VALUE)
+        assertTrue(first.candidates.isEmpty())
+        val second = source.search("showB", showB, lines, deadlineMs = Long.MAX_VALUE, keep = first.best)
+        assertEquals("b5", second.candidates.first().videoId)
+    }
+
+    @Test
+    fun `the hinted episode comes first, then its season, then the rest`() {
+        val all = (1..2).flatMap { season -> (1..3).map { number -> episode("s$season" + "e$number", season, number) } }.reversed()
+        val ordered = orderEpisodes(all, ClipHint(2, 3))
+        assertEquals(listOf("s2e3", "s2e1", "s2e2", "s1e1", "s1e2", "s1e3"), ordered.map { it.videoId })
+        assertEquals(listOf("s1e1", "s1e2", "s1e3", "s2e1", "s2e2", "s2e3"), orderEpisodes(all, ClipHint()).map { it.videoId })
+        assertEquals(400, orderEpisodes((1..500).map { episode("e$it", 1, it) }, ClipHint()).size)
+    }
+}
