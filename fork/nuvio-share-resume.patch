+package com.nuvio.app.features.clipfinder
+
+import com.nuvio.app.features.player.SubtitleSyncCue
+
+/** One piece of recognised speech (or caption) with its time inside the clip. */
+data class ClipLine(val text: String, val startMs: Long, val endMs: Long)
+
+/** All subtitle cues of one episode (or one movie: season and episode null). */
+data class EpisodeCues(
+    val videoId: String,
+    val season: Int?,
+    val episode: Int?,
+    val cues: List<SubtitleSyncCue>,
+)
+
+/**
+ * A possible answer. [startMs]..[endMs] is the matched span in the episode, [hits] the number
+ * of distinct word triples found, [confidence] 0..1, [confident] true only for a clear winner.
+ */
+data class ClipCandidate(
+    val videoId: String,
+    val season: Int?,
+    val episode: Int?,
+    val startMs: Long,
+    val endMs: Long,
+    val confidence: Double,
+    val hits: Int,
+    val confident: Boolean,
+)
