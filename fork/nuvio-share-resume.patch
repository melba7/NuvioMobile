+    @Test
+    fun `second and third candidates also get a confidence`() {
+        val clip = linesFrom(ep1, 100..120)
+        val half = withCues(ep2, *(100..110).map { it to ep1.cues[it] }.toTypedArray())
+        val third = withCues(ep3, *(100..104).map { it to ep1.cues[it] }.toTypedArray())
+        val result = ClipMatcher.match(clip, listOf(ep1, half, third))
