+++ b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/clipfinder/ClipMatcher.kt
@@ -0,0 +1,119 @@
+package com.nuvio.app.features.clipfinder
+
+object ClipMatcher {
+    const val MIN_HITS = 4
+    /** The best candidate must hold at least this share of the clip's distinct triples (absolute bar). */
+    private const val MIN_SHARE = 0.15
+    /** A hit needs a different hit from a different cue within this distance to count. */
+    private const val NEIGHBOUR_MS = 45_000L
+    /** Hits closer than this to the previous hit belong to the same time cluster. */
+    private const val CLUSTER_GAP_MS = 60_000L
+    /** Triples that occur more often than this in one episode are stock phrases: ignored. */
+    private const val MAX_OCCURRENCES = 3
+
+    /** A cluster is substantial (a real scene of the clip) with this many hits from this many cues. */
+    private const val MIN_CUES = 3
+
+    private class Occurrence(val key: String, val startMs: Long, val endMs: Long, val cue: Int)
+    private class Scored(val candidate: ClipCandidate, val mainHits: Int)
+
+    /**
+     * Scores each episode by its distinct word triples shared with the clip. A hit counts only
+     * when a different triple from a different cue lies within 45 s, so one repeated phrase
+     * cannot vouch for itself. Counted hits are grouped into time clusters (gap over 60 s starts
+     * a new one). Clips can be compilations of several scenes, so every substantial cluster (4+
+     * distinct hits from 3+ cues) is part of the match and a lone stray phrase is not: the span
+     * runs from the earliest substantial cluster to the latest, and hits are totalled over them.
+     * With no substantial cluster the biggest one is used. Best-first; only the best can be
+     * [ClipCandidate.confident]: at least 4 hits in its biggest cluster, hits of at least 15% of
+     * the clip's distinct triples, and at least twice the runner-up's hits.
+     */
+    fun match(
+        lines: List<ClipLine>,
+        episodes: List<EpisodeCues>,
+        maxResults: Int = 3,
+        fillers: Set<String> = emptySet(),
+    ): List<ClipCandidate> {
+        val clipTriples = ClipText.triples(lines.flatMap { ClipText.normalize(it.text, fillers) }).toSet()
+        if (clipTriples.isEmpty()) return emptyList()
+
+        val scored = episodes.mapNotNull { score(it, clipTriples, fillers) }
+            .sortedByDescending { it.candidate.hits }
+            .take(maxResults)
+        return scored.mapIndexed { index, s ->
+            val c = s.candidate
+            val other = scored.filterIndexed { i, _ -> i != index }.maxOfOrNull { it.candidate.hits } ?: 0
+            val share = c.hits.toDouble() / clipTriples.size
+            val raw = minOf(1.0, c.hits / 12.0) * c.hits / (c.hits + other) * minOf(1.0, share / 0.5)
+            val clear = index == 0 && s.mainHits >= MIN_HITS && c.hits >= 2 * other && share >= MIN_SHARE
+            c.copy(confident = clear, confidence = if (c.hits < MIN_HITS) minOf(raw, 0.3) else raw)
+        }
+    }
+
+    private fun score(ep: EpisodeCues, clipTriples: Set<String>, fillers: Set<String>): Scored? {
+        class W(val word: String, val start: Long, val end: Long, val cue: Int)
+        val words = ep.cues.sortedBy { it.startTimeMs }.flatMapIndexed { cueIndex, cue ->
+            ClipText.normalize(cue.text, fillers).map { W(it, cue.startTimeMs, cue.endTimeMs, cueIndex) }
+        }
+        val found = mutableListOf<Occurrence>()
+        for (i in 0..words.size - 3) {
+            val key = "${words[i].word} ${words[i + 1].word} ${words[i + 2].word}"
+            if (key in clipTriples) found += Occurrence(key, words[i].start, words[i + 2].end, words[i].cue)
+        }
+        val usable = found.groupBy { it.key }.filterValues { it.size <= MAX_OCCURRENCES }.values.flatten()
+            .sortedBy { it.startMs }
+        val kept = usable.filterIndexed { i, o -> hasNeighbour(usable, i, o) }
+        if (kept.isEmpty()) return null
+
+        val clusters = groupByTime(kept)
+        fun hits(c: List<Occurrence>) = c.map { it.key }.toSet().size
+        val main = clusters.maxByOrNull { hits(it) }!! // first (earliest) on a tie
+        val substantial = clusters.filter { hits(it) >= MIN_HITS && it.map { o -> o.cue }.toSet().size >= MIN_CUES }
+        val spanned = (substantial.ifEmpty { listOf(main) }).flatten()
+        return Scored(
+            ClipCandidate(
+                videoId = ep.videoId,
+                season = ep.season,
+                episode = ep.episode,
+                startMs = spanned.minOf { it.startMs },
+                endMs = spanned.maxOf { it.endMs },
+                confidence = 0.0,
+                hits = hits(spanned),
+                confident = false,
+            ),
+            mainHits = hits(main),
+        )
+    }
+
+    /** Splits time-sorted hits into runs where each hit starts within the gap of the run's latest end. */
+    private fun groupByTime(sorted: List<Occurrence>): List<List<Occurrence>> {
+        val result = mutableListOf<MutableList<Occurrence>>()
+        var latestEnd = 0L
+        for (o in sorted) {
+            if (result.isEmpty() || o.startMs - latestEnd > CLUSTER_GAP_MS) {
+                result += mutableListOf(o)
+                latestEnd = o.endMs
+            } else {
+                result.last() += o
+                latestEnd = maxOf(latestEnd, o.endMs)
+            }
+        }
+        return result
+    }
+
+    private fun counts(a: Occurrence, b: Occurrence) = a.key != b.key && a.cue != b.cue
+
+    private fun hasNeighbour(sorted: List<Occurrence>, index: Int, o: Occurrence): Boolean {
+        var j = index - 1
+        while (j >= 0 && o.startMs - sorted[j].startMs <= NEIGHBOUR_MS) {
+            if (counts(o, sorted[j])) return true
+            j--
+        }
+        j = index + 1
+        while (j < sorted.size && sorted[j].startMs - o.startMs <= NEIGHBOUR_MS) {
+            if (counts(o, sorted[j])) return true
+            j++
+        }
+        return false
+    }
+}
