@@ -0,0 +1,97 @@
+package com.nuvio.app.features.clipfinder
+
+object ClipText {
+    private val apostrophes = setOf('\'', '’', '‘', 'ʼ')
+    private val bracketPairs = mapOf('[' to ']', '(' to ')', '{' to '}', '（' to '）', '［' to '］', '【' to '】')
+    /** Characters that may start a subtitle line without being words: dashes and music notes. */
+    private val lineMarks = setOf('-', '‐', '–', '—', '•', '♪', '♫')
+    private const val MAX_LABEL_LENGTH = 24
+    private const val MAX_LABEL_WORDS = 3
+
+    /**
+     * Lowercase words made of letters or digits of any script. Apostrophes are dropped without
+     * splitting ("don't" -> "dont"), combining marks (such as Arabic vowel signs) are dropped,
+     * everything else separates words. Subtitle noise is removed first: bracketed text
+     * ("[music]", "(LAUGHS)"), leading dashes and music notes, and a leading UPPERCASE speaker
+     * label ("JOHN:"; scripts without capitals are left alone). Digit groups separated only by
+     * spaces are joined ("2 00 8" -> "2008"). [fillers] is an optional list of words to remove;
+     * it is empty by default so no language is favoured. A text with no words gives an empty list.
+     */
+    fun normalize(text: String, fillers: Set<String> = emptySet()): List<String> {
+        val words = mutableListOf<String>()
+        for (line in dropBrackets(text).lines()) {
+            for (word in lineWords(withoutLabel(line))) if (word !in fillers) words += word
+        }
+        return words
+    }
+
+    private fun lineWords(line: String): List<String> {
+        val words = mutableListOf<String>()
+        val current = StringBuilder()
+        var onlySpaceSince = false // only whitespace between the previous word and this one
+        var lastWasDigits = false
+        fun flush() {
+            if (current.isEmpty()) return
+            val word = current.toString()
+            val digits = word.all { it.isDigit() }
+            if (digits && lastWasDigits && onlySpaceSince) words[words.size - 1] = words.last() + word else words += word
+            lastWasDigits = digits
+            onlySpaceSince = true
+            current.clear()
+        }
+        for (ch in line.lowercase()) {
+            when {
+                ch.isLetterOrDigit() -> current.append(ch)
+                ch in apostrophes -> Unit
+                ch.category == CharCategory.NON_SPACING_MARK || ch.category == CharCategory.COMBINING_SPACING_MARK -> Unit
+                else -> {
+                    flush()
+                    if (!ch.isWhitespace()) onlySpaceSince = false
+                }
+            }
+        }
+        flush()
+        return words
+    }
+
+    /** Removes [..], (..) and {..} (also full-width forms). An opener with no closer is kept as a separator. */
+    private fun dropBrackets(text: String): String {
+        val out = StringBuilder()
+        var i = 0
+        while (i < text.length) {
+            val close = bracketPairs[text[i]]
+            val end = if (close == null) -1 else text.indexOf(close, i + 1)
+            if (end >= 0) {
+                out.append(' ')
+                i = end + 1
+            } else {
+                out.append(text[i])
+                i++
+            }
+        }
+        return out.toString()
+    }
+
+    /**
+     * Drops leading dashes/notes and a leading "SPEAKER:" label (1-3 words of capitals, digits,
+     * . - ' _ only, and whitespace after the colon, so "AT 10:30 WE LEAVE" keeps its words).
+     */
+    private fun withoutLabel(line: String): String {
+        val body = line.trimStart { it.isWhitespace() || it in lineMarks }
+        val colon = body.indexOf(':')
+        if (colon < 1 || colon > MAX_LABEL_LENGTH) return body
+        val label = body.substring(0, colon)
+        val shaped = label.all { it.isUpperCase() || it.isDigit() || it.isWhitespace() || it in ".-'_" }
+        val labelWords = label.split(' ', '\t').count { it.isNotEmpty() }
+        val spaceAfter = colon + 1 >= body.length || body[colon + 1].isWhitespace()
+        return if (shaped && label.any { it.isUpperCase() } && labelWords <= MAX_LABEL_WORDS && spaceAfter) {
+            body.substring(colon + 1)
+        } else {
+            body
+        }
+    }
+
+    /** Every run of three neighbouring words, joined by a space. */
+    fun triples(words: List<String>): List<String> =
+        if (words.size < 3) emptyList() else List(words.size - 2) { "${words[it]} ${words[it + 1]} ${words[it + 2]}" }
+}
