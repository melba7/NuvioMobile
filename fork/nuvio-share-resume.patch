+package com.nuvio.app.features.clipfinder
+
+object ClipMatcher {
+    const val MIN_HITS = 4
+    /** A hit needs another, different hit within this distance in the episode to count. */
+    private const val NEIGHBOUR_MS = 45_000L
+    /** Triples that occur more often than this in one episode are stock phrases: ignored. */
+    private const val MAX_OCCURRENCES = 3
+
+    private class Occurrence(val key: String, val startMs: Long, val endMs: Long)
+
+    /**
+     * Scores each episode by its number of distinct word triples shared with the clip. Clips
+     * are often compilations with jumps, so no fixed time window is used: a hit counts when
+     * another hit lies within 45 s, which drops stray matches. The moment is the earliest
+     * counted cue (start) to the latest (end). Best-first; only the best can be [confident],
+     * which needs at least 4 hits and at least twice the runner-up's hits.
+     */
+    fun match(
+        lines: List<ClipLine>,
+        episodes: List<EpisodeCues>,
+        maxResults: Int = 3,
+        fillers: Set<String> = emptySet(),
+    ): List<ClipCandidate> {
+        val clipTriples = ClipText.triples(lines.flatMap { ClipText.normalize(it.text, fillers) }).toSet()
+        if (clipTriples.isEmpty()) return emptyList()
+
+        val scored = episodes.mapNotNull { score(it, clipTriples, fillers) }
+            .sortedByDescending { it.hits }
+            .take(maxResults)
+        val runnerUp = scored.getOrNull(1)?.hits ?: 0
+        return scored.mapIndexed { index, c ->
+            val clear = index == 0 && c.hits >= MIN_HITS && c.hits >= 2 * runnerUp
+            val raw = if (index == 0) (c.hits - runnerUp).toDouble() / c.hits * minOf(1.0, c.hits / 12.0) else 0.0
+            c.copy(confident = clear, confidence = if (c.hits < MIN_HITS) minOf(raw, 0.3) else raw)
+        }
+    }
+
+    private fun score(ep: EpisodeCues, clipTriples: Set<String>, fillers: Set<String>): ClipCandidate? {
+        class W(val word: String, val start: Long, val end: Long)
+        val words = ep.cues.sortedBy { it.startTimeMs }.flatMap { cue ->
+            ClipText.normalize(cue.text, fillers).map { W(it, cue.startTimeMs, cue.endTimeMs) }
+        }
+        val found = mutableListOf<Occurrence>()
+        for (i in 0..words.size - 3) {
+            val key = "${words[i].word} ${words[i + 1].word} ${words[i + 2].word}"
+            if (key in clipTriples) found += Occurrence(key, words[i].start, words[i + 2].end)
+        }
+        val usable = found.groupBy { it.key }.filterValues { it.size <= MAX_OCCURRENCES }.values.flatten()
+            .sortedBy { it.startMs }
+        val kept = usable.filterIndexed { i, o -> hasNeighbour(usable, i, o) }
+        if (kept.isEmpty()) return null
+        return ClipCandidate(
+            videoId = ep.videoId,
+            season = ep.season,
+            episode = ep.episode,
+            startMs = kept.minOf { it.startMs },
+            endMs = kept.maxOf { it.endMs },
+            confidence = 0.0,
+            hits = kept.map { it.key }.toSet().size,
+            confident = false,
+        )
+    }
+
+    private fun hasNeighbour(sorted: List<Occurrence>, index: Int, o: Occurrence): Boolean {
+        var j = index - 1
+        while (j >= 0 && o.startMs - sorted[j].startMs <= NEIGHBOUR_MS) {
+            if (sorted[j].key != o.key) return true
+            j--
+        }
+        j = index + 1
+        while (j < sorted.size && sorted[j].startMs - o.startMs <= NEIGHBOUR_MS) {
+            if (sorted[j].key != o.key) return true
+            j++
+        }
+        return false
+    }
+}
