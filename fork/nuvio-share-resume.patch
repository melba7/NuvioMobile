+
+    @Test
+    fun `a YouTube answer is named and described like an episode`() {
+        val candidate = ClipCandidate("FULLvideo01", null, null, 125_000, 190_000, 0.88, 40, true)
+        assertEquals("at 2:05 to 3:10, 88% sure", clipMatchDetail(candidate))
