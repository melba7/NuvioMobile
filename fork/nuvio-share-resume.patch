+        assertNull(parseAppDeepLink("nuvio://clip?url=https%3A%2F%2F"))
+    }
+
+    @Test
+    fun `rejects clip links longer than 2048 characters`() {
+        val prefix = "https://www.tiktok.com/"
+        val ok = prefix + "a".repeat(2048 - prefix.length)
+        assertEquals(AppDeepLink.Clip(ok), parseAppDeepLink("nuvio://clip?url=${ok.encodeURLParameter()}"))
+        val tooLong = ok + "a"
