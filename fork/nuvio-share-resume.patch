+package com.nuvio.app.features.clipfinder
+
+import com.nuvio.app.features.player.SubtitleSyncCue
+import kotlin.random.Random
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertTrue
+
+/** All text here is generated nonsense words; no real dialogue. */
+class ClipMatcherTest {
+
+    private val syllables = listOf("ba", "ko", "ri", "tu", "ne", "sa", "mo", "li", "da", "pe", "vu", "zi")
+    private val vocabulary: List<String> = run {
+        val r = Random(7)
+        List(500) { "${syllables.random(r)}${syllables.random(r)}${syllables.random(r)}" }.distinct()
+    }
+
+    /** One cue every 4 s, 6 made-up words each. */
+    private fun episode(videoId: String, seed: Int, cueCount: Int = 400, season: Int? = 1, episode: Int? = 1): EpisodeCues {
+        val r = Random(seed)
+        val cues = List(cueCount) { i ->
+            SubtitleSyncCue(i * 4_000L, i * 4_000L + 3_000L, List(6) { vocabulary.random(r) }.joinToString(" "))
+        }
+        return EpisodeCues(videoId, season, episode, cues)
+    }
+
+    private fun linesFrom(ep: EpisodeCues, range: IntRange): List<ClipLine> {
+        val base = ep.cues[range.first].startTimeMs
+        return range.map { ClipLine(ep.cues[it].text, ep.cues[it].startTimeMs - base, ep.cues[it].endTimeMs - base) }
+    }
+
+    private fun assertNear(expected: Long, actual: Long, toleranceMs: Long = 5_000L) =
+        assertTrue(kotlin.math.abs(expected - actual) <= toleranceMs, "expected about $expected but was $actual")
+
+    private val ep1 = episode("tt1:1:1", seed = 1, episode = 1)
+    private val ep2 = episode("tt1:1:2", seed = 2, episode = 2)
+    private val ep3 = episode("tt1:1:3", seed = 3, episode = 3)
+
+    @Test
+    fun `exact lines find the right episode and moment`() {
+        val result = ClipMatcher.match(linesFrom(ep2, 100..120), listOf(ep1, ep2, ep3))
+        val best = result.first()
+        assertEquals("tt1:1:2", best.videoId)
+        assertEquals(2, best.episode)
+        assertTrue(best.confident)
+        assertTrue(best.confidence > 0.5)
+        assertNear(ep2.cues[100].startTimeMs, best.startMs)
+        assertNear(ep2.cues[120].endTimeMs, best.endMs)
+    }
+
+    @Test
+    fun `thirty percent wrong words still match`() {
+        val r = Random(11)
+        val noisy = linesFrom(ep3, 50..90).map { line ->
+            line.copy(text = line.text.split(" ").joinToString(" ") { if (r.nextInt(100) < 30) "zq${r.nextInt(1000)}" else it })
+        }
+        val best = ClipMatcher.match(noisy, listOf(ep1, ep2, ep3)).first()
+        assertEquals("tt1:1:3", best.videoId)
+        assertTrue(best.confident)
+        assertNear(ep3.cues[50].startTimeMs, best.startMs, 12_000L)
+    }
+
+    @Test
+    fun `half the lines missing still match`() {
+        val lines = linesFrom(ep1, 200..260).filterIndexed { i, _ -> i % 2 == 0 }
+        val best = ClipMatcher.match(lines, listOf(ep1, ep2, ep3)).first()
+        assertEquals("tt1:1:1", best.videoId)
+        assertTrue(best.confident)
+        assertNear(ep1.cues[200].startTimeMs, best.startMs)
+    }
+
+    @Test
+    fun `lines out of order still match`() {
+        val lines = linesFrom(ep2, 10..40)
+        val shuffled = lines.drop(15) + lines.take(15).reversed()
+        val best = ClipMatcher.match(shuffled, listOf(ep1, ep2, ep3)).first()
+        assertEquals("tt1:1:2", best.videoId)
+        assertTrue(best.confident)
+        assertNear(ep2.cues[10].startTimeMs, best.startMs)
+    }
+
+    @Test
+    fun `similar episode sharing a few phrases loses`() {
+        val shared = listOf(145, 150, 155)
+        val lookalike = ep1.copy(
+            videoId = "tt1:1:9",
+            episode = 9,
+            cues = ep3.cues.mapIndexed { i, cue -> if (i in shared) cue.copy(text = ep1.cues[i].text) else cue },
+        )
+        val result = ClipMatcher.match(linesFrom(ep1, 140..160), listOf(lookalike, ep1))
+        val best = result.first()
+        assertEquals("tt1:1:1", best.videoId)
+        assertTrue(best.confident)
+        assertNear(ep1.cues[140].startTimeMs, best.startMs)
+        assertTrue(result.size < 2 || result[1].hits < best.hits)
+    }
+
+    @Test
+    fun `wrong show is not confident`() {
+        val other = listOf(episode("tt2:1:1", 21), episode("tt2:1:2", 22))
+        val result = ClipMatcher.match(linesFrom(ep1, 100..130), other)
+        assertTrue(result.none { it.confident })
+    }
+
+    @Test
+    fun `movie with one long cue list`() {
+        val movie = episode("tt9", seed = 5, cueCount = 1_800, season = null, episode = null)
+        val result = ClipMatcher.match(linesFrom(movie, 900..930), listOf(movie))
+        val best = result.single()
+        assertEquals(null, best.season)
+        assertTrue(best.confident)
+        assertNear(movie.cues[900].startTimeMs, best.startMs)
+    }
+
+    @Test
+    fun `empty transcript gives no candidates`() {
+        assertEquals(emptyList(), ClipMatcher.match(emptyList(), listOf(ep1)))
+        assertEquals(emptyList(), ClipMatcher.match(listOf(ClipLine("...", 0, 1_000)), listOf(ep1)))
+    }
+
+    @Test
+    fun `compilation of three jumps reports the first segment as the start`() {
+        val segments = listOf(20..30, 120..130, 300..310)
+        val lines = segments.flatMap { linesFrom(ep1, it) }
+        val best = ClipMatcher.match(lines, listOf(ep1, ep2, ep3)).first()
+        assertEquals("tt1:1:1", best.videoId)
+        assertTrue(best.confident)
+        assertNear(ep1.cues[20].startTimeMs, best.startMs)
+        assertNear(ep1.cues[310].endTimeMs, best.endMs)
+    }
+
+    @Test
+    fun `fewer than four hits is never confident`() {
+        val short = ClipLine(ep1.cues[5].text.split(" ").take(5).joinToString(" "), 0, 2_000)
+        val result = ClipMatcher.match(listOf(short), listOf(ep1))
+        assertEquals(3, result.single().hits)
+        assertTrue(result.none { it.confident })
+    }
+
+    @Test
+    fun `arabic letters survive normalising and marks are dropped`() {
+        val words = ClipText.normalize("بَيْتٌ كبير، والعمل!")
+        assertEquals(listOf("بيت", "كبير", "والعمل"), words)
+    }
+
+    @Test
+    fun `arabic clip matches arabic cues`() {
+        val letters = "بتثجحخدذرزسشص"
+        val r = Random(3)
+        val cues = List(60) { i ->
+            SubtitleSyncCue(i * 4_000L, i * 4_000L + 3_000L, List(6) { CharArray(4) { letters.random(r) }.concatToString() }.joinToString(" "))
+        }
+        val ep = EpisodeCues("ar1", null, null, cues)
+        val best = ClipMatcher.match(linesFrom(ep, 10..25), listOf(ep)).single()
+        assertTrue(best.confident)
+        assertNear(cues[10].startTimeMs, best.startMs)
+    }
+
+    @Test
+    fun `normalise handles case punctuation and apostrophes`() {
+        assertEquals(listOf("hello", "world", "dont", "stop", "2", "00"), ClipText.normalize("Hello, WORLD! Don't -- stop... 2 00"))
+        assertEquals(listOf("hello", "world"), ClipText.normalize("Hello the world", fillers = setOf("the")))
+        assertEquals(listOf("the", "end"), ClipText.normalize("The End"))
+    }
+
+    @Test
+    fun `word triples slide over the words`() {
+        assertEquals(listOf("a b c", "b c d"), ClipText.triples(listOf("a", "b", "c", "d")))
+        assertEquals(emptyList(), ClipText.triples(listOf("a", "b")))
+    }
+}
