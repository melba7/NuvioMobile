+package com.nuvio.app.features.clipfinder
+
+object ClipText {
+    private val apostrophes = setOf('\'', '’', '‘', 'ʼ')
+
+    /**
+     * Lowercase words made of letters or digits of any script. Apostrophes are dropped without
+     * splitting ("don't" -> "dont"), combining marks (such as Arabic vowel signs) are dropped,
+     * everything else separates words. [fillers] is an optional list of words to remove; it is
+     * empty by default so no language is favoured.
+     */
+    fun normalize(text: String, fillers: Set<String> = emptySet()): List<String> {
+        val words = mutableListOf<String>()
+        val current = StringBuilder()
+        fun flush() {
+            if (current.isNotEmpty()) {
+                val word = current.toString()
+                if (word !in fillers) words += word
+                current.clear()
+            }
+        }
+        for (ch in text.lowercase()) {
+            when {
+                ch.isLetterOrDigit() -> current.append(ch)
+                ch in apostrophes -> Unit
+                ch.category == CharCategory.NON_SPACING_MARK || ch.category == CharCategory.COMBINING_SPACING_MARK -> Unit
+                else -> flush()
+            }
+        }
+        flush()
+        return words
+    }
+
+    /** Every run of three neighbouring words, joined by a space. */
+    fun triples(words: List<String>): List<String> =
+        if (words.size < 3) emptyList() else List(words.size - 2) { "${words[it]} ${words[it + 1]} ${words[it + 2]}" }
+}
