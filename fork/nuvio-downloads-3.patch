@@ -0,0 +1,19 @@
+package com.nuvio.app.features.downloads.core
+
+/**
+ * Debrid add-ons (Debridio, Torrentio, Comet, ...) list files the debrid service has not cached yet too. Their link
+ * does not point at the movie: it points at a short "Downloading to Provider, please wait" placeholder video, so
+ * saving it would store that placeholder. This file (like everything in `core/`) may only import `kotlin.*`.
+ */
+object UncachedStreamRules {
+    // "[RD download]", "[AD download]", "[PM+ download]", "[TB ⬇]" ...
+    private val providerDownloadTag = Regex("\\[\\s*[a-z]{2,4}\\+?\\s*(?:download|⬇️?)\\s*\\]", RegexOption.IGNORE_CASE)
+    private val words = Regex("\\b(?:un-?cached|not[ -]cached|non-cached|downloading to provider)\\b", RegexOption.IGNORE_CASE)
+    private const val HOURGLASS = "⏳"
+
+    /** True when any of the stream's texts says the file is not cached at the debrid provider. */
+    fun looksUncached(texts: List<String?>): Boolean = texts.any { text ->
+        !text.isNullOrEmpty() &&
+            (providerDownloadTag.containsMatchIn(text) || words.containsMatchIn(text) || text.contains(HOURGLASS))
+    }
+}
