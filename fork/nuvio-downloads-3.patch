+package com.nuvio.app.features.downloads.core
+
+import kotlin.test.Test
+import kotlin.test.assertFalse
+import kotlin.test.assertTrue
+
+class UncachedStreamRulesTest {
+    @Test
+    fun flagsUncachedLabels() {
+        assertTrue(UncachedStreamRules.looksUncached(listOf("Torrentio\n[RD download]", null)))
+        assertTrue(UncachedStreamRules.looksUncached(listOf(null, "⏳ 1080p")))
+        assertTrue(UncachedStreamRules.looksUncached(listOf("Debridio", "Not cached")))
+    }
+
+    @Test
+    fun keepsCachedStreams() {
+        assertFalse(UncachedStreamRules.looksUncached(listOf("Torrentio\n[RD+] 1080p", "The.Movie.2024.1080p.mkv")))
+        assertFalse(UncachedStreamRules.looksUncached(listOf(null, "")))
+    }
+}
