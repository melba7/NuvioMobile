@@ -0,0 +1,11 @@
+package com.nuvio.app.features.streams
+
+import com.nuvio.app.features.downloads.core.UncachedStreamRules
+
+/**
+ * True for a debrid stream that is not cached yet: its link only plays a "Downloading to Provider" placeholder, so it
+ * must not be offered for download. Uses the debrid cache check when there is one, else the add-on's own labels.
+ */
+internal fun StreamItem.isUncachedPlaceholder(): Boolean =
+    debridCacheStatus?.state == StreamDebridCacheState.NOT_CACHED ||
+        UncachedStreamRules.looksUncached(listOf(name, title, description))
